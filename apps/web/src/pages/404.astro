    pathTemplate: "Szedłeś do {path} — ale ona też postanowiła odpocząć.",
    posLabel: "rzecz.",
    definition: "Subtelna plovdiwska sztuka nigdzie się nie spieszyć i nic nie robić.",
    backHome: "Na stronę główną",
    placesLink: "Przejdź się po miejscach",
    historyLink: "Do historii",
