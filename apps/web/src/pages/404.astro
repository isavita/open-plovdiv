    historyLink: "В історію",
    bubbles: ["Ще п'ять хвилин… 😎", "Тсс. Айляк.", "Приходь завтра.", "Може, пізніше.", "Розслабся, друже."]
  },
  ru: {
    eyebrow: "Ошибка 404",
    title: "Эта страница отдыхает на айляк.",
    sub: "Эта страница никуда не спешит — затерялась где-то среди семи холмов.",
    pathTemplate: "Вы направлялись к {path} — но и она решила отдохнуть.",
    posLabel: "сущ.",
    definition: "Тонкое пловдивское искусство никуда не спешить и ничего не делать.",
    backHome: "На главную",
