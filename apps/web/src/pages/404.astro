    posLabel: "pangngalan",
    definition: "Ang payapang paraan ng Plovdiv: huminto sandali, walang pagmamadali.",
    backHome: "Bumalik sa simula",
    placesLink: "Galugarin ang mga lugar",
    historyLink: "Sa kasaysayan",
