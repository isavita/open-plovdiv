---
import LinkIcon from "@components/LinkIcon.astro";
import { visitorGuide } from "@lib/visitorGuide";
import { walkingRoutes } from "@lib/routes";
import { field, localizePath } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
const { lang } = Astro.props as { lang: Lang };
const guide = visitorGuide(lang);
const routeTitle = (route: (typeof walkingRoutes)[number]) => field(route as unknown as Record<string, unknown>, "short_title", lang);
// One line-icon family for the practical notes, drawn like the site's link arrows.
const icons: Record<(typeof guide.items)[number]["icon"], string> = {
  euro: "M17.5 6.6A7 7 0 1 0 17.5 17.4M4.5 10.5h9M4.5 13.5h9",
  train: "M7 4h10a2 2 0 0 1 2 2v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V6a2 2 0 0 1 2-2ZM5 11h14M9 14.5h.01M15 14.5h.01M8.5 17 7 20M15.5 17l1.5 3",
  hills: "M2.5 19.5h19M2.5 19.5 9 11l3.5 4.5L16 9.5l5.5 10M16 9.5V4.5l3 1.25-3 1.25",
  ticket: "M4 8a2 2 0 0 0 2-2h12a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H6a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4ZM14 6.5v1.5M14 11v2M14 16v1.5",
  info: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 11v5.5M12 7.5h.01",
  calendar: "M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1ZM4 10h16M8 3.5V7M16 3.5V7M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01"
};
---

<section class="section visitor-practical" id="plan-your-visit" aria-labelledby="visitor-practical-title">
  <div class="container">
    <div class="visitor-section-heading">
      <div>
        <p class="eyebrow">{guide.plan}</p>
        <h2 id="visitor-practical-title">{guide.practical}</h2>
      </div>
      <p>{guide.official}</p>
    </div>
    <div class="visitor-practical-grid">
      {guide.items.map((item) => {
        const route = item.route ? walkingRoutes.find((route) => route.id === item.route) : undefined;
        return (
          <article class="visitor-tip">
            <span class="visitor-tip-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d={icons[item.icon]} /></svg></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.href && <a href={item.href} target="_blank" rel="noreferrer">{item.link} <span aria-hidden="true"><LinkIcon direction="up-right" /></span></a>}
              {route && <a href={localizePath(`/routes/${route.id}`, lang)}>{routeTitle(route)} <span aria-hidden="true"><LinkIcon direction="right" /></span></a>}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
