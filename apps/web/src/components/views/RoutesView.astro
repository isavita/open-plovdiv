---
import Layout from "@layouts/Layout.astro";
import { field, localeForLang, localizePath, type Lang } from "@i18n/utils";
import { commonsImageUrl, isCommonsUploadImageUrl } from "@lib/commons";
import { sectionMotifs } from "@lib/motifs";
import { historyKnowledgePlaces } from "@lib/data";
import {
  formatKm,
  routeCategoryOrder,
  routeGeometry,
  walkingRoutes,
  type RouteCategory,
  type RouteDurationBand
} from "@lib/routes";
import {
  routeCategoryLabels,
  routeDifficultyLabels,
  routeDurationBandLabels,
  routeLabels,
  routeWheelchairLabels
} from "@lib/routeLabels";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const locale = localeForLang(lang);
const t = routeLabels(lang);
const categoryLabels = routeCategoryLabels(lang);
const bandLabels = routeDurationBandLabels(lang);
const difficultyLabels = routeDifficultyLabels(lang);
const wheelchairLabels = routeWheelchairLabels(lang);

const placesById = new Map(historyKnowledgePlaces.map((place) => [place.id, place]));

const localized = (record: Record<string, unknown> | null | undefined, base: string): string =>
  field(record, base, lang);
const localizedAny = (record: unknown, base: string): string =>
  localized(record as Record<string, unknown>, base);

// One display card per route: localized text, computed distance from the
// committed walking geometry, and the first stop photo as card media.
const cards = walkingRoutes.map((route) => {
  const geometry = routeGeometry(route.id);
  const media = route.stops
    .map((stop) => placesById.get(stop.place_id))
    .find((place) => place && place.media.length > 0)?.media[0];
  const startPlace = placesById.get(route.stops[0].place_id);
  const endPlace = placesById.get(route.stops[route.stops.length - 1].place_id);
  return {
    route,
    href: localizePath(`/routes/${route.id}`, lang),
    title: localizedAny(route, "title"),
    tagline: localizedAny(route, "tagline"),
    summary: localizedAny(route, "summary"),
    km: geometry ? formatKm(geometry.distance_m, locale) : null,
    ascent: geometry?.elevation.ascent_m ?? null,
    media,
    startName: startPlace ? localizedAny(startPlace, "name") : "",
    endName: endPlace ? localizedAny(endPlace, "name") : "",
    stopNames: route.stops.map((stop) => {
      const place = placesById.get(stop.place_id);
      return place ? localizedAny(place, "name") : stop.place_id;
    })
  };
});

const totalStops = walkingRoutes.reduce((sum, route) => sum + route.stops.length, 0);
const totalMeters = walkingRoutes.reduce(
  (sum, route) => sum + (routeGeometry(route.id)?.distance_m ?? 0),
  0
);
const totalKm = Math.round(totalMeters / 1000);
const totalSources = new Set(
  walkingRoutes.flatMap((route) =>
    route.stops.flatMap((stop) => placesById.get(stop.place_id)?.source_ids ?? [])
  )
).size;

const categoryCounts = new Map<RouteCategory, number>();
for (const route of walkingRoutes) {
  categoryCounts.set(route.category, (categoryCounts.get(route.category) ?? 0) + 1);
}
const bandOrder: RouteDurationBand[] = ["short", "half-day", "full-day"];

const filterConfig = {
  noMatchesId: "routes-no-matches"
};
---

<Layout lang={lang} path="/routes" title={t.indexTitle} description={t.indexLead}>
  <section class="section hero hero-compact routes-hero" data-section="routes">
    <div class="container hero-grid">
      <div>
        <div class="section-plate compact" aria-hidden="true" set:html={sectionMotifs.routes} />
        <p class="eyebrow">{t.indexEyebrow}</p>
        <h1>{t.indexTitle}</h1>
        <p class="lead">{t.indexLead}</p>
      </div>
      <dl class="stats-grid routes-stats" aria-label={t.indexTitle}>
        <div class="stat-card">
          <dt>{t.routes}</dt>
          <dd>{walkingRoutes.length}</dd>
        </div>
        <div class="stat-card">
          <dt>{t.stops}</dt>
          <dd>{totalStops}</dd>
        </div>
        <div class="stat-card">
          <dt>{t.totalKm}</dt>
          <dd>{totalKm}</dd>
        </div>
        <div class="stat-card">
          <dt>{t.sources}</dt>
          <dd>{totalSources}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section routes-picker" id="routes">
    <div class="container">
      <div class="section-head routes-section-head">
        <div>
          <h2>{t.filterTitle}</h2>
          <p class="meta">{t.filterLead}</p>
        </div>
        <a href={localizePath("/places", lang)}>{t.allPlaces} →</a>
      </div>

      <form class="route-filters" id="route-filters" aria-label={t.filterTitle}>
        <fieldset class="route-filter-group" data-filter-group="category">
          <legend>{t.filterTheme}</legend>
          <div class="route-filter-chips">
            <button type="button" class="route-chip" data-filter-value="" aria-pressed="true">
              {t.filterAll} <span class="route-chip-count">{walkingRoutes.length}</span>
            </button>
            {routeCategoryOrder.map((category) => (
              <button type="button" class="route-chip" data-filter-value={category} aria-pressed="false">
                {categoryLabels[category]}
                <span class="route-chip-count">{categoryCounts.get(category) ?? 0}</span>
              </button>
            ))}
          </div>
        </fieldset>
        <fieldset class="route-filter-group" data-filter-group="band">
          <legend>{t.filterLength}</legend>
          <div class="route-filter-chips">
            <button type="button" class="route-chip" data-filter-value="" aria-pressed="true">{t.filterAll}</button>
            {bandOrder.map((band) => (
              <button type="button" class="route-chip" data-filter-value={band} aria-pressed="false">
                {bandLabels[band]}
              </button>
            ))}
          </div>
        </fieldset>
        <fieldset class="route-filter-group" data-filter-group="flags">
          <legend>{t.filterMore}</legend>
          <div class="route-filter-chips">
            <button type="button" class="route-chip" data-filter-flag="stepfree" aria-pressed="false">
              {t.toggleStepFree}
            </button>
            <button type="button" class="route-chip" data-filter-flag="family" aria-pressed="false">
              {t.toggleFamily}
            </button>
            <button type="button" class="route-chip" data-filter-flag="rainy" aria-pressed="false">
              {t.toggleRainy}
            </button>
            <button type="button" class="route-chip" data-filter-flag="transit" aria-pressed="false">
              {t.toggleTransit}
            </button>
          </div>
        </fieldset>
      </form>

      <p class="notice routes-no-matches" id={filterConfig.noMatchesId} hidden>
        <span class="notice-icon" aria-hidden="true">i</span>
        <span>
          {t.noMatches}{" "}
          <button type="button" class="route-reset-inline" data-route-filter-reset>{t.resetFilters}</button>
        </span>
      </p>

      <div class="route-card-grid" id="route-card-grid">
        {cards.map(({ route, href, title, tagline, summary, km, media, stopNames }) => (
          <article
            class="route-card"
            id={`route-${route.id}`}
            style={`--route-accent:${route.accent}`}
            data-route-card
            data-category={route.category}
            data-band={route.duration_band}
            data-stepfree={route.wheelchair === "good" ? "true" : "false"}
            data-family={route.family_friendly ? "true" : "false"}
            data-rainy={route.rainy_day_ok ? "true" : "false"}
            data-transit={route.transit_required ? "true" : "false"}
          >
            {media && (
              <a class="route-card-media" href={href} aria-label={title} tabindex="-1">
                <img
                  src={commonsImageUrl(media.url, 640)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  crossorigin={isCommonsUploadImageUrl(media.url) ? "anonymous" : undefined}
                  referrerpolicy="no-referrer"
                />
              </a>
            )}
            <div class="route-card-body">
              <p class="route-card-kicker">
                <span class="route-card-cat">{categoryLabels[route.category]}</span>
                <span class="route-card-band">{bandLabels[route.duration_band]}</span>
              </p>
              <h3><a href={href}>{title}</a></h3>
              <p class="route-card-tagline">{tagline}</p>
              <p class="route-card-summary">{summary}</p>
              <dl class="route-quick-facts">
                {km && (
                  <div>
                    <dt>{t.distance}</dt>
                    <dd>{km} {t.km}</dd>
                  </div>
                )}
                <div>
                  <dt>{t.suggestedTime}</dt>
                  <dd>~{route.duration_minutes} {t.minutes}</dd>
                </div>
                <div>
                  <dt>{t.stops}</dt>
                  <dd>{route.stops.length}</dd>
                </div>
                <div>
                  <dt>{t.difficulty}</dt>
                  <dd>{difficultyLabels[route.difficulty]}</dd>
                </div>
              </dl>
              <p class="tag-row route-card-badges">
                {route.wheelchair === "good" && <span class="route-badge">{t.toggleStepFree}</span>}
                {route.family_friendly && <span class="route-badge">{t.toggleFamily}</span>}
                {route.rainy_day_ok && <span class="route-badge">{t.toggleRainy}</span>}
                {route.transit_required && <span class="route-badge">{t.toggleTransit}</span>}
                {route.wheelchair !== "good" && (
                  <span class="route-badge route-badge-muted">{wheelchairLabels[route.wheelchair]}</span>
                )}
              </p>
              <p class="route-card-itinerary meta">
                {stopNames.slice(0, 3).join(" → ")}
                {stopNames.length > 3 ? ` → +${stopNames.length - 3}` : ""}
              </p>
              <div class="route-card-actions">
                <a class="button" href={href}>{t.openRoute}</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="notice route-boundary">
        <span class="notice-icon" aria-hidden="true">i</span>
        <span>{t.dataBoundary}</span>
      </p>
    </div>
  </section>

  <script>
    // Client-side filtering over the server-rendered cards. Single-select for
    // theme and length, AND-combined toggles for the "good for" flags. State
    // round-trips through the query string so filtered views are shareable;
    // without JS every card simply stays visible.
    const grid = document.getElementById("route-card-grid");
    const form = document.getElementById("route-filters");
    const noMatches = document.getElementById("routes-no-matches");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-route-card]")];

    type FilterState = { category: string; band: string; flags: Set<string> };
    const state: FilterState = { category: "", band: "", flags: new Set() };
    const flagToDataKey: Record<string, string> = {
      stepfree: "stepfree",
      family: "family",
      rainy: "rainy",
      transit: "transit"
    };

    function applyState(): void {
      let visible = 0;
      for (const card of cards) {
        const matchesCategory = !state.category || card.dataset.category === state.category;
        const matchesBand = !state.band || card.dataset.band === state.band;
        let matchesFlags = true;
        for (const flag of state.flags) {
          if (card.dataset[flagToDataKey[flag]] !== "true") matchesFlags = false;
        }
        const show = matchesCategory && matchesBand && matchesFlags;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (noMatches) noMatches.hidden = visible > 0;
      syncButtons();
      syncUrl();
    }

    function syncButtons(): void {
      form?.querySelectorAll<HTMLButtonElement>("[data-filter-value]").forEach((button) => {
        const group = button.closest<HTMLElement>("[data-filter-group]")?.dataset.filterGroup;
        const current = group === "category" ? state.category : state.band;
        button.setAttribute("aria-pressed", String((button.dataset.filterValue ?? "") === current));
      });
      form?.querySelectorAll<HTMLButtonElement>("[data-filter-flag]").forEach((button) => {
        button.setAttribute("aria-pressed", String(state.flags.has(button.dataset.filterFlag ?? "")));
      });
    }

    function syncUrl(): void {
      const params = new URLSearchParams();
      if (state.category) params.set("theme", state.category);
      if (state.band) params.set("length", state.band);
      if (state.flags.size) params.set("good", [...state.flags].join(","));
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : window.location.pathname);
    }

    form?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (!button) return;
      if (button.dataset.filterValue !== undefined) {
        const group = button.closest<HTMLElement>("[data-filter-group]")?.dataset.filterGroup;
        const value = button.dataset.filterValue ?? "";
        if (group === "category") state.category = value;
        if (group === "band") state.band = value;
      } else if (button.dataset.filterFlag) {
        const flag = button.dataset.filterFlag;
        if (state.flags.has(flag)) state.flags.delete(flag);
        else state.flags.add(flag);
      }
      applyState();
    });

    document.querySelectorAll("[data-route-filter-reset]").forEach((button) => {
      button.addEventListener("click", () => {
        state.category = "";
        state.band = "";
        state.flags.clear();
        applyState();
      });
    });

    // Restore shared filter state from the query string.
    if (grid && form) {
      const params = new URLSearchParams(window.location.search);
      state.category = params.get("theme") ?? "";
      state.band = params.get("length") ?? "";
      for (const flag of (params.get("good") ?? "").split(",")) {
        if (flag in flagToDataKey) state.flags.add(flag);
      }
      if (state.category || state.band || state.flags.size) applyState();
      else syncButtons();
    }
  </script>

  <style>
    .stats-grid.routes-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 880px;
      width: 100%;
    }

    .routes-stats .stat-card {
      box-sizing: border-box;
      min-width: 0;
    }

    .routes-section-head .meta {
      max-width: 74ch;
      margin-top: 8px;
    }

    .route-filters {
      display: grid;
      gap: 14px;
      margin: 18px 0 22px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      padding: 16px 18px;
    }

    .route-filter-group {
      border: 0;
      margin: 0;
      padding: 0;
      min-width: 0;
    }

    .route-filter-group legend {
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 8px;
      padding: 0;
    }

    .route-filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .route-chip {
      appearance: none;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--surface);
      color: var(--ink);
      cursor: pointer;
      font: inherit;
      font-size: 0.88rem;
      line-height: 1;
      padding: 8px 13px;
      transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
    }

    .route-chip:hover,
    .route-chip:focus-visible {
      border-color: var(--brand);
      color: var(--brand);
      outline: none;
    }

    .route-chip[aria-pressed="true"] {
      background: var(--brand);
      border-color: var(--brand);
      color: var(--brand-ink);
    }

    .route-chip-count {
      opacity: 0.72;
      font-size: 0.8rem;
      margin-left: 4px;
    }

    .routes-no-matches {
      margin-bottom: 18px;
    }

    .route-reset-inline {
      appearance: none;
      border: 0;
      background: none;
      color: var(--brand);
      cursor: pointer;
      font: inherit;
      padding: 0;
      text-decoration: underline;
    }

    .route-card-grid {
      display: grid;
      /* min(100%, …) keeps single-column cards inside containers narrower
         than the ideal card width (320px phones minus gutters). */
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
      gap: 18px;
    }

    .route-card {
      border: 1px solid var(--line);
      border-radius: 8px;
      border-top: 4px solid var(--route-accent);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .route-card-media {
      display: block;
      background: var(--surface-2);
    }

    .route-card-media img {
      display: block;
      width: 100%;
      height: 172px;
      object-fit: cover;
    }

    .route-card-body {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .route-card-kicker {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin: 0;
      font-size: 0.78rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .route-card-cat {
      color: var(--route-accent);
    }

    .route-card-band::before {
      content: "·";
      margin-right: 8px;
      color: var(--muted);
    }

    .route-card-band {
      color: var(--muted);
    }

    .route-card h3 {
      margin: 0;
      line-height: 1.2;
      font-size: 1.24rem;
    }

    .route-card h3 a {
      color: inherit;
      text-decoration: none;
    }

    .route-card h3 a:hover,
    .route-card h3 a:focus-visible {
      color: var(--brand);
    }

    .route-card-tagline {
      margin: 0;
      color: var(--muted);
      font-style: italic;
      font-size: 0.94rem;
    }

    .route-card-summary {
      margin: 0;
      color: var(--muted);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .route-quick-facts {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin: 4px 0 0;
    }

    .route-quick-facts div {
      min-width: 0;
    }

    .route-quick-facts dt {
      color: var(--muted);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .route-quick-facts dd {
      margin: 3px 0 0;
      font-weight: 800;
      color: var(--ink);
      font-size: 0.95rem;
    }

    .route-card-badges {
      margin: 0;
      gap: 6px;
    }

    .route-badge {
      border: 1px solid color-mix(in srgb, var(--route-accent) 46%, var(--line));
      border-radius: 999px;
      color: color-mix(in srgb, var(--route-accent) 72%, var(--ink));
      background: color-mix(in srgb, var(--route-accent) 8%, var(--surface));
      font-size: 0.78rem;
      padding: 3px 9px;
    }

    .route-badge-muted {
      border-color: var(--line);
      background: var(--surface-2);
      color: var(--muted);
    }

    .route-card-itinerary {
      margin: 0;
    }

    .route-card-actions {
      margin-top: auto;
      padding-top: 6px;
    }

    .route-boundary {
      margin-top: 22px;
    }

    @media (max-width: 680px) {
      .stats-grid.routes-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .route-filters {
        padding: 14px;
      }

      .route-quick-facts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>
</Layout>
