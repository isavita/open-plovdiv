  "archive-plovdiv-governance-2010-property-management-programme": v.contextImage
};

const statusRank: Record<string, number> = {
  in_progress: 0,
  contracted: 1,
  funded: 2,
  planned: 3,
  postponed: 4
};
const activeProjects = [...projects]
  .filter((project) => ["in_progress", "contracted", "funded"].includes(project.status))
  .sort(
    (a, b) =>
      b.budget.year - a.budget.year ||
      (statusRank[a.status] ?? 99) - (statusRank[b.status] ?? 99) ||
      field(a, "title", lang).localeCompare(field(b, "title", lang), locale)
  );
const featuredProjectIds = [
  "plovdiv-pavement-ivan-vazov",
  "plovdiv-education-kiril-metodii",
  "plovdiv-stadium-lokomotiv"
];
const currentProjects = [
  ...featuredProjectIds
    .map((id) => activeProjects.find((project) => project.id === id))
    .filter((project): project is Project => Boolean(project)),
  ...activeProjects.filter((project) => !featuredProjectIds.includes(project.id))
].slice(0, 3);

const projectVisuals: Record<string, GovernanceVisual | null> = {
  "plovdiv-pavement-ivan-vazov": placeVisual("place-ivan-vazov-street-q58177011"),
  "plovdiv-education-kiril-metodii": placeVisual(
    "place-humanitarian-high-school-saints-cyril-and-methodius-plovdiv-q12290859"
  ),
  "plovdiv-stadium-lokomotiv": placeVisual("place-lokomotiv-stadium-q3623331")
};

const projectImageLabels: Record<string, string> = {
  "plovdiv-pavement-ivan-vazov": `${v.referenceImage} · 2011`,
  "plovdiv-education-kiril-metodii": `${v.archivePostcard} · 1900`,
  "plovdiv-stadium-lokomotiv": `${v.referenceImage} · 2013`
};

function termEnd(term: CityArchiveRecord): number {
  return term.year_end ?? currentYear;
}

function overlapsTerm(record: CityArchiveRecord, term: CityArchiveRecord): boolean {
  const recordEnd = record.year_end ?? record.year_start;
  return record.year_start <= termEnd(term) && recordEnd >= term.year_start;
}

function linkedArchiveForTerm(term: CityArchiveRecord): CityArchiveRecord[] {
  return nonMayorArchive.filter((record) => overlapsTerm(record, term)).slice(0, 2);
}

function mayorOverlapLabel(record: CityArchiveRecord): string {
  const recordEnd = record.year_end ?? record.year_start;
  const overlaps = mayorTerms.filter(
    (term) => term.year_start <= recordEnd && termEnd(term) >= record.year_start
  );
  if (!overlaps.length) return "";
  const names = [...new Set(overlaps.map((term) => field(term, "actor", lang)))];
  return `${names.slice(0, 2).join(" · ")}${names.length > 2 ? ` +${names.length - 2}` : ""}`;
}

function amountForProject(project: Project): string | null {
  if (project.budget.amount_eur != null) return formatMoney(project.budget.amount_eur, lang, "EUR");
  if (project.budget.amount_bgn != null) return formatMoney(project.budget.amount_bgn, lang, "BGN");
  return null;
}

function visualCredit(visual: GovernanceVisual): string {
  return [visual.credit, visual.license].filter(Boolean).join(" · ");
}

function sourceLabel(source: { title: string } | null | undefined): string {
  return source ? sourceTitle(source.title, lang) : l.source;
}

const mayorGroups = [
  { title: l.earlyGroup, terms: earlyMayors },
  { title: l.recentGroup, terms: recentMayors }
];
---

<Layout lang={lang} path="/governance" title={l.title} description={l.description}>
  <section class="page-head governance-hero" data-section="governance">
    <div class="container governance-hero-grid">
      <div class="governance-intro">
        <p class="eyebrow">{l.eyebrow}</p>
        <h1>{l.title}</h1>
        <p class="lead">{l.lead}</p>
      </div>
      {currentMayor && (
        <aside class="current-panel" aria-label={l.currentTitle}>
          {currentMayor.image && (
            <img
              src={currentMayor.image}
              alt={field(currentMayor, "actor", lang)}
              width="233"
              height="300"
              loading="eager"
            />
          )}
          <div>
            <p class="eyebrow">{l.currentTitle}</p>
            <h2>{field(currentMayor, "actor", lang)}</h2>
            <p class="meta">{field(currentMayor, "period", lang)}</p>
            <a
              href={localizePath(`/mayors/${currentMayor.id}`, lang)}
              aria-label={`${l.detail}: ${field(currentMayor, "actor", lang)}`}
            >{l.detail} →</a>
          </div>
        </aside>
      )}
    </div>
  </section>

  <div class="governance-subnav">
    <SectionNav items={sectionNav} label={l.sectionNavLabel} />
  </div>

  <section class="section governance-people" id="who-governed" data-subnav-target>
    <div class="container">
      <div class="section-head governance-section-head">
        <div>
          <h2>{l.whoTitle}</h2>
          <p class="meta">{l.whoLead}</p>
        </div>
        <a href={localizePath("/mayors", lang)}>{l.ctaMayors} →</a>
      </div>

      <div class="mayor-board">
        {mayorGroups.map((group) => (
          <section class="mayor-column" aria-label={group.title}>
            <h3>{group.title}</h3>
            <div class="term-list">
              {group.terms.map((term) => {
                const linked = linkedArchiveForTerm(term);
                return (
                  <article class="term-card">
                    <header>
                      <h4>
                        <a href={localizePath(`/mayors/${term.id}`, lang)}>
                          {field(term, "actor", lang)} <span aria-hidden="true">→</span>
                        </a>
                      </h4>
                      <p class="term-period">{field(term, "period", lang)}</p>
                    </header>
                    {linked.length > 0 && (
                      <div class="term-evidence">
                        <p>{l.linkedArchive}</p>
                        <ul>
                          {linked.map((record) => (
                            <li>
                              <a
                                href={record.source_document.url}
                                target="_blank"
                                rel="noreferrer"
                                aria-label={`${field(record, "title", lang)}: ${sourceLabel(record.source_document)}`}
                              >
                                <span>{record.year_start}</span>
                                <strong>{field(record, "title", lang)} <span aria-hidden="true">↗</span></strong>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tint" id="archive-changes" data-subnav-target>
    <div class="container">
      <div class="section-head governance-section-head">
        <div>
          <h2>{l.archiveTitle}</h2>
          <p class="meta">{l.archiveLead}</p>
        </div>
        <a href={localizePath("/archive", lang)}>{l.ctaArchive} →</a>
      </div>

      <div class="turning-grid">
        {archiveHighlights.map((record, index) => {
          const overlap = mayorOverlapLabel(record);
          const visual = turningVisuals[record.id];
          return (
            <article class="turning-card">
              {visual && (
                <figure class="turning-visual">
                  <picture>
                    {isCommonsUploadImageUrl(visual.url) && (
                      <source media="(max-width: 760px)" srcset={commonsImageUrl(visual.url, 500)} />
                    )}
                    <img
                      src={isCommonsUploadImageUrl(visual.url) ? commonsImageUrl(visual.url, 960) : visual.url}
                      srcset={isCommonsUploadImageUrl(visual.url)
                        ? `${commonsImageUrl(visual.url, 500)} 500w, ${commonsImageUrl(visual.url, 960)} 960w`
                        : undefined}
                      sizes="(max-width: 760px) 100vw, 50vw"
                      alt={visual.alt}
                      width={visual.width}
                      height={visual.height}
                      loading="lazy"
                      decoding="async"
                      crossorigin={isCommonsUploadImageUrl(visual.url) ? "anonymous" : undefined}
                      referrerpolicy="no-referrer"
                    />
                  </picture>
                  <span class="turning-sequence" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="visual-context">{turningImageLabels[record.id] ?? v.contextImage}</span>
                  <figcaption>
                    <a href={visual.pageUrl} target="_blank" rel="noreferrer">{visualCredit(visual)} ↗</a>
                  </figcaption>
                </figure>
              )}
              <div class="turning-body">
                <div class="turning-period">
                  <p class="eyebrow">{kindLabels[lang][record.kind]}</p>
                  <p class="turning-years">
                    <strong>{record.year_start}</strong>
                    {record.year_end && record.year_end !== record.year_start && <span>–{record.year_end}</span>}
                  </p>
                </div>
                <h3>{field(record, "title", lang)}</h3>
                <p class="turning-summary">{field(record, "summary", lang)}</p>
                {overlap && (
                  <div class="turning-overlap">
                    <span>{l.mayorOverlap}</span>
                    <strong>{overlap}</strong>
                  </div>
                )}
                <div class="turning-footer">
                  <a
                    class="source-link"
                    href={record.source_document.url}
                    target="_blank"
                    rel="noreferrer"
                    title={sourceLabel(record.source_document)}
                    aria-label={`${l.source}: ${sourceLabel(record.source_document)}`}
                  >
                    {l.source} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section governance-project-section" id="money-projects" data-subnav-target>
    <div class="container">
      <div class="section-head governance-section-head">
        <div>
          <h2>{l.projectsTitle}</h2>
          <p class="meta">{l.projectLead}</p>
          <p class="project-visual-note">{v.projectVisualNote}</p>
        </div>
        <a href={localizePath("/projects", lang)}>{l.ctaProjects} →</a>
      </div>

      <div class="governance-projects">
        {currentProjects.map((project) => {
          const visual = projectVisuals[project.id];
          const amount = amountForProject(project);
          const amountLabel = project.budget.funding_source === "state_subsidy" ? v.listedFunding : l.amountLabel;
          return (
            <article class="project-feature">
              {visual && (
                <figure class="project-visual">
                  <a
                    class="project-image-link"
                    href={localizePath(`/projects/${project.id}`, lang)}
                    aria-label={`${l.projectDetail}: ${field(project, "title", lang)}`}
                  >
                    <picture>
                      {isCommonsUploadImageUrl(visual.url) && (
                        <source media="(max-width: 760px)" srcset={commonsImageUrl(visual.url, 500)} />
                      )}
                      <img
                        src={isCommonsUploadImageUrl(visual.url) ? commonsImageUrl(visual.url, 960) : visual.url}
                        srcset={isCommonsUploadImageUrl(visual.url)
                          ? `${commonsImageUrl(visual.url, 500)} 500w, ${commonsImageUrl(visual.url, 960)} 960w`
                          : undefined}
                        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
                        alt={visual.alt}
                        width={visual.width}
                        height={visual.height}
                        loading="lazy"
                        decoding="async"
                        crossorigin={isCommonsUploadImageUrl(visual.url) ? "anonymous" : undefined}
                        referrerpolicy="no-referrer"
                      />
                    </picture>
                  </a>
                  <span class="visual-context">{projectImageLabels[project.id] ?? v.referenceImage}</span>
                  <figcaption>
                    <a href={visual.pageUrl} target="_blank" rel="noreferrer">{visualCredit(visual)} ↗</a>
                  </figcaption>
                </figure>
              )}
              {!visual && (
                <div class="project-visual project-visual-placeholder" aria-hidden="true">
                  <span>⌖</span>
                </div>
              )}
              <div class="project-body">
                <div class="project-kicker">
                  <p class="eyebrow">{categoryLabel(project.category, lang)}</p>
                  <span class={`project-status status-${project.status}`}>{projectStatusLabel(project.status, lang)}</span>
                </div>
                <h3><a href={localizePath(`/projects/${project.id}`, lang)}>{field(project, "title", lang)}</a></h3>
                <p class="project-location"><span aria-hidden="true">⌖</span> {field(project.location, "address", lang)}</p>
                {project.data_quality === "provisional" && (
                  <p class="project-quality">{v.provisionalRecord}</p>
                )}
                <p class="project-summary">{field(project, "summary", lang)}</p>
                <div class="project-facts">
                  <span><small>{l.projectYear}</small><strong>{project.budget.year}</strong></span>
                  {amount && <span><small>{amountLabel}</small><strong>{amount}</strong></span>}
                </div>
                <a class="project-detail" href={localizePath(`/projects/${project.id}`, lang)}>
                  {l.projectDetail} <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

</Layout>

