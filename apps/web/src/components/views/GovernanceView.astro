const mayorTerms = cityArchive
  .filter((record) => record.kind === "mayor_term")
  .sort((a, b) => a.year_start - b.year_start || (a.year_end ?? currentYear) - (b.year_end ?? currentYear));
const currentMayor = mayorTerms.find((record) => record.year_end == null) ?? mayorTerms[mayorTerms.length - 1];
const earlyMayors = mayorTerms.slice(0, 3);
const recentMayors = [...mayorTerms]
  .filter((record) => record.id !== currentMayor?.id)
  .sort((a, b) => b.year_start - a.year_start || (b.year_end ?? currentYear) - (a.year_end ?? currentYear))
  .slice(0, 3);
const nonMayorArchive = cityArchive
  .filter((record) => record.kind !== "mayor_term")
  .sort((a, b) => a.year_start - b.year_start || (a.year_end ?? a.year_start) - (b.year_end ?? b.year_start));
const governanceChanges = nonMayorArchive.filter((record) => record.kind === "governance_change");
const archiveHighlights = [...governanceChanges].sort(
  (a, b) => a.year_start - b.year_start || (a.year_end ?? a.year_start) - (b.year_end ?? b.year_start)
);

type GovernanceVisual = {
  url: string;
  pageUrl: string;
  alt: string;
  credit: string;
  license: string;
  width: number;
  height: number;
};

type MediaLike = {
  url: string;
  page_url?: string;
  credit: string;
  license?: string;
  width?: number;
  height?: number;
};

function governanceVisual(media: MediaLike | null | undefined, alt: string): GovernanceVisual | null {
  if (!media) return null;
  return {
    url: media.url,
    pageUrl: media.page_url ?? media.url,
    alt,
    credit: media.credit.replace(/^(Unknown author){2,}$/, "Unknown author"),
    license: media.license ?? "",
    width: media.width ?? 1200,
    height: media.height ?? 800
  };
}

function archiveItemVisual(id: string): GovernanceVisual | null {
  const item = historicalArchiveItems.find((candidate) => candidate.id === id);
  return item ? governanceVisual(item.media, field(item, "title", lang)) : null;
}

function placeVisual(id: string): GovernanceVisual | null {
  const place = historyKnowledgePlaces.find((candidate) => candidate.id === id);
  return place ? governanceVisual(place.media[0], field(place, "name", lang)) : null;
}

const cityHallMedia = storyLongreads
  .find((story) => story.id === "story-socialist-infrastructure")
  ?.sections.flatMap((section) => section.gallery ?? [])
  .find((media) => media.url.includes("City_Hall_-_Plovdiv"));

const turningVisuals: Record<string, GovernanceVisual | null> = {
