const eventById = new Map(historyKnowledgeEvents.map((event) => [event.id, event]));
const placeById = new Map(historyKnowledgePlaces.map((place) => [place.id, place]));
const sourceById = new Map(historyKnowledgeSources.map((source) => [source.id, source]));
const archiveById = new Map(historicalArchiveItems.map((item) => [item.id, item]));
const pairById = new Map(thenNowPairs.map((pair) => [pair.id, pair]));

function localized(record: Record<string, unknown>, field: string): string {
  return String(
    record[`${field}_${lang}`] ?? record[`${field}_en`] ?? record[`${field}_bg`] ?? ""
  );
}

function sourceLabel(source: Record<string, unknown>): string {
  return sourceTitle(localized(source, "title"), lang);
}

function heroMedia(item: StoryLongread) {
  if (item.hero.kind === "archive_item") return archiveById.get(item.hero.ref_id)?.media;
  if (item.hero.kind === "then_now_pair") return pairById.get(item.hero.ref_id)?.then_media;
  return placeById.get(item.hero.ref_id)?.media[0];
}

function paragraphs(record: Record<string, unknown>): string[] {
  return localized(record, "body")
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

const media = heroMedia(story);
const mediaCommons = media ? isCommonsUploadImageUrl(media.url) : false;
const storyThenNowPairs = publicThenNowPairs(
  story.linked_then_now_pair_ids.map((id) => pairById.get(id)).filter(Boolean),
  { preferredPairIds: new Set(story.linked_then_now_pair_ids) }
);
const sourceRecords = story.source_ids
  .map((sourceId) => sourceById.get(sourceId))
  .filter((source) => source && !source.id.endsWith("-coordinates"));
const relatedStories = storyLongreads
  .filter((item) => item.id !== story.id)
  .map((item) => ({
    item,
    score:
      item.theme_tags.filter((tag) => story.theme_tags.includes(tag)).length * 4 +
      item.linked_place_ids.filter((id) => story.linked_place_ids.includes(id)).length * 3 +
      item.era_tags.filter((tag) => story.era_tags.includes(tag)).length * 2 +
      item.linked_event_ids.filter((id) => story.linked_event_ids.includes(id)).length * 2
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || a.item.id.localeCompare(b.item.id))
  .slice(0, 3);
---

<Layout
  lang={lang}
  path={`/stories/${story.id}`}
  title={localized(story, "title")}
  description={localized(story, "dek")}
  loadJapaneseWebfont={false}
>
  <article class="story-detail" data-story-detail data-section="stories">
    <header class="section story-detail-hero">
      <div class="container story-detail-grid">
        <div>
          <a class="text-link" href={localizePath("/stories", lang)}>{labels.back}</a>
          <p class="eyebrow">{`${story.reading_minutes} ${labels.minutes}`}</p>
          <h1>{localized(story, "title")}</h1>
          <p class="lead">{localized(story, "dek")}</p>
          <div class="tag-row">
            {story.era_tags.map((tag) => <span>{t.history.eraLabels[tag]}</span>)}
            {story.theme_tags.map((tag) => <span>{storyThemeTagLabel(tag, lang)}</span>)}
          </div>
        </div>
        {media && (
          <figure class="story-detail-media">
            <picture>
              {mediaCommons && <source media="(max-width: 760px)" srcset={commonsImageUrl(media.url, 960)} />}
              <img
                src={mediaCommons ? commonsImageUrl(media.url, 1280) : media.url}
                srcset={mediaCommons ? `${commonsImageUrl(media.url, 960)} 960w, ${commonsImageUrl(media.url, 1280)} 1280w` : undefined}
                sizes="(max-width: 760px) calc(100vw - 36px), 42vw"
                alt={localized(story.hero, "caption")}
                width="1280"
                height="1600"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                crossorigin={mediaCommons ? "anonymous" : undefined}
                referrerpolicy="no-referrer"
              />
            </picture>
            <figcaption>
              {localized(story.hero, "caption")}
              <a href={media.page_url} target="_blank" rel="noreferrer">{media.credit}</a>
            </figcaption>
          </figure>
        )}
      </div>
    </header>

    <section class="section">
      <div class="container story-detail-layout">
        <aside class="story-contents" aria-label={labels.contents}>
          <p class="eyebrow">{labels.contents}</p>
          <ol>
            {story.sections.map((section, index) => (
              <li>
                <a href={`#chapter-${index + 1}`}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {localized(section, "heading")}
                </a>
              </li>
            ))}
          </ol>
        </aside>

        <div class="story-narrative">
          {story.sections.map((section, index) => {
            const media = section.media;
            const mediaCommons = media ? isCommonsUploadImageUrl(media.url) : false;
            const gallery = section.gallery ?? [];
            return (
              <section class="story-chapter" id={`chapter-${index + 1}`}>
                <header class="story-chapter-head">
                  <p class="eyebrow">{`${labels.chapter} ${String(index + 1).padStart(2, "0")}`}</p>
                  <h2>{localized(section, "heading")}</h2>
                </header>
                {media && (
                  <figure class="story-section-figure">
                    <picture>
                      {mediaCommons && <source media="(max-width: 760px)" srcset={commonsImageUrl(media.url, 500)} />}
                      <img
                        src={mediaCommons ? commonsImageUrl(media.url, 960) : media.url}
                        alt={localized(media, "caption")}
                        width={media.width}
                        height={media.height}
                        loading="lazy"
                        fetchpriority="low"
                        decoding="async"
                        crossorigin={mediaCommons ? "anonymous" : undefined}
                        referrerpolicy="no-referrer"
                      />
                    </picture>
                    <figcaption>
                      {localized(media, "caption")}
                      {media.page_url ? (
                        <a href={media.page_url} target="_blank" rel="noreferrer">{media.credit} ↗</a>
                      ) : (
                        <span class="meta"> · {media.credit}</span>
                      )}
                    </figcaption>
                  </figure>
                )}
                <div class="story-prose">
                  {paragraphs(section).map((paragraph) => <p>{paragraph}</p>)}
                </div>
                {gallery.length > 0 && (
                  <section class="story-art-gallery-block" aria-label={localized(section, "gallery_label") || labels.gallery}>
                    <header class="story-art-gallery-head">
                      <p class="eyebrow">{localized(section, "gallery_label") || labels.gallery}</p>
                    </header>
                    <div class="story-art-gallery">
                      {gallery.map((artwork) => {
                        const artworkCommons = isCommonsUploadImageUrl(artwork.url);
                        return (
                          <figure class="story-artwork">
                            <picture>
                              {artworkCommons && (
                                <source
                                  media="(max-width: 760px)"
                                  data-story-gallery-source
                                  data-srcset={commonsImageUrl(artwork.url, 500)}
                                />
                              )}
                              <img
                                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                                data-story-gallery-image
                                data-src={artworkCommons ? commonsImageUrl(artwork.url, 960) : artwork.url}
                                data-srcset={artworkCommons ? `${commonsImageUrl(artwork.url, 500)} 500w, ${commonsImageUrl(artwork.url, 960)} 960w` : undefined}
                                sizes="(max-width: 760px) calc(100vw - 58px), 347px"
                                alt={localized(artwork, "caption")}
                                width={artwork.width}
                                height={artwork.height}
                                style={`aspect-ratio: ${artwork.width} / ${artwork.height}`}
                                loading="lazy"
                                fetchpriority="low"
                                decoding="async"
                                crossorigin={artworkCommons ? "anonymous" : undefined}
                                referrerpolicy="no-referrer"
                              />
                            </picture>
                            <noscript>
                              <img
                                src={artworkCommons ? commonsImageUrl(artwork.url, 960) : artwork.url}
                                alt={localized(artwork, "caption")}
                                width={artwork.width}
                                height={artwork.height}
                                loading="lazy"
                                decoding="async"
                                crossorigin={artworkCommons ? "anonymous" : undefined}
                                referrerpolicy="no-referrer"
                              />
                            </noscript>
                            <figcaption>
                              <span>{localized(artwork, "caption")}</span>
                              {artwork.page_url ? (
                                <a href={artwork.page_url} target="_blank" rel="noreferrer">{artwork.credit} ↗</a>
                              ) : (
                                <span class="meta">{artwork.credit}</span>
                              )}
                            </figcaption>
                          </figure>
                        );
                      })}
                    </div>
                  </section>
                )}
                {section.gallery_link && (
                  <a
                    class="story-gallery-link"
                    href={section.gallery_link.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <span>{localized(section.gallery_link, "label")}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </section>
            );
          })}

          <footer class="story-endnotes" aria-label={labels.linkedEvidence}>
            <div class="story-endnotes-head">
              <p class="eyebrow">{labels.linkedEvidence}</p>
              <h2>{labels.furtherReading}</h2>
            </div>

            <div class="story-trail-grid">
              {story.linked_event_ids.length > 0 && (
                <section>
                  <h3>{labels.events}</h3>
                  <ul>
                    {story.linked_event_ids.map((id) => {
                      const event = eventById.get(id);
                      if (!event) return null;
                      const title = localized(event, "title");
                      return <li><a href={`${localizePath("/history", lang)}?q=${encodeURIComponent(title)}#timeline`}>{title}</a></li>;
                    })}
                  </ul>
                </section>
              )}
              {story.linked_place_ids.length > 0 && (
                <section>
                  <h3>{labels.places}</h3>
                  <ul>
                    {story.linked_place_ids.map((id) => {
                      const place = placeById.get(id);
                      if (!place) return null;
                      return <li><a href={localizePath(`/places/${id}`, lang)}>{localized(place, "name")}</a></li>;
                    })}
                  </ul>
                </section>
              )}
              {story.linked_archive_item_ids.length > 0 && (
                <section>
                  <h3>{labels.archive}</h3>
                  <ul>
                    {story.linked_archive_item_ids.map((id) => {
                      const archive = archiveById.get(id);
                      if (!archive) return null;
                      return (
                        <li>
                          <a href={archive.media.page_url} target="_blank" rel="noreferrer">{localized(archive, "title")}</a>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              )}
              {storyThenNowPairs.length > 0 && (
                <section>
                  <h3>{labels.thenNow}</h3>
                  <ul>
                    {storyThenNowPairs.map((pair) => (
                      <li>
                        <a href={localizePath(`/places/${pair.place_id}`, lang)}>{localized(pair, "title")}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>

            <details class="story-source-drawer">
              <summary>{`${labels.sources} (${sourceRecords.length})`}</summary>
              <ol class="source-list">
                {sourceRecords.map((source) => (
                  <li>
                    <a href={source!.url} target="_blank" rel="noreferrer">{sourceLabel(source!)}</a>
                    <span class="meta"> · {`${t.common.accessed} ${source!.accessed_at}`}</span>
                  </li>
                ))}
              </ol>
            </details>
          </footer>
        </div>
      </div>
    </section>

    {relatedStories.length > 0 && (
      <section class="section section-muted">
        <div class="container">
          <div class="section-head compact">
            <h2>{labels.related}</h2>
          </div>
          <div class="story-grid compact">
            {relatedStories.map(({ item }) => (
              <article class="story-card compact">
                <div class="story-card-body">
                  <p class="eyebrow">{`${item.reading_minutes} ${labels.minutes}`}</p>
                  <h3><a href={localizePath(`/stories/${item.id}`, lang)}>{localized(item, "title")}</a></h3>
                  <p>{localized(item, "dek")}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <script>
    const galleryImages = Array.from(
      document.querySelectorAll<HTMLImageElement>("[data-story-gallery-image]")
    );

    function loadGalleryImage(image: HTMLImageElement) {
      const picture = image.closest("picture");
      const source = picture?.querySelector<HTMLSourceElement>("[data-story-gallery-source]");
      if (source?.dataset.srcset) {
        source.srcset = source.dataset.srcset;
        delete source.dataset.srcset;
      }
      if (image.dataset.srcset) {
        image.srcset = image.dataset.srcset;
        delete image.dataset.srcset;
      }
      if (image.dataset.src) {
        image.src = image.dataset.src;
        delete image.dataset.src;
      }
    }

    if (!("IntersectionObserver" in window)) {
      galleryImages.forEach(loadGalleryImage);
    } else {
      const galleryObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const image = entry.target as HTMLImageElement;
            loadGalleryImage(image);
            galleryObserver.unobserve(image);
          }
        },
        { rootMargin: "320px 0px" }
      );
      galleryImages.forEach((image) => galleryObserver.observe(image));
    }
  </script>
</Layout>
