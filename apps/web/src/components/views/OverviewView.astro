---
import Layout from "@layouts/Layout.astro";
import { ui, type Lang } from "@i18n/ui";
import { localizePath } from "@i18n/utils";
import { projects } from "@lib/data";
import { categoryLabel, projectStatusLabel } from "@lib/format";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];

// ---- Projects: status, category, year -------------------------------------
// Status is a pipeline, not a set of unrelated labels, so the five stages take
// one hue in monotone lightness steps and the ring reads as progress. The three
// states that sit outside the pipeline keep reserved hues of their own. The
// previous map gave in_progress and contracted the same hex (and funded the
// same as completed), which made two arcs of one donut indistinguishable.
// Values are CSS variables so the dark theme can re-step the ramp rather than
// reuse light-surface colours; the `--status-*` steps live in identity.css
// beside the other palette tokens.
const statusVars: Record<string, string> = {
  planned: "var(--status-planned)",
  contracted: "var(--status-contracted)",
  funded: "var(--status-funded)",
  in_progress: "var(--status-in-progress)",
  completed: "var(--status-completed)",
  postponed: "var(--status-postponed)",
  delayed: "var(--status-delayed)",
  unknown: "var(--status-unknown)"
};

/** Pipeline order first, then the out-of-pipeline states. */
const statusOrder = [
  "planned",
  "contracted",
  "funded",
  "in_progress",
  "completed",
  "postponed",
  "delayed",
  "unknown"
];

function countBy<T>(items: T[], key: (item: T) => string): Map<string, number> {
  const map = new Map<string, number>();
  for (const item of items) {
    const k = key(item);
    map.set(k, (map.get(k) ?? 0) + 1);
  }
  return map;
}

// Ordered by pipeline stage, not by size: with a lightness ramp the ring only
// reads as a progression if the arcs follow the stages around it.
const statusCounts = [...countBy(projects, (p) => p.status).entries()].sort((a, b) => {
  const ai = statusOrder.indexOf(a[0]);
  const bi = statusOrder.indexOf(b[0]);
  return (ai < 0 ? statusOrder.length : ai) - (bi < 0 ? statusOrder.length : bi);
});
const categoryCounts = [...countBy(projects, (p) => p.category).entries()].sort((a, b) => b[1] - a[1]);

// ---- Donut helper ----------------------------------------------------------
const R = 68;
const CIRC = 2 * Math.PI * R;

type Seg = { label: string; value: number; color: string; len: number; gap: number; offset: number };

function donut(items: { label: string; value: number; color: string }[]): Seg[] {
  const total = items.reduce((s, i) => s + i.value, 0) || 1;
  let acc = 0;
  return items.map((it) => {
    const len = (it.value / total) * CIRC;
    const seg: Seg = { ...it, len, gap: CIRC - len, offset: -acc };
    acc += len;
    return seg;
  });
}

const statusSegs = donut(
  statusCounts.map(([status, count]) => ({
    label: projectStatusLabel(status, lang),
    value: count,
    color: statusVars[status] ?? "var(--status-unknown)"
  }))
);

const maxCategory = Math.max(...categoryCounts.map(([, c]) => c), 1);
---

<Layout lang={lang} path="/overview" title={t.overview.title} description={t.overview.lead}>
  <section class="page-head" data-section="overview">
    <div class="container">
      <p class="eyebrow">{t.overview.eyebrow}</p>
      <h1>{t.overview.title}</h1>
      <p class="lead">{t.overview.lead}</p>
      <p class="meta" style="margin-top:10px">{t.overview.asOf}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="chart-grid">
        <!-- Projects by status (donut) -->
        <div class="chart-card">
          <h3>{t.overview.byStatusTitle}</h3>
          <div class="donut-wrap">
            <div class="donut-figure">
              <svg class="donut" viewBox="0 0 168 168" role="img" aria-label={t.overview.byStatusTitle}>
                <circle cx="84" cy="84" r={R} fill="none" stroke="var(--surface-3)" stroke-width="22" />
                {statusSegs.map((s) => (
                  <circle
                    class="donut-seg"
                    cx="84"
                    cy="84"
                    r={R}
                    stroke={s.color}
                    stroke-dasharray={`${s.len} ${s.gap}`}
                    stroke-dashoffset={s.offset}
                  />
                ))}
              </svg>
              <div class="donut-center"><strong>{projects.length}</strong><span>{t.nav.projects.toLowerCase()}</span></div>
            </div>
            <ul class="chart-legend">
              {statusSegs.map((s) => (
                <li>
                  <span class="swatch" style={`background:${s.color}`}></span>
                  {s.label}
                  <span class="legend-value">{s.value}</span>
                </li>
              ))}
            </ul>
          </div>
          <p class="chart-source">
            {t.overview.unitProjects} · <a href={localizePath("/projects", lang)}>{t.overview.viewProjects} →</a>
          </p>
        </div>

        <!-- Projects by category (bars) -->
        <div class="chart-card">
          <h3>{t.overview.byCategoryTitle}</h3>
          <div class="chart">
            {/* One series, one hue. Each bar is already named beside it, so
                tinting bars by category spent the identity channel re-encoding
                what the bar length shows — and put near-identical blues on
                "roads" and "sport", the two that sit next to each other. */}
            {categoryCounts.map(([category, count]) => (
              <div class="bar-row">
                <span class="bar-label">{categoryLabel(category, lang)}</span>
                <div class="bar-track" aria-hidden="true">
                  <div class="bar-fill" data-flat style={`width:${Math.max(6, (count / maxCategory) * 100)}%;--fill:var(--chart-series-1)`}></div>
                </div>
                <span class="money">{count}</span>
              </div>
            ))}
          </div>
          <p class="chart-source">
            {t.overview.unitProjects} · <a href={localizePath("/projects", lang)}>{t.overview.viewProjects} →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice">
        <span class="notice-icon" aria-hidden="true">ⓘ</span>
        <span>{t.overview.historyNote}</span>
      </div>
      <div class="actions">
        <a class="button secondary" href={localizePath("/projects", lang)}>{t.overview.viewProjects}</a>
      </div>
    </div>
  </section>
</Layout>
