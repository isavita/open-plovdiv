const archiveById = new Map(historicalArchiveItems.map((item) => [item.id, item]));
const pairById = new Map(thenNowPairs.map((pair) => [pair.id, pair]));
const placeById = new Map(historyKnowledgePlaces.map((place) => [place.id, place]));

const storyOrder = [
  "story-deep-time-seven-hills",
  "story-roman-philippopolis",
  "story-medieval-crossroads",
  "story-ottoman-filibe-city",
  "story-revival-houses-schools",
  "story-unification-civic-memory",
  "story-railway-1873",
  "story-international-fair-modernity",
  "story-1928-earthquake",
  "story-socialist-infrastructure",
  "story-old-plovdiv-restoration",
  "story-kapana-crafts-creative",
  "story-european-capital-culture",
  "story-maritsa-bridges",
  "story-plovdiv-painters"
];
const storyOrderById = new Map(storyOrder.map((id, index) => [id, index]));
const stories = [...storyLongreads].sort(
  (a, b) => (storyOrderById.get(a.id) ?? Number.MAX_SAFE_INTEGER) - (storyOrderById.get(b.id) ?? Number.MAX_SAFE_INTEGER)
);

function localized(record: Record<string, unknown>, field: string): string {
  return String(
    record[`${field}_${lang}`] ?? record[`${field}_en`] ?? record[`${field}_bg`] ?? ""
  );
}

function heroMedia(story: StoryLongread) {
  if (story.hero.kind === "archive_item") return archiveById.get(story.hero.ref_id)?.media;
  if (story.hero.kind === "then_now_pair") return pairById.get(story.hero.ref_id)?.then_media;
  return placeById.get(story.hero.ref_id)?.media[0];
}

---

<Layout lang={lang} path="/stories" title={labels.title} description={labels.lead}>
  <section class="section hero hero-compact stories-hero" data-section="stories">
    <div class="container hero-grid">
      <div>
        <div class="section-plate compact" aria-hidden="true" set:html={sectionMotifs.stories} />
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1>{labels.title}</h1>
        <p class="lead">{labels.lead}</p>
      </div>
    </div>
  </section>

  <section class="section" id="stories">
    <div class="container">
      <div class="story-grid">
        {stories.map((story, index) => {
          const media = heroMedia(story);
          const commonsMedia = media ? isCommonsUploadImageUrl(media.url) : false;
          return (
            <article class={`story-card${index === 0 ? " featured" : ""}`} data-story-card>
              {media && (
                <a class="story-card-media" href={localizePath(`/stories/${story.id}`, lang)} aria-label={localized(story, "title")}>
                  <picture>
                    {commonsMedia && <source media="(max-width: 760px)" srcset={commonsImageUrl(media.url, 500)} />}
                    <img
                      src={commonsImageUrl(media.url, 960)}
                      srcset={commonsMedia ? `${commonsImageUrl(media.url, 960)} 960w, ${commonsImageUrl(media.url, 1280)} 1280w` : undefined}
                      sizes="(max-width: 1180px) 50vw, 560px"
                      alt={localized(story.hero, "caption")}
                      width="960"
                      height="600"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                      decoding="async"
                      crossorigin={commonsMedia ? "anonymous" : undefined}
                      referrerpolicy="no-referrer"
                    />
                  </picture>
                </a>
              )}
              <div class="story-card-body">
                <p class="eyebrow">
                  {story.reading_minutes} {labels.minutes}
                  {story.era_tags[0] && ` · ${t.history.eraLabels[story.era_tags[0]]}`}
                </p>
                <h2><a href={localizePath(`/stories/${story.id}`, lang)}>{localized(story, "title")}</a></h2>
                <p class="story-card-dek">{localized(story, "dek")}</p>
                <a class="text-link" href={localizePath(`/stories/${story.id}`, lang)}>
                  {labels.read}<span class="arrow" aria-hidden="true"> →</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
