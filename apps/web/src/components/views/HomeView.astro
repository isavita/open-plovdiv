  { id: "place-old-town", title: labels.oldTownTitle, eyebrow: labels.oldTownEyebrow, text: labels.oldTownText },
  { id: "place-ancient-theatre", title: labels.theatreTitle, eyebrow: labels.theatreEyebrow, text: labels.theatreText },
  { id: "place-kapana-q12282547", title: labels.kapanaTitle, eyebrow: labels.kapanaEyebrow, text: labels.kapanaText },
  { id: "place-nebet-tepe", title: labels.nebetTitle, eyebrow: labels.nebetEyebrow, text: labels.nebetText }
].map(place => ({ ...place, media: placeMedia(place.id), href: localizePath(`/places/${place.id}`, lang) }));
const hero = placeMedia("place-ancient-theatre");
const routePhotos = ["place-kapana-q12282547", "place-ancient-theatre", "place-nebet-tepe"];
const routes = ["kapana-creative-hour", "roman-plovdiv-90", "hills-and-sunsets"].map((id, index) => {
  const route = walkingRoutes.find(route => route.id === id)!;
  const geometry = routeGeometry(id);
  return {
    href: localizePath(`/routes/${id}`, lang),
    title: field(route as unknown as Record<string, unknown>, "short_title", lang),
    text: field(route as unknown as Record<string, unknown>, "tagline", lang),
    minutes: route.duration_minutes,
    distance: geometry ? formatKm(geometry.distance_m, localeForLang(lang)) : null,
    photo: placeMedia(routePhotos[index])
  };
});
const eras = ["roman", "revival", "liberation"] as const;
---

<Layout lang={lang} loadJapaneseWebfont={false} path="/" description={guide.intro} image={placeImageUrl(hero.url, 1600)} imageAlt={labels.theatreTitle}>
  <div class="visitor-home">
    <section class="visitor-hero" aria-labelledby="welcome-title">
      <div class="container visitor-hero-layout">
        <div class="visitor-hero-copy">
          <p class="eyebrow">{guide.welcome}</p>
          <h1 id="welcome-title">{guide.city}<span>.</span></h1>
          <p class="visitor-headline">{guide.headline}</p>
          <p class="visitor-intro">{guide.intro}</p>
          <div class="actions">
            <a class="button" href={localizePath("/routes/first-day-plovdiv", lang)}>{guide.firstDay}<span aria-hidden="true">→</span></a>
            <a class="visitor-text-link" href="#plan-your-visit">{guide.plan}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="visitor-hero-photo">
          <picture>
            <source media="(max-width: 760px)" type="image/avif" srcset="/images/plovdiv/place-ancient-theatre-480.avif 480w, /images/plovdiv/place-ancient-theatre-768.avif 768w" sizes="calc(100vw - 36px)" />
            <source media="(max-width: 760px)" srcset={`${hero.small} 480w, ${hero.medium} 768w, ${hero.src} 960w`} sizes="calc(100vw - 36px)" />
          <img src={hero.src} srcset={`${hero.small} 480w, ${hero.medium} 768w, ${hero.src} 960w, ${placeImageUrl(hero.url, 1600)} 1500w`} sizes="(max-width: 760px) calc(100vw - 36px), 58vw" alt={labels.theatreTitle} width="1500" height="940" fetchpriority="high" decoding="async" />
          </picture>
          <figcaption><span>{labels.theatreTitle}</span><a href={hero.page_url} target="_blank" rel="noreferrer">© {hero.credit} · {hero.license} ↗</a></figcaption>
          <span class="visitor-photo-index" aria-hidden="true">01 / PLOVDIV</span>
        </figure>
      </div>
    </section>

    <nav class="visitor-quick-nav container" aria-label={guide.firstVisit}>
      <span>{guide.firstVisit}</span>
      <a href="#discover">{t.nav.places} <span aria-hidden="true">↗</span></a>
      <a href="#choose-a-walk">{labels.openRoutes} <span aria-hidden="true">↗</span></a>
      <a href="#city-stories">{t.nav.history} <span aria-hidden="true">↗</span></a>
      <a href="#plan-your-visit">{guide.plan} <span aria-hidden="true">↗</span></a>
    </nav>

    <section class="section visitor-discover" id="discover" aria-labelledby="discover-title">
      <div class="container">
        <div class="visitor-section-heading">
          <div><p class="eyebrow">{t.nav.places}</p><h2 id="discover-title">{guide.essentials}</h2></div>
          <a class="visitor-text-link" href={localizePath("/places", lang)}>{labels.allPlaces} <span aria-hidden="true">→</span></a>
        </div>
        <div class="visitor-place-grid">
          {essentials.map((place, index) => (
            <article class="visitor-place">
              <a class="visitor-place-image" href={place.href} tabindex="-1" aria-hidden="true">
                <img src={place.media.src} srcset={`${place.media.small} 480w, ${place.media.medium} 768w, ${place.media.src} 960w`} sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 1000px) 50vw, 25vw" alt="" width="640" height="480" loading="lazy" fetchpriority="low" decoding="async" />
                <span class="visitor-place-number">0{index + 1}</span>
              </a>
              <div class="visitor-place-body"><p class="eyebrow">{place.eyebrow}</p><h3><a href={place.href}>{place.title} <span aria-hidden="true">↗</span></a></h3><p>{place.text}</p>{place.id === "place-nebet-tepe" && <a class="visitor-place-source" href="https://www.plovdiv.bg/20250320/" target="_blank" rel="noreferrer">{t.footer.sources} ↗</a>}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section visitor-walks" id="choose-a-walk" aria-labelledby="walk-title">
      <div class="container">
        <div class="visitor-section-heading">
          <div><p class="eyebrow">{labels.paceEyebrow}</p><h2 id="walk-title">{labels.paceTitle}</h2></div>
          <p>{labels.paceLead}</p>
        </div>
        <div class="visitor-walk-grid">
          {routes.map((route) => (
            <a class="visitor-walk" href={route.href}>
              <img src={route.photo.src} srcset={`${route.photo.small} 480w, ${route.photo.medium} 768w, ${route.photo.src} 960w`} sizes="(max-width: 760px) 100vw, 33vw" alt="" width="600" height="420" loading="lazy" fetchpriority="low" decoding="async" />
              <span class="visitor-walk-duration">{route.minutes} {routeT.minutes}{route.distance && ` · ${route.distance} km`}</span>
              <div><h3>{route.title}</h3><p>{route.text}</p><span class="visitor-walk-arrow" aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
        <a class="visitor-text-link visitor-all-routes" href={localizePath("/routes", lang)}>{labels.routesPath} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section visitor-history" id="city-stories" aria-labelledby="city-stories-title">
      <div class="container visitor-history-layout">
        <div>
          <p class="eyebrow">{t.nav.history} · {labels.evidenceLabel}</p>
          <h2 id="city-stories-title">{guide.history}</h2>
          <p>{labels.historyPathText}</p>
          <a class="button" href={localizePath("/history", lang)}>{labels.historyPath} <span aria-hidden="true">→</span></a>
        </div>
        <div class="visitor-era-list">
          {eras.map((era, index) => (
            <a href={`${localizePath("/history", lang)}#chapter-${era}`}><span class="visitor-era-number">0{index + 1}</span><span><strong>{t.history.eraLabels[era]}</strong><small>{t.history.eraBlurbs[era]}</small></span><span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </div>
      <div class="container visitor-story-link"><span>{labels.storiesPathText}</span><a href={localizePath("/stories", lang)}>{labels.storiesPath} <span aria-hidden="true">→</span></a></div>
    </section>

    <VisitorPractical lang={lang} />
    <section class="visitor-signoff container" aria-label={t.footer.about}>
      <p>{labels.heroMotto}</p>
      <details class="visitor-photo-credits">
        <summary>{t.footer.sources}</summary>
        <p>{guide.photoNote}</p>
        <ul>{essentials.map(place => <li><a href={place.media.page_url} target="_blank" rel="noreferrer">{place.title} · {place.media.credit}</a> · <a href={place.media.license_url} target="_blank" rel="noreferrer">{place.media.license}</a></li>)}</ul>
      </details>
    </section>
  </div>
</Layout>
