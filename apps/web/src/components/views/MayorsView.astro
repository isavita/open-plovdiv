      "Демократичний період",
      "Демократический период"
    ),
    blurb: tr(
      "Свободните местни избори се завръщат през 1991 г.; кметовете отново се избират пряко от пловдивчани.",
      "Free local elections return in 1991; mayors are once again chosen directly by the people of Plovdiv.",
      "1991 kehren freie Kommunalwahlen zurück; die Bürgermeister werden wieder direkt von den Plovdivern gewählt.",
      "Les élections locales libres reviennent en 1991 ; les maires sont de nouveau élus directement par les Plovdiviens.",
      "Le libere elezioni locali tornano nel 1991; i sindaci sono di nuovo scelti direttamente dagli abitanti di Plovdiv.",
      "1991'de serbest yerel seçimler geri döner; başkanlar yeniden doğrudan Plovdivliler tarafından seçilir.",
      "Las elecciones locales libres regresan en 1991; los alcaldes vuelven a ser elegidos directamente por los plovdivenses.",
      "Οι ελεύθερες δημοτικές εκλογές επιστρέφουν το 1991· οι δήμαρχοι εκλέγονται ξανά απευθείας από τους κατοίκους.",
      "1991年に自由な地方選挙が復活し、市長は再び市民の直接選挙で選ばれるようになった。",
      "Bumalik ang malayang lokal na halalan noong 1991; muling direktang inihahalal ng mga taga-Plovdiv ang kanilang alkalde.",
      "1991 року повертаються вільні місцеві вибори; мерів знову обирають безпосередньо мешканці Пловдива.",
      "В 1991 году возвращаются свободные местные выборы; мэров снова напрямую избирают жители Пловдива."
    )
  },
  {
    key: "current",
    start: 2023,
    end: currentYear,
    label: tr(
      "Настоящ мандат",
      "Current office",
      "Aktuelle Amtszeit",
      "Mandat en cours",
      "Mandato in corso",
      "Görevdeki başkan",
      "Mandato actual",
      "Τρέχουσα θητεία",
      "現職",
      "Kasalukuyang Termino",
      "Чинна каденція",
      "Текущий срок полномочий"
    ),
    blurb: tr(
      "Мандат 2023–2027 на действащия кмет на Пловдив.",
      "The 2023–2027 term of Plovdiv's incumbent mayor.",
      "Die Amtszeit 2023–2027 des amtierenden Bürgermeisters von Plovdiv.",
      "Le mandat 2023–2027 du maire en exercice de Plovdiv.",
      "Il mandato 2023–2027 del sindaco in carica di Plovdiv.",
      "Plovdiv'in görevdeki başkanının 2023–2027 dönemi.",
      "El mandato 2023–2027 del alcalde en ejercicio de Plovdiv.",
      "Η θητεία 2023–2027 του εν ενεργεία δημάρχου της Φιλιππούπολης.",
      "現職市長の2023–2027年の任期。",
      "Ang terminong 2023–2027 ng kasalukuyang alkalde ng Plovdiv.",
      "Каденція 2023–2027 чинного мера Пловдива.",
      "Срок полномочий 2023–2027 действующего мэра Пловдива."
    )
  }
];

const periodGroups = periodBands
  .map((band) => ({
    ...band,
    mayors: mayorTerms.filter((term) => term.year_start >= band.start && term.year_start <= band.end)
  }))
  .filter((band) => band.mayors.length > 0);

const timelineEyebrow = tr("Хронология по епохи", "Chronology by era", "Chronologie nach Epochen", "Chronologie par époque", "Cronologia per epoca", "Çağa göre kronoloji", "Cronología por época", "Χρονολόγιο ανά εποχή", "時代別年表", "Kronolohiya ayon sa Panahon", "Хронологія за епохами", "Хронология по эпохам");

// --- chronicle: records and curiosities computed from the archive ------
// Term lengths come from the exact dates in the Bulgarian period strings
// (the source language), ages from the vital years documented in the bios.
const bgMonths: Record<string, number> = {
  "януари": 1, "февруари": 2, "март": 3, "април": 4, "май": 5, "юни": 6,
  "юли": 7, "август": 8, "септември": 9, "октомври": 10, "ноември": 11, "декември": 12
};

function periodDays(term: (typeof mayorTerms)[number]): number | null {
  const period = term.period_bg ?? "";
  const found = [...period.matchAll(/(\d{1,2})\s+(януари|февруари|март|април|май|юни|юли|август|септември|октомври|ноември|декември)(?:\s+(\d{4}))?/gu)];
  if (found.length < 2) return null;
  const years = period.match(/\d{4}/gu) ?? [];
  const first = found[0];
  const last = found[found.length - 1];
  const startYear = first[3] ?? years[0];
  const endYear = last[3] ?? years[years.length - 1];
  if (!startYear || !endYear) return null;
  const days = Math.round(
    (Date.UTC(Number(endYear), bgMonths[last[2]] - 1, Number(last[1])) -
      Date.UTC(Number(startYear), bgMonths[first[2]] - 1, Number(first[1]))) / 86400000
  );
  return days > 0 ? days : null;
}

const completedTerms = mayorTerms.filter((term) => term.year_end != null);
const termsWithDays = completedTerms.map((term) => ({ term, days: periodDays(term) }));
const shortestTerm = termsWithDays
  .filter((entry): entry is { term: (typeof mayorTerms)[number]; days: number } => entry.days != null)
  .sort((a, b) => a.days - b.days)[0];
const longestTerm = termsWithDays
  .map((entry) => ({
    term: entry.term,
    days: entry.days ?? Math.round(Math.max(1, entry.term.year_end! - entry.term.year_start) * 365.25)
  }))
  .sort((a, b) => b.days - a.days)[0];

function birthYearOf(term: (typeof mayorTerms)[number]): number | null {
  const bio = (term.bio_bg ?? "").slice(0, 220);
  const match = bio.match(/\((\d{4})\s*[-–—]\s*(?:\d{4})\)/u) ?? bio.match(/\(р\.\s*(\d{4})\)/u);
  return match ? Number(match[1]) : null;
}

const termsWithAge = mayorTerms
  .map((term) => ({ term, age: birthYearOf(term) == null ? null : term.year_start - birthYearOf(term)! }))
  .filter((entry): entry is { term: (typeof mayorTerms)[number]; age: number } =>
    entry.age != null && entry.age >= 20 && entry.age <= 80)
  .sort((a, b) => a.age - b.age);
const youngestTerm = termsWithAge[0];
const oldestTerm = termsWithAge[termsWithAge.length - 1];

const mostTermsGroup = multiTerm[0];
const personsWithBirthplace = [...birthPersons.values()];
const plovdivBornCount = personsWithBirthplace.filter((person) =>
  (person.birthplace_bg ?? "").startsWith("Пловдив")).length;

function daysWord(n: number): string {
  if (lang === "uk" || lang === "ru") {
    const mod10 = n % 10;
    const mod100 = n % 100;
    const form = mod10 === 1 && mod100 !== 11 ? 0 : mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) ? 1 : 2;
    return (lang === "uk" ? ["день", "дні", "днів"] : ["день", "дня", "дней"])[form];
  }
  if (n === 1) return tr("ден", "day", "Tag", "jour", "giorno", "gün", "día", "ημέρα", "日", "araw", "день", "день");
  return tr("дни", "days", "Tage", "jours", "giorni", "gün", "días", "ημέρες", "日間", "araw", "дні", "дней");
}

const ageWord = tr("г.", "yrs", "J.", "ans", "anni", "yaş", "años", "ετών", "歳", "taon", "р.", "лет");
const ofWord = tr("от", "of", "von", "sur", "di", "/", "de", "από", "／", "sa", "з", "из");
// Japanese counters attach directly to the numeral (21日, 68歳), no space.
const withUnit = (value: number | string, unit: string) => (lang === "ja" ? `${value}${unit}` : `${value} ${unit}`);

const chronicleL = {
  eyebrow: tr("Из архива", "From the archive", "Aus dem Archiv", "Tiré des archives", "Dall'archivio", "Arşivden", "Del archivo", "Από το αρχείο", "アーカイブから", "Mula sa archive", "З архіву", "Из архива"),
  title: tr("Рекорди и любопитни факти", "Records and curiosities", "Rekorde und Kurioses", "Records et curiosités", "Record e curiosità", "Rekorlar ve ilginç bilgiler", "Récords y curiosidades", "Ρεκόρ και αξιοπερίεργα", "記録と豆知識", "Mga rekord at kakaibang detalye", "Рекорди та цікавинки", "Рекорды и любопытные факты"),
  lead: tr(
    "Изчислено от датите и биографиите в архива — всяка плочка води към съответния мандат.",
    "Computed from the dates and biographies in the archive — every tile links to its term.",
    "Berechnet aus den Daten und Biografien des Archivs — jede Kachel führt zur jeweiligen Amtszeit.",
    "Calculé à partir des dates et biographies des archives — chaque tuile mène au mandat correspondant.",
    "Calcolato dalle date e dalle biografie dell'archivio — ogni riquadro porta al mandato corrispondente.",
    "Arşivdeki tarihlerden ve biyografilerden hesaplandı — her kutucuk ilgili göreve gider.",
    "Calculado a partir de las fechas y biografías del archivo — cada ficha lleva a su mandato.",
    "Υπολογισμένο από τις ημερομηνίες και τις βιογραφίες του αρχείου — κάθε πλακίδιο οδηγεί στη θητεία του.",
    "アーカイブの日付と伝記から算出。各タイルは該当する任期のページへつながっています。",
    "Kinalkula mula sa mga petsa at talambuhay sa archive — bawat tile ay tumuturo sa kaukulang termino.",
    "Обчислено з дат і біографій архіву — кожна плитка веде до відповідної каденції.",
    "Вычислено по датам и биографиям архива — каждая плитка ведёт к соответствующему сроку."
  ),
  shortest: tr("Най-кратък мандат", "Shortest term", "Kürzeste Amtszeit", "Mandat le plus court", "Mandato più breve", "En kısa görev", "Mandato más corto", "Συντομότερη θητεία", "最短の任期", "Pinakamaikling termino", "Найкоротша каденція", "Самый короткий срок"),
  longest: tr("Най-дълъг мандат", "Longest term", "Längste Amtszeit", "Mandat le plus long", "Mandato più lungo", "En uzun görev", "Mandato más largo", "Μακροβιότερη θητεία", "最長の任期", "Pinakamahabang termino", "Найдовша каденція", "Самый долгий срок"),
  most: tr("Най-много мандати", "Most terms", "Meiste Amtszeiten", "Plus de mandats", "Più mandati", "En çok görev", "Más mandatos", "Περισσότερες θητείες", "最多の任期数", "Pinakamaraming termino", "Найбільше каденцій", "Больше всего сроков"),
  youngest: tr("Най-млад при встъпване", "Youngest on taking office", "Jüngster beim Amtsantritt", "Le plus jeune à l'entrée en fonction", "Il più giovane all'insediamento", "Göreve gelen en genç", "El más joven al asumir", "Νεότερος κατά την ανάληψη", "就任時最年少", "Pinakabata sa pag-upo", "Наймолодший на початку каденції", "Самый молодой при вступлении"),
  oldest: tr("Най-възрастен при встъпване", "Oldest on taking office", "Ältester beim Amtsantritt", "Le plus âgé à l'entrée en fonction", "Il più anziano all'insediamento", "Göreve gelen en yaşlı", "El más mayor al asumir", "Γηραιότερος κατά την ανάληψη", "就任時最年長", "Pinakamatanda sa pag-upo", "Найстарший на початку каденції", "Самый старший при вступлении"),
  bornInCity: tr("Родени в Пловдив", "Born in Plovdiv", "In Plovdiv geboren", "Nés à Plovdiv", "Nati a Plovdiv", "Plovdiv doğumlu", "Nacidos en Plovdiv", "Γεννημένοι στη Φιλιππούπολη", "プロヴディフ生まれ", "Ipinanganak sa Plovdiv", "Народжені в Пловдиві", "Родившиеся в Пловдиве"),
  bornInCityNote: tr("личности с известно родно място", "people with a documented birthplace", "Personen mit belegtem Geburtsort", "personnes au lieu de naissance documenté", "persone con luogo di nascita documentato", "doğum yeri belgeli kişiler", "personas con lugar de nacimiento documentado", "πρόσωπα με τεκμηριωμένο τόπο γέννησης", "出生地が記録されている人物", "mga taong may dokumentadong lugar ng kapanganakan", "особи з відомим місцем народження", "люди с документированным местом рождения"),
  ailyak: tr(
    "Айляк бележка: най-краткият мандат трая {daysText} — тъкмо колкото да се научиш да не бързаш.",
    "Ailyak note: the shortest term lasted {daysText} — just long enough to learn not to hurry.",
    "Ailyak-Notiz: Die kürzeste Amtszeit dauerte {daysText} — gerade lang genug, um zu lernen, nicht zu eilen.",
    "Note aïlyak : le mandat le plus court a duré {daysText} — juste le temps d'apprendre à ne pas se presser.",
    "Nota ailyak: il mandato più breve durò {daysText} — giusto il tempo di imparare a non avere fretta.",
    "Aylyak notu: en kısa görev {daysText} sürdü — acele etmemeyi öğrenmeye tam yetecek kadar.",
    "Nota ailyak: el mandato más corto duró {daysText} — justo lo suficiente para aprender a no tener prisa.",
    "Σημείωση αϊλιάκ: η συντομότερη θητεία κράτησε {daysText} — ίσα ίσα για να μάθεις να μη βιάζεσαι.",
    "アイリャクのひとこと：最短の任期はわずか{daysText}。急がないことを学ぶには、ちょうどよい長さでした。",
    "Tala ng ailyak: tumagal ng {daysText} ang pinakamaikling termino — sapat lang para matutong huwag magmadali.",
    "Айляк-нотатка: найкоротша каденція тривала {daysText} — якраз стільки, щоб навчитися не поспішати.",
    "Айляк-заметка: самый короткий срок длился {daysText} — как раз достаточно, чтобы научиться не спешить."
  )
};

// --- portrait frieze in the page head -----------------------------------
// One tile per person (first term with a portrait), in chronological order.
const friezePersons = (() => {
  const seen = new Map<string, (typeof mayorTerms)[number]>();
  for (const term of mayorTerms) {
    const key = term.more_url ?? term.actor_bg;
    const current = seen.get(key);
    if (!current) seen.set(key, term);
    else if (!current.image && term.image) seen.set(key, term);
  }
  return [...seen.values()].filter((term) => term.image);
})();
const friezeShown = friezePersons.slice(0, 18);
const friezeMore = Math.max(0, uniqueMayors.size - friezeShown.length);

const sectionNav = ({
      bg: [
        { id: "connections", label: "Връзки" },
        { id: "birthplaces", label: "Родни места" },
        { id: "timeline", label: "Хронология" },
        { id: "all-mayors", label: "Всички" }
      ],
      en: [
        { id: "connections", label: "Connections" },
        { id: "birthplaces", label: "Birthplaces" },
        { id: "timeline", label: "Timeline" },
        { id: "all-mayors", label: "All mayors" }
      ],
      de: [
        { id: "connections", label: "Verbindungen" },
        { id: "birthplaces", label: "Geburtsorte" },
        { id: "timeline", label: "Zeitleiste" },
        { id: "all-mayors", label: "Alle" }
      ],
      fr: [
        { id: "connections", label: "Liens" },
        { id: "birthplaces", label: "Lieux de naissance" },
        { id: "timeline", label: "Chronologie" },
        { id: "all-mayors", label: "Tous" }
      ],
      it: [
        { id: "connections", label: "Legami" },
        { id: "birthplaces", label: "Luoghi di nascita" },
        { id: "timeline", label: "Cronologia" },
        { id: "all-mayors", label: "Tutti" }
      ],
      tr: [
        { id: "connections", label: "Bağlar" },
        { id: "birthplaces", label: "Doğum yerleri" },
        { id: "timeline", label: "Zaman çizelgesi" },
        { id: "all-mayors", label: "Tümü" }
      ],
      es: [
        { id: "connections", label: "Conexiones" },
        { id: "birthplaces", label: "Lugares de nacimiento" },
        { id: "timeline", label: "Cronología" },
        { id: "all-mayors", label: "Todos" }
      ],
      el: [
        { id: "connections", label: "Συνδέσεις" },
        { id: "birthplaces", label: "Τόποι γέννησης" },
        { id: "timeline", label: "Χρονολόγιο" },
        { id: "all-mayors", label: "Όλοι" }
      ],
      ja: [
        { id: "connections", label: "つながり" },
        { id: "birthplaces", label: "出生地" },
        { id: "timeline", label: "年表" },
        { id: "all-mayors", label: "すべて" }
      ],
      tl: [
        { id: "connections", label: "Mga Koneksyon" },
        { id: "birthplaces", label: "Mga Lugar ng Kapanganakan" },
        { id: "timeline", label: "Kronolohiya" },
        { id: "all-mayors", label: "Lahat" }
      ],
      uk: [
        { id: "connections", label: "Зв'язки" },
        { id: "birthplaces", label: "Місця народження" },
        { id: "timeline", label: "Хронологія" },
        { id: "all-mayors", label: "Усі" }
      ],
      ru: [
        { id: "connections", label: "Связи" },
        { id: "birthplaces", label: "Места рождения" },
        { id: "timeline", label: "Хронология" },
        { id: "all-mayors", label: "Все" }
      ]
    } satisfies Record<Lang, { id: string; label: string }[]>)[lang];
const sectionNavLabel = lang === "bg" ? "Раздели на страницата" : lang === "de" ? "Seitenabschnitte" : lang === "fr" ? "Sections de la page" : lang === "it" ? "Sezioni della pagina" : lang === "tr" ? "Sayfa bölümleri" : lang === "es" ? "Secciones de la página" : lang === "el" ? "Ενότητες σελίδας" : lang === "ja" ? "ページ内セクション" : lang === "tl" ? "Mga Seksyon ng Pahina" : lang === "uk" ? "Розділи сторінки" : lang === "ru" ? "Разделы страницы" : "Page sections";
---

<Layout lang={lang} path="/mayors" title={t.mayors.title} description={t.mayors.lead}>
  <section class="page-head" data-section="mayors">
    <div class="container page-head-grid">
      <div>
        <p class="eyebrow">{t.mayors.eyebrow}</p>
        <h1>{t.mayors.title}</h1>
        <p class="lead">{t.mayors.lead}</p>
        <p class="meta" style="margin-top:10px">{t.mayors.sourceNote}</p>
      </div>
      {friezeShown.length > 0 && (
        <div class="mayor-frieze" role="list">
          {friezeShown.map((term) => (
            <a
              role="listitem"
              href={localizePath(`/mayors/${term.id}`, lang)}
              title={field(term, "actor", lang)}
              data-current={term.year_end == null ? "true" : undefined}
            >
              <img
                src={term.image}
                alt={t.mayors.portraitAlt(field(term, "actor", lang))}
                width="52"
                height="66"
                loading="eager"
                fetchpriority="low"
              />
            </a>
          ))}
          {friezeMore > 0 && (
            <a class="mayor-frieze-more" href="#all-mayors" aria-label={t.mayors.detailsTitle}>
              +{friezeMore}
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  <SectionNav items={sectionNav} label={sectionNavLabel} />

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="stat-row">
        <div class="stat"><strong>{mayorTerms.length}</strong><span>{t.mayors.statTerms}</span></div>
        <div class="stat"><strong>{uniqueMayors.size}</strong><span>{t.mayors.statPeople}</span></div>
        <div class="stat"><strong>{coveredYears}</strong><span>{t.mayors.statYears}</span></div>
        {currentMayor && <div class="stat"><strong>{field(currentMayor, "actor", lang)}</strong><span>{t.mayors.statCurrent}</span></div>}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" id="chronicle">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{chronicleL.eyebrow}</p>
          <h2>{chronicleL.title}</h2>
          <p class="meta" style="margin-top:8px;max-width:74ch">{chronicleL.lead}</p>
        </div>
      </div>
      <div class="chronicle-grid">
        {shortestTerm && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.shortest}</span>
            <strong>{withUnit(shortestTerm.days, daysWord(shortestTerm.days))}</strong>
            <a href={localizePath(`/mayors/${shortestTerm.term.id}`, lang)}>
              {field(shortestTerm.term, "actor", lang)} · {shortestTerm.term.year_start}
            </a>
          </article>
        )}
        {longestTerm && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.longest}</span>
            <strong>{t.mayors.yearsApprox(Math.round(longestTerm.days / 365.25))}</strong>
            <a href={localizePath(`/mayors/${longestTerm.term.id}`, lang)}>
              {field(longestTerm.term, "actor", lang)} · {longestTerm.term.year_start}–{longestTerm.term.year_end}
            </a>
          </article>
        )}
        {mostTermsGroup && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.most}</span>
            <strong>{mostTermsGroup.length}×</strong>
            <a href={localizePath(`/mayors/${mostTermsGroup[0].id}`, lang)}>
              {field(mostTermsGroup[0], "actor", lang)}
            </a>
          </article>
        )}
        {youngestTerm && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.youngest}</span>
            <strong>{withUnit(youngestTerm.age, ageWord)}</strong>
            <a href={localizePath(`/mayors/${youngestTerm.term.id}`, lang)}>
              {field(youngestTerm.term, "actor", lang)} · {youngestTerm.term.year_start}
            </a>
          </article>
        )}
        {oldestTerm && oldestTerm !== youngestTerm && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.oldest}</span>
            <strong>{withUnit(oldestTerm.age, ageWord)}</strong>
            <a href={localizePath(`/mayors/${oldestTerm.term.id}`, lang)}>
              {field(oldestTerm.term, "actor", lang)} · {oldestTerm.term.year_start}
            </a>
          </article>
        )}
        {personsWithBirthplace.length > 0 && (
          <article class="chronicle-tile">
            <span class="chronicle-label">{chronicleL.bornInCity}</span>
            <strong>{withUnit(plovdivBornCount, `${ofWord} ${personsWithBirthplace.length}`.replace(/\s+/gu, lang === "ja" ? "" : " "))}</strong>
            <a href="#birthplaces">{chronicleL.bornInCityNote}</a>
          </article>
        )}
      </div>
      {shortestTerm && (
        <p class="chronicle-ailyak">
          {chronicleL.ailyak.replace(
            "{daysText}",
            withUnit(shortestTerm.days, lang === "ja" ? "日" : daysWord(shortestTerm.days))
          )}
        </p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top:0" id="connections" data-subnav-target>
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{t.mayors.connectionsTitle}</h2>
          <p class="meta" style="margin-top:8px;max-width:74ch">{t.mayors.connectionsLead}</p>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top:4px;align-items:start">
        <div class="card">
          <h3>{t.mayors.multiTermTitle}</h3>
          <ul class="connect-list">
            {multiTerm.map((g) => (
              <li>
                <span class="connect-name">
                  <a href={localizePath(`/mayors/${g[0].id}`, lang)}>{field(g[0], "actor", lang)}</a>
                  <span class="connect-count" data-cat="people">{`${g.length}×`}</span>
                </span>
                <span class="connect-years">
                  {g
                    .map((tm) =>
                      tm.year_end == null
                        ? `${tm.year_start}–${currentYear}`
                        : tm.year_end === tm.year_start
                          ? `${tm.year_start}`
                          : `${tm.year_start}–${tm.year_end}`
                    )
                    .join(" · ")}
                </span>
              </li>
            ))}
          </ul>
        </div>
        {familyTies.length > 0 && (
          <div class="card">
            <h3>{t.mayors.familyTitle}</h3>
            <ul class="connect-list">
              {familyTies.map((pair) => (
                <li>
                  <span>{`${pair.a} — ${pair.b}`}</span>
                  <span class="connect-years">{pair[`label_${lang}`] ?? pair.label_en ?? pair.label_bg}</span>
                </li>
              ))}
            </ul>
            <p class="meta" style="margin-top:14px">{t.mayors.portraitNote}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  {birthTowns.length > 0 && (
    <section class="section" style="padding-top:0" id="birthplaces" data-subnav-target>
      <div class="container">
        <div class="section-head">
          <div>
            <h2>{t.mayors.birthTitle}</h2>
            <p class="meta" style="margin-top:8px;max-width:74ch">{t.mayors.birthLead}</p>
          </div>
          <div class="pill-row">
            <span class="badge no-dot">{`${birthTowns.length} ${t.mayors.birthStatTowns}`}</span>
            <span class="badge no-dot">{`${birthCountries.size} ${t.mayors.birthStatCountries}`}</span>
          </div>
        </div>

        <div class="grid grid-2 birth-layout">
          <div class="card map-card" style="padding:0;overflow:hidden">
            <div id="mayor-birth-map" class="birth-map"></div>
          </div>
          <div class="card">
            <h3>{t.mayors.birthByTown}</h3>
            <ul class="birth-bars">
              {birthTowns.map((town) => (
                <li>
                  <span class="birth-town" title={town.name}>{town.name}</span>
                  <span class="birth-bar">
                    <span
                      class="birth-bar-fill"
                      style={`width:${Math.round((town.people.length / maxBirthCount) * 100)}%`}
                    ></span>
                  </span>
                  <span class="birth-count">{town.people.length}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section section-tint" id="timeline" data-subnav-target>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{timelineEyebrow}</p>
          <h2>{t.mayors.timelineTitle}</h2>
          <p class="meta" style="margin-top:8px;max-width:74ch">{t.mayors.timelineLead}</p>
        </div>
      </div>

      <div class="mt-chronology" aria-label={t.mayors.timelineTitle}>
        {periodGroups.map((band) => (
          <section class="mt-period" data-period={band.key}>
            <header class="mt-period-head">
              <span class="mt-period-tag">{band.start}–{band.end === currentYear ? "" : band.end}</span>
              <h3>{band.label}</h3>
              <p class="meta">{t.mayors.count(band.mayors.length)}</p>
            </header>
            {band.blurb && <p class="mt-period-blurb">{band.blurb}</p>}
            <ol class="mt-rail">
              {band.mayors.map((term) => {
                const isCurrent = term.year_end == null;
                const isActing = isActingTerm(term);
                const search = [
                  field(term, "actor", lang),
                  field(term, "period", lang),
                  term.year_start,
                  term.year_end ?? currentYear,
                  field(term, "summary", lang)
                ].join(" ").toLocaleLowerCase(locale);
                return (
                  <li
                    class="mt-item"
                    data-mayor-chip
                    data-search={search}
                    data-century={centuryFor(term.year_start)}
                    data-status={isCurrent ? "current" : isActing ? "acting" : "regular"}
                  >
                    <span class={`mt-dot${isCurrent ? " mt-dot-current" : ""}`} aria-hidden="true"></span>
                    <span class="mt-year">{term.year_start}</span>
                    <a class="mt-card" href={`#${term.id}`}>
                      {term.image ? (
                        <img
                          class="mayor-portrait mt-portrait"
                          src={term.image}
                          alt={t.mayors.portraitAlt(field(term, "actor", lang))}
                          width="40"
                          height="40"
                          loading="lazy"
                        />
                      ) : (
                        <span class="mayor-portrait mayor-portrait-fallback bust-fallback mt-portrait" aria-hidden="true">
                          <Fragment set:html={bustGlyph} />
                          <span class="bust-mono">{initials(field(term, "actor", lang))}</span>
                        </span>
                      )}
                      <span class="mt-cardtext">
                        <strong>{field(term, "actor", lang)}</strong>
                        <small>
                          {term.year_start}{term.year_end ? `–${term.year_end}` : `–${currentYear}`}
                          {isCurrent && <em class="mt-now">{t.mayors.currentBadge}</em>}
                          {isActing && !isCurrent && <em class="mt-acting">{t.mayors.actingBadge}</em>}
                        </small>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="all-mayors" data-subnav-target>
    <div class="container">
      <div class="toolbar">
        <div class="catalog-search-layout">
          <div class="field">
            <label for="mayor-search">{t.mayors.search}</label>
            <input id="mayor-search" type="search" placeholder={t.mayors.searchPlaceholder} />
          </div>
          <details class="catalog-filter-disclosure">
            <summary>{searchUi.filters}</summary>
            <div class="catalog-filter-grid catalog-filter-grid-2">
              <div class="field">
                <label for="mayor-century">{t.mayors.century}</label>
                <select id="mayor-century">
                  <option value="all">{t.mayors.allCenturies}</option>
                  {centuries.map((century) => (
                    <option value={century}>
                      {t.mayors.centuryLabel(century)} ({centuryCounts.get(century)})
                    </option>
                  ))}
                </select>
              </div>
              <div class="field">
                <label for="mayor-status">{t.mayors.status}</label>
                <select id="mayor-status">
                  <option value="all">{t.mayors.allStatuses}</option>
                  <option value="current">{t.mayors.currentOnly}</option>
                  <option value="acting">{t.mayors.actingOnly}</option>
                </select>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="results-bar">
        <p id="mayor-count" class="meta">{t.mayors.count(mayorTerms.length)}</p>
        <button type="button" id="mayor-reset" class="link-button" hidden>{t.mayors.reset}</button>
      </div>

      <div class="mayor-layout">
        <aside class="mayor-index" aria-label={t.mayors.century}>
          <h2>{t.mayors.detailsTitle}</h2>
          <ol>
            {centuries.map((century) => (
              <li>
                <a href={`#century-${century}`}>{t.mayors.centuryLabel(century)}</a>
                <span>{centuryCounts.get(century)}</span>
              </li>
            ))}
          </ol>
          <div class="muted-card">
            <h3>{t.mayors.sourcesTitle}</h3>
            <p class="meta">{t.mayors.sourcesText}</p>
            <ul class="source-list" style="margin-top:12px">
              {sourceUrls.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">{sourceTitle(source.title, lang)}</a>
                  <span class="meta"> · {source.accessed_at}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <div class="mayor-list">
          {centuries.map((century) => (
            <section class="mayor-century" id={`century-${century}`}>
              <div class="section-head">
                <h2>{t.mayors.centuryLabel(century)}</h2>
                <p class="meta">{centuryCounts.get(century)} {t.mayors.statTerms}</p>
              </div>
              <div class="list">
                {mayorTerms
                  .filter((term) => centuryFor(term.year_start) === century)
                  .map((term) => {
                    const index = mayorTerms.findIndex((item) => item.id === term.id) + 1;
                    const isCurrent = term.year_end == null;
                    const period = field(term, "period", lang);
                    const isActing = isActingTerm(term, period);
                    const search = [
                      field(term, "actor", lang),
                      period,
                      term.year_start,
                      term.year_end ?? currentYear,
                      field(term, "summary", lang)
                    ].join(" ").toLocaleLowerCase(locale);
                    return (
                      <article
                        class="card mayor-card"
                        id={term.id}
                        data-mayor-card
                        data-search={search}
                        data-century={century}
                        data-status={isCurrent ? "current" : isActing ? "acting" : "regular"}
                      >
                        <header class="mayor-card-head">
                          {term.image ? (
                            <img
                              class="mayor-portrait"
                              src={term.image}
                              alt={t.mayors.portraitAlt(field(term, "actor", lang))}
                              width="52"
                              height="52"
                              loading="lazy"
                            />
                          ) : (
                            <span class="mayor-portrait mayor-portrait-fallback bust-fallback" aria-hidden="true">
                              <Fragment set:html={bustGlyph} />
                              <span class="bust-mono">{initials(field(term, "actor", lang))}</span>
                            </span>
                          )}
                          <div class="mayor-card-headtext">
                            <p class="eyebrow">{t.mayors.termNumber} {index}</p>
                            <h3>{field(term, "actor", lang)}</h3>
                          </div>
                          <div class="pill-row">
                            {isCurrent && <span class="badge status-active">{t.mayors.currentBadge}</span>}
                            {isActing && <span class="badge no-dot">{t.mayors.actingBadge}</span>}
                            {term.fate === "killed" && <span class="badge badge-killed">{t.mayors.fateLabels.killed}</span>}
                            {term.bio_bg && <span class="badge no-dot">{t.mayors.biography}</span>}
                          </div>
                        </header>
                        <div class="mayor-facts">
                          <div>
                            <span>{t.mayors.years}</span>
                            <strong>{term.year_start}{term.year_end ? `-${term.year_end}` : `-${currentYear}`}</strong>
                          </div>
                          <div>
                            <span>{t.mayors.duration}</span>
                            <strong>{t.mayors.yearsApprox(durationYears(term.year_start, term.year_end))}</strong>
                          </div>
                          <div>
                            <span>{t.mayors.century}</span>
                            <strong>{t.mayors.centuryLabel(centuryFor(term.year_start))}</strong>
                          </div>
                        </div>
                        <p><strong>{period}</strong></p>
                        <p>{field(term, "summary", lang)}</p>
                        <div class="pill-row">
                          <a class="button secondary" href={localizePath(`/mayors/${term.id}`, lang)}>
                            {t.mayors.profile}<span class="arrow" aria-hidden="true">→</span>
                          </a>
                          <a href={term.source_document.url} target="_blank" rel="noreferrer">
                            {t.mayors.openSource}: {sourceTitle(term.source_document.title, lang)}
                          </a>
                        </div>
                      </article>
                    );
                  })}
              </div>
            </section>
          ))}
          <p id="mayor-empty" class="empty" hidden>{t.mayors.empty}</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="mayor-config" set:html={JSON.stringify(config)}></script>
  <script>
    import { matchesSearchText } from "@lib/searchCore";

    const config = JSON.parse(document.getElementById("mayor-config")?.textContent ?? "{}");
    const search = document.querySelector<HTMLInputElement>("#mayor-search")!;
    const century = document.querySelector<HTMLSelectElement>("#mayor-century")!;
    const status = document.querySelector<HTMLSelectElement>("#mayor-status")!;
    const reset = document.querySelector<HTMLButtonElement>("#mayor-reset")!;
    const count = document.querySelector<HTMLElement>("#mayor-count")!;
    const empty = document.querySelector<HTMLElement>("#mayor-empty")!;

    function applyFilters() {
      const query = search.value.trim();
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-mayor-card]"));
      const chips = Array.from(document.querySelectorAll<HTMLElement>("[data-mayor-chip]"));
      let visible = 0;

      const matches = (item: HTMLElement) =>
        matchesSearchText(item.dataset.search ?? "", query) &&
        (century.value === "all" || item.dataset.century === century.value) &&
        (status.value === "all" || item.dataset.status === status.value);

      cards.forEach((card) => {
        const show = matches(card);
        card.hidden = !show;
        if (show) visible += 1;
      });
      chips.forEach((chip) => {
        chip.hidden = !matches(chip);
      });
      document.querySelectorAll<HTMLElement>(".mayor-century").forEach((section) => {
        const visibleCards = section.querySelectorAll<HTMLElement>("[data-mayor-card]:not([hidden])").length;
        section.hidden = visibleCards === 0;
      });

      const filtering = Boolean(query) || century.value !== "all" || status.value !== "all";
      count.textContent = filtering
        ? config.countFiltered.replace("{visible}", String(visible))
        : config.countAll;
      reset.hidden = !filtering;
      empty.hidden = visible > 0;
    }

    function resetFilters() {
      search.value = "";
      century.value = "all";
      status.value = "all";
      applyFilters();
      search.focus();
    }

    search.addEventListener("input", applyFilters);
    century.addEventListener("change", applyFilters);
    status.addEventListener("change", applyFilters);
    reset.addEventListener("click", resetFilters);
  </script>

  <script type="application/json" id="mayor-birth-config" set:html={JSON.stringify(birthConfig)}></script>
  <script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";

    const cfg = JSON.parse(document.getElementById("mayor-birth-config")?.textContent ?? "{}");
    const el = document.getElementById("mayor-birth-map");
    const markers = (cfg.markers ?? []) as Array<{
      lat: number;
      lng: number;
      name: string;
      country: string;
      people: string[];
    }>;

    function esc(value: string): string {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");
    }

    if (el && markers.length) {
      const map = L.map(el, { scrollWheelZoom: false }).setView([42.4, 24.4], 7);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);

      const maxCount = Math.max(1, ...markers.map((m) => m.people.length));
      const points: [number, number][] = [];
      for (const m of markers) {
        const radius = 7 + (m.people.length / maxCount) * 15;
        const names = m.people.map((n) => `<li>${esc(n)}</li>`).join("");
        L.circleMarker([m.lat, m.lng], {
          radius,
          color: "#2c6e9c",
          weight: 2,
          fillColor: "#2c6e9c",
          fillOpacity: 0.45
        })
          .addTo(map)
          .bindPopup(
            `<strong>${esc(m.name)}</strong>${m.country ? ` · ${esc(m.country)}` : ""}` +
              `<br><span class="meta">${esc(cfg.mayorsLabel)} (${m.people.length})</span>` +
              `<ul style="margin:6px 0 0;padding-left:18px">${names}</ul>`
          );
        points.push([m.lat, m.lng]);
      }
      if (points.length > 1) map.fitBounds(points, { padding: [32, 32] });
    }
  </script>
</Layout>
