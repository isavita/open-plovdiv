---
import Layout from "@layouts/Layout.astro";
import SectionNav from "@components/SectionNav.astro";
import { ui, type Lang } from "@i18n/ui";
import { field, localeForLang, localizePath } from "@i18n/utils";
import { cityArchive } from "@lib/data";
import { sourceTitle } from "@lib/format";
import { bustGlyph } from "@lib/motifs";
import { siteSearchUi } from "@lib/siteSearchI18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const searchUi = siteSearchUi[lang];
const locale = localeForLang(lang);

const currentYear = new Date().getFullYear();

const mayorTerms = cityArchive
  .filter((record) => record.kind === "mayor_term")
  .sort((a, b) => a.year_start - b.year_start || (a.year_end ?? currentYear) - (b.year_end ?? currentYear));

function centuryFor(year: number): number {
  return Math.floor((year - 1) / 100) + 1;
}

function normalizeName(name: string): string {
  return name
    .replace(/^(д-р|Д-р|инж\.)\s+/u, "")
    .replace(/^Mayor:\s+/u, "")
    .trim()
    .toLocaleLowerCase(locale);
}

function isActingTerm(term: (typeof mayorTerms)[number], period = field(term, "period", lang)): boolean {
  return (
    field(term, "period", "bg").toLocaleLowerCase("bg-BG").includes("и.д.") ||
    field(term, "period", "en").toLocaleLowerCase("en-GB").includes("acting") ||
    period.toLocaleLowerCase(locale).includes("amtierend")
  );
}

function durationYears(start: number, end?: number): number {
  return Math.max(1, (end ?? currentYear) - start + 1);
}

const uniqueMayors = new Set(mayorTerms.map((term) => normalizeName(field(term, "actor", lang))));
const currentMayor = mayorTerms.find((term) => term.year_end == null);
const firstYear = mayorTerms[0]?.year_start ?? 1878;
const lastYear = currentMayor?.year_start ?? mayorTerms[mayorTerms.length - 1]?.year_end ?? currentYear;
const coveredYears = currentYear - firstYear + 1;

const centuries = [...new Set(mayorTerms.map((term) => centuryFor(term.year_start)))].sort((a, b) => a - b);
const centuryCounts = new Map(
  centuries.map((century) => [
    century,
    mayorTerms.filter((term) => centuryFor(term.year_start) === century).length
  ])
);

const sourceUrls = [...new Map(mayorTerms.map((term) => [term.source_document.url, term.source_document])).values()];

const config = {
  countAll: t.mayors.count(mayorTerms.length),
  countFiltered: "{visible} " + (lang === "bg" ? "от" : lang === "de" ? "von" : lang === "fr" ? "sur" : lang === "it" ? "di" : lang === "tr" ? "/" : lang === "es" ? "de" : lang === "el" ? "από" : lang === "ja" ? "/" : lang === "tl" ? "sa" : lang === "uk" ? "з" : lang === "ru" ? "из" : "of") + ` ${mayorTerms.length} ` + (lang === "bg" ? "мандата" : lang === "de" ? "Mandaten" : lang === "fr" ? "mandats" : lang === "it" ? "mandati" : lang === "tr" ? "görev süresi" : lang === "es" ? "mandatos" : lang === "el" ? "θητείες" : lang === "ja" ? "任期" : lang === "tl" ? "na termino" : lang === "uk" ? "каденцій" : lang === "ru" ? "сроков полномочий" : "terms"),
  empty: t.mayors.empty
};

function initials(name: string): string {
  return name
    .replace(/^(д-р|Д-р|инж\.|Mayor:)\s*/u, "")
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toLocaleUpperCase(locale);
}

// --- relationship graph: connections between mayors ---
const groups = new Map<string, typeof mayorTerms>();
for (const term of mayorTerms) {
  const key = normalizeName(field(term, "actor", lang));
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(term);
}
const multiTerm = [...groups.values()]
  .filter((g) => g.length > 1)
  .sort((a, b) => b.length - a.length || a[0].year_start - b[0].year_start);

// sourced family ties between mayors (kept only when both members exist as terms)
const familyPairs = [
  { a: "Христо Г. Данов", b: "Милош Данов", label_bg: "баща и син", label_en: "father & son", label_de: "Vater und Sohn", label_fr: "père et fils", label_it: "padre e figlio", label_tr: "baba ve oğul", label_es: "padre e hijo", label_el: "πατέρας και γιος", label_ja: "父と息子", label_tl: "ama at anak", label_uk: "батько і син", label_ru: "отец и сын" }
];
const familyTies = familyPairs.filter(
  (pair) =>
    mayorTerms.some((m) => m.actor_bg === pair.a) && mayorTerms.some((m) => m.actor_bg === pair.b)
);

// --- birthplaces of mayors (from Wikidata: place of birth + coordinates) ---
const birthPersons = new Map<string, (typeof mayorTerms)[number]>();
for (const term of mayorTerms) {
  if (term.birth_lat == null || term.birth_lng == null) continue;
  const key = term.more_url ?? term.actor_bg;
  if (!birthPersons.has(key)) birthPersons.set(key, term);
}
const birthTownsMap = new Map<
  string,
  { lat: number; lng: number; name: string; country: string; people: string[] }
>();
for (const p of birthPersons.values()) {
  const key = p.birth_wikidata ?? `${p.birth_lat},${p.birth_lng}`;
  if (!birthTownsMap.has(key)) {
    birthTownsMap.set(key, {
      lat: p.birth_lat!,
      lng: p.birth_lng!,
      name: field(p, "birthplace", lang),
      country: field(p, "birth_country", lang),
      people: []
    });
  }
  birthTownsMap.get(key)!.people.push(field(p, "actor", lang));
}
const birthTowns = [...birthTownsMap.values()].sort((a, b) => b.people.length - a.people.length);
const maxBirthCount = Math.max(1, ...birthTowns.map((tw) => tw.people.length));
const birthCountries = new Set(birthTowns.map((tw) => tw.country).filter(Boolean));
const birthConfig = { markers: birthTowns, mayorsLabel: t.mayors.birthPopupMayors };

// --- period bands for the visual chronology timeline -------------------
// Mayors begin at Liberation (1878); bands follow the city's political eras.
const tr = (
  bg: string,
  en: string,
  de: string,
  fr: string,
  it: string,
  trk: string,
  es: string,
  el: string,
  ja: string,
  tl: string,
  uk: string,
  ru: string
): string => ({ bg, en, de, fr, it, tr: trk, es, el, ja, tl, uk, ru } satisfies Record<Lang, string>)[lang];

const periodBands = [
  {
    key: "liberation",
    start: 1878,
    end: 1944,
    label: tr(
      "След Освобождението",
      "Post-Liberation",
      "Nach der Befreiung",
      "Après la Libération",
      "Post-Liberazione",
      "Kurtuluş sonrası",
      "Posliberación",
      "Μετά την Απελευθέρωση",
      "解放後",
      "Pagkatapos ng Paglaya",
      "Після Визволення",
      "После Освобождения"
    ),
    blurb: tr(
      "Изборни кметове градят модерния град — улици, водопровод, гимназии и паркове — между войни и стопански кризи.",
      "Elected mayors build the modern city — streets, waterworks, schools and parks — between wars and economic crises.",
