---

<Layout lang={lang} path="/places" title={labels.title} description={labels.lead}>
  <section class="section hero hero-compact places-hero" data-section="places">
    <div class="container hero-grid">
      <div>
        <div class="section-plate compact" aria-hidden="true" set:html={sectionMotifs.places} />
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1>{labels.title}</h1>
        <p class="lead">{labels.lead}</p>
      </div>
      <dl class="stats-grid places-stats" data-cat="places" aria-label={labels.title}>
        <div class="stat-card">
          <dt>{labels.places}</dt>
          <dd>{historyKnowledgeIndex.counts.places}</dd>
        </div>
        <div class="stat-card">
          <dt>{labels.coordinates}</dt>
          <dd>{places.filter((place) => place.coordinates).length}</dd>
        </div>
        <div class="stat-card">
          <dt>{labels.images}</dt>
          <dd>{places.filter((place) => place.media.length).length}</dd>
        </div>
        <div class="stat-card">
          <dt>{labels.thenNow}</dt>
          <dd>{publicPairCount}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" id="places-catalog">
    <div class="container">
      <div class="route-picker" id="places-route-picker">
        <label class="route-picker-label meta" for="places-route">{discoverL.routeStrip}</label>
        <div class="route-picker-row">
          <select id="places-route">
            <option value="">{sheetL.noRoute}</option>
            {routePickerGroups.map((group) => (
              <optgroup label={group.label}>
                {group.routes.map((route) => (
                  <option value={route.id}>{route.title} · {route.minutes} {discoverL.minutes}</option>
                ))}
              </optgroup>
            ))}
          </select>
          <a class="text-link route-picker-all" href={localizePath("/routes", lang)}>{sheetL.allRoutes} →</a>
        </div>
        <div class="route-active" id="places-route-active" hidden>
          <span class="route-strip-dot" aria-hidden="true"></span>
          <span class="route-active-text">
            <strong id="places-route-active-title"></strong>
            <span class="meta" id="places-route-active-stats"></span>
          </span>
          <a class="text-link" id="places-route-active-open" href="#">{sheetL.openRoute} →</a>
          <button type="button" class="route-active-clear route-active-toggle" id="places-route-nearby" aria-pressed="false" hidden></button>
          <button type="button" class="route-active-clear" id="places-route-clear">{sheetL.clearRoute} ✕</button>
        </div>
      </div>

      <div class="places-map-head">
        <h2>{mapL.title}</h2>
        <p class="meta" style="max-width:74ch;margin-top:6px">{mapL.lead}</p>
      </div>
      <div class="card map-card" style="padding:0;overflow:hidden;margin-bottom:12px">
        <div id="places-map" class="places-map"></div>
      </div>
      <div id="places-sheet" class="map-sheet" role="dialog" aria-modal="false" hidden>
        <div class="map-sheet-body">
          <p class="eyebrow" id="places-sheet-kicker"></p>
          <h3 id="places-sheet-title"></h3>
          <a class="text-link" id="places-sheet-open" href="#">{labels.open} →</a>
        </div>
        <button type="button" class="map-sheet-close" id="places-sheet-close" aria-label={sheetL.close}>✕</button>
      </div>

      <div class="map-legend" role="group" aria-label={discoverL.legendLabel}>
        {legendItems.map((item) => (
          <button
            type="button"
            class="map-legend-chip"
            data-legend-category={item.category}
            aria-pressed="false"
            title={discoverL.legendLabel}
            style={`--dot:${item.color}`}
          >
            <span class="map-legend-dot" aria-hidden="true"></span>
            {item.label}
            <span class="map-legend-count">{item.count}</span>
          </button>
        ))}
      </div>

      <div class="toolbar places-toolbar">
        <div class="filters">
          <div class="field">
            <label for="places-search">{labels.search}</label>
            <input id="places-search" type="search" placeholder={labels.searchPlaceholder} />
          </div>
          <div class="field">
            <label for="places-era">{labels.era}</label>
            <select id="places-era">
              <option value="all">{labels.allEras}</option>
              {eras.map((era) => <option value={era}>{t.history.eraLabels[era]}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="places-category">{labels.category}</label>
            <select id="places-category">
              <option value="all">{labels.allCategories}</option>
              {categories.map((category) => <option value={category}>{categoryLabel(category)}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="places-evidence">{labels.evidence}</label>
            <select id="places-evidence">
              <option value="all">{labels.allEvidence}</option>
              <option value="then-now">{labels.withThenNow}</option>
              <option value="archive">{labels.withArchive}</option>
            </select>
          </div>
        </div>
      </div>

      <div class="results-bar">
        <p id="places-count" class="meta">{labels.visible}: {initialPlaceCards.length} {labels.of} {placeCards.length} {labels.places}</p>
        <button type="button" id="places-reset" class="link-button" hidden>{labels.reset}</button>
      </div>

      <div class="place-grid" id="places-list">
        {initialPlaceCards.map((card) => {
          return (
            <article
              class={card.className}
              data-place-card
              data-search={card.search}
              data-era={card.era}
              data-category={card.category}
              data-archive={card.archiveCount}
              data-then-now={card.pairCount}
            >
              {card.media && (
                <figure class="place-card-media">
                  <img
                    src={placeholderImage}
                    data-src={card.media.src}
                    data-place-image
                    alt={card.name}
                    width="500"
                    height="313"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                  <figcaption class="place-card-credit">
                    <a href={card.media.licenseUrl} target="_blank" rel="noreferrer">
                      {card.media.credit}
                    </a>
                  </figcaption>
                </figure>
              )}
              <div class="place-card-body">
                <p class="eyebrow">{card.eraLabel} · {card.categoryLabel}</p>
                <h2><a href={card.href}>{card.name}</a></h2>
                <p>{card.summary}</p>
                {card.facts.length > 0 && (
                  <dl class="place-facts">
                    {card.facts.map((fact) => (
                      <>
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                      </>
                    ))}
                  </dl>
                )}
                {card.eventCount + card.archiveCount + card.pairCount > 0 && (
                  <dl class="place-evidence-counts">
                    <div><dt>{labels.events}</dt><dd>{card.eventCount}</dd></div>
                    <div><dt>{labels.archive}</dt><dd>{card.archiveCount}</dd></div>
                    <div><dt>{labels.thenNow}</dt><dd>{card.pairCount}</dd></div>
                  </dl>
                )}
                {card.source && (
                  <a class="src-link" href={card.source.url} target="_blank" rel="noreferrer">
                    {labels.source}: {card.source.title} ↗
                  </a>
                )}
                <a class="text-link" href={card.href}>{labels.open}</a>
              </div>
            </article>
          );
        })}
      </div>
      <p id="places-empty" class="empty" hidden>{labels.noResults}</p>
      <button type="button" id="places-load-more" class="button secondary places-load-more">
        {labels.loadMore}
      </button>
    </div>
  </section>

  <script type="application/json" id="places-config" set:html={JSON.stringify(config)}></script>
  <script>
    const config = JSON.parse(document.getElementById("places-config")?.textContent ?? "{}");
    const placeholderImage = config.placeholderImage ?? "data:image/gif;base64,R0lGODlhAQABAAAAACw=";
    const totalCards = Number(config.total) || 0;
    const search = document.querySelector<HTMLInputElement>("#places-search")!;
    const era = document.querySelector<HTMLSelectElement>("#places-era")!;
    const category = document.querySelector<HTMLSelectElement>("#places-category")!;
    const evidence = document.querySelector<HTMLSelectElement>("#places-evidence")!;
    const count = document.querySelector<HTMLElement>("#places-count")!;
    const reset = document.querySelector<HTMLButtonElement>("#places-reset")!;
    const empty = document.querySelector<HTMLElement>("#places-empty")!;
    const list = document.querySelector<HTMLElement>("#places-list")!;
    const loadMore = document.querySelector<HTMLButtonElement>("#places-load-more")!;
    let renderedCount = document.querySelectorAll<HTMLElement>("[data-place-card]").length;
    let cards = [...document.querySelectorAll<HTMLElement>("[data-place-card]")];
    let allPlaceCards: any[] | null = null;
    let placeCardsPromise: Promise<any[]> | null = null;
    let imageObserver: IntersectionObserver | null = null;

    function escapePlacesHtml(value: unknown): string {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function renderPlaceCard(card: any): string {
      const media = card.media
        ? `<figure class="place-card-media">
            <img
              src="${placeholderImage}"
              data-src="${escapePlacesHtml(card.media.src)}"
              data-place-image
              alt="${escapePlacesHtml(card.name)}"
              width="500"
              height="313"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
            <figcaption class="place-card-credit">
              <a href="${escapePlacesHtml(card.media.licenseUrl)}" target="_blank" rel="noreferrer">${escapePlacesHtml(card.media.credit)}</a>
            </figcaption>
          </figure>`
        : "";
      const facts = Array.isArray(card.facts) && card.facts.length
        ? `<dl class="place-facts">${card.facts
            .map(
              (fact: any) =>
                `<dt>${escapePlacesHtml(fact.label)}</dt><dd>${escapePlacesHtml(fact.value)}</dd>`
            )
            .join("")}</dl>`
        : "";
      const hasEvidence = Number(card.eventCount) + Number(card.archiveCount) + Number(card.pairCount) > 0;
      const evidenceCounts = hasEvidence
        ? `<dl class="place-evidence-counts">
            <div><dt>${escapePlacesHtml(config.labels.events)}</dt><dd>${escapePlacesHtml(card.eventCount)}</dd></div>
            <div><dt>${escapePlacesHtml(config.labels.archive)}</dt><dd>${escapePlacesHtml(card.archiveCount)}</dd></div>
            <div><dt>${escapePlacesHtml(config.labels.thenNow)}</dt><dd>${escapePlacesHtml(card.pairCount)}</dd></div>
          </dl>`
        : "";
      const source = card.source
        ? `<a class="src-link" href="${escapePlacesHtml(card.source.url)}" target="_blank" rel="noreferrer">${escapePlacesHtml(config.labels.source)}: ${escapePlacesHtml(card.source.title)} ↗</a>`
        : "";

      return `<article
          class="${escapePlacesHtml(card.className)}"
          data-place-card
          data-search="${escapePlacesHtml(card.search)}"
          data-era="${escapePlacesHtml(card.era)}"
          data-category="${escapePlacesHtml(card.category)}"
          data-archive="${escapePlacesHtml(card.archiveCount)}"
          data-then-now="${escapePlacesHtml(card.pairCount)}"
        >
          ${media}
          <div class="place-card-body">
            <p class="eyebrow">${escapePlacesHtml(card.eraLabel)} · ${escapePlacesHtml(card.categoryLabel)}</p>
            <h2><a href="${escapePlacesHtml(card.href)}">${escapePlacesHtml(card.name)}</a></h2>
            <p>${escapePlacesHtml(card.summary)}</p>
            ${facts}
            ${evidenceCounts}
            ${source}
            <a class="text-link" href="${escapePlacesHtml(card.href)}">${escapePlacesHtml(config.labels.open)}</a>
          </div>
        </article>`;
    }

    function refreshPlaceCards() {
      cards = [...document.querySelectorAll<HTMLElement>("[data-place-card]")];
      loadMore.hidden = renderedCount >= totalCards || hasActiveFilters();
    }

    // Route focus: the selected route narrows the card list to its stops and
    // curated nearby places; search/era/category/evidence act as subfilters.
    // The stop/nearby sets come from the same config the map consumes, so the
    // two surfaces can never disagree.
    const routeSelect = document.querySelector<HTMLSelectElement>("#places-route");
    const routeStopSets = new Map<string, Set<string>>();
    const routeNearbySets = new Map<string, Set<string>>();
    {
      const overlayConfig = JSON.parse(
        document.getElementById("places-map-config")?.textContent ?? "{}"
      );
      for (const overlay of overlayConfig.routeOverlays ?? []) {
        routeStopSets.set(overlay.id, new Set(overlay.stops.map((stop: { id: string }) => stop.id)));
        routeNearbySets.set(overlay.id, new Set(overlay.nearbyIds));
      }
    }

    /**
     * The one shared filter state: query, era, category, evidence, routeId,
     * and whether the route's capped nearby context is revealed. The nearby
     * flag lives on the route select's dataset so the map and card scripts
     * read the exact same source.
     */
    function readPlacesState() {
      return {
        query: search.value.trim().toLocaleLowerCase(),
        era: era.value,
        category: category.value,
        evidence: evidence.value,
        routeId: routeSelect?.value ?? "",
        nearby: routeSelect?.dataset.nearby === "1"
      };
    }

    function cardPlaceId(card: HTMLElement): string {
      if (!card.dataset.pid) {
        const href = card.querySelector<HTMLAnchorElement>("a[href*='/places/']")?.getAttribute("href") ?? "";
        card.dataset.pid = decodeURIComponent(href.split("/places/")[1] ?? "");
      }
      return card.dataset.pid;
    }

    function applyPlacesFilters() {
      const state = readPlacesState();
      let focus: Set<string> | null = null;
      if (state.routeId) {
        focus = new Set(routeStopSets.get(state.routeId) ?? []);
        if (state.nearby) {
          for (const id of routeNearbySets.get(state.routeId) ?? []) focus.add(id);
        }
      }
      let visible = 0;
      for (const card of cards) {
        const show =
          (!focus || focus.has(cardPlaceId(card))) &&
          (!state.query || (card.dataset.search ?? "").includes(state.query)) &&
          (state.era === "all" || card.dataset.era === state.era) &&
          (state.category === "all" || card.dataset.category === state.category) &&
          (state.evidence === "all" ||
            (state.evidence === "archive" && Number(card.dataset.archive) > 0) ||
            (state.evidence === "then-now" && Number(card.dataset.thenNow) > 0));
        card.hidden = !show;
        if (show) visible += 1;
      }
      const total = hasActiveFilters() ? cards.length : totalCards;
      count.textContent = `${config.labels.visible}: ${visible} ${config.labels.of} ${total} ${config.labels.places}`;
      empty.hidden = visible !== 0;
      reset.hidden = !hasActiveFilters();
      loadMore.hidden = renderedCount >= totalCards || hasActiveFilters();
    }

    function hasActiveFilters() {
      const state = readPlacesState();
      return Boolean(
        state.query ||
        state.era !== "all" ||
        state.category !== "all" ||
        state.evidence !== "all" ||
        state.routeId
      );
    }

    function loadPlaceImage(image: HTMLImageElement) {
      const source = image.dataset.src;
      if (!source) return;
      image.addEventListener("load", () => image.removeAttribute("data-src"), { once: true });
      image.src = source;
    }

    function observePlaceImages(scope: ParentNode = document) {
      const images = [...scope.querySelectorAll<HTMLImageElement>("[data-place-image][data-src]")];
      if (!imageObserver) {
        images.forEach(loadPlaceImage);
        return;
      }
      images.forEach((image) => imageObserver?.observe(image));
    }

    async function loadAllPlaceCards() {
      if (allPlaceCards) return allPlaceCards;
      if (!placeCardsPromise) {
        placeCardsPromise = fetch(config.cardsEndpoint)
          .then((response) => {
            if (!response.ok) throw new Error("Unable to load places");
            return response.json();
          })
          .then((payload) => {
            const localizedCards = payload?.cards?.[config.lang];
            return Array.isArray(localizedCards) ? localizedCards : [];
          });
      }
      allPlaceCards = await placeCardsPromise;
      return allPlaceCards;
    }

    async function renderNextPlaces(batchSize = Number(config.batchSize) || 36) {
      if (renderedCount >= totalCards) return;
      const allCards = await loadAllPlaceCards();
      const nextCards = allCards.slice(renderedCount, renderedCount + batchSize);
      list.insertAdjacentHTML("beforeend", nextCards.map(renderPlaceCard).join(""));
      renderedCount += nextCards.length;
      refreshPlaceCards();
      observePlaceImages(list);
      applyPlacesFilters();
    }

    async function renderAllPlaces() {
      if (renderedCount >= totalCards) return;
      const allCards = await loadAllPlaceCards();
      const nextCards = allCards.slice(renderedCount);
      list.insertAdjacentHTML("beforeend", nextCards.map(renderPlaceCard).join(""));
      renderedCount = allCards.length;
      refreshPlaceCards();
      observePlaceImages(list);
    }

    async function applyFiltersFromControls() {
      if (hasActiveFilters()) await renderAllPlaces();
      applyPlacesFilters();
    }

    // Legend chips mirror the category select: click toggles the filter,
    // and any category change (select or reset) re-syncs the pressed state.
    const legendChips = [...document.querySelectorAll<HTMLButtonElement>("[data-legend-category]")];
    function syncLegend() {
      for (const chip of legendChips) {
        chip.setAttribute("aria-pressed", String(chip.dataset.legendCategory === category.value));
      }
    }

    search.addEventListener("input", () => void applyFiltersFromControls());
    era.addEventListener("change", () => void applyFiltersFromControls());
    category.addEventListener("change", () => {
      syncLegend();
      void applyFiltersFromControls();
    });
    evidence.addEventListener("change", () => void applyFiltersFromControls());
    routeSelect?.addEventListener("change", () => void applyFiltersFromControls());
    document.addEventListener("places:nearby-toggle", () => void applyFiltersFromControls());
    loadMore.addEventListener("click", () => void renderNextPlaces());
    // Reset funnels through the shared route control: one change event lets
    // the card and map listeners react over the same pathway.
    reset.addEventListener("click", () => {
      search.value = "";
      era.value = "all";
      category.value = "all";
      evidence.value = "all";
      syncLegend();
      if (routeSelect) {
        routeSelect.value = "";
        delete routeSelect.dataset.nearby;
        routeSelect.dispatchEvent(new Event("change"));
      } else {
        applyPlacesFilters();
      }
      search.focus();
    });
    for (const chip of legendChips) {
      chip.addEventListener("click", () => {
        const next = chip.dataset.legendCategory ?? "all";
        category.value = category.value === next ? "all" : next;
        category.dispatchEvent(new Event("change"));
      });
    }
    syncLegend();

    function hydratePlaceImages() {
      if (!("IntersectionObserver" in window)) {
        observePlaceImages();
        return;
      }
      imageObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const image = entry.target as HTMLImageElement;
            imageObserver?.unobserve(image);
            loadPlaceImage(image);
          }
        },
        { rootMargin: "120px 0px" }
      );
      observePlaceImages();
    }

    refreshPlaceCards();
    applyPlacesFilters();
    window.setTimeout(hydratePlaceImages, 1200);
  </script>

  <script type="application/json" id="places-map-config" set:html={JSON.stringify(placesMapConfig)}></script>
  <script>
    const mapCfg = JSON.parse(document.getElementById("places-map-config")?.textContent ?? "{}");
    const mapEl = document.getElementById("places-map");
    type PlaceMapItem = {
      lat: number;
      lng: number;
      name: string;
      category: string;
      era: string;
      catLabel: string;
      href: string;
      color: string;
      archive: boolean;
      thenNow: boolean;
      search: string;
    };
    const mEsc = (v: unknown) =>
      String(v).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");

    async function loadPlaceMapItems(): Promise<PlaceMapItem[]> {
      const response = await fetch(mapCfg.mapEndpoint);
      if (!response.ok) throw new Error("Unable to load place map data");
      const payload = await response.json();
      const localizedPlaces = payload?.places?.[mapCfg.lang];
      return Array.isArray(localizedPlaces) ? localizedPlaces : [];
    }

    type PlacesMapApi = { selectRoute: (id: string | null) => void };

    const isNarrowViewport = () => window.matchMedia("(max-width: 760px)").matches;

    async function initPlacesMap(): Promise<PlacesMapApi | null> {
      if (!mapEl) return null;
      const placeItems = await loadPlaceMapItems();
      if (!placeItems.length) return null;
      const leaflet = await import("leaflet");
      const L = leaflet.default;
      const map = L.map(mapEl, { scrollWheelZoom: false }).setView([42.145, 24.75], 13);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);
      const layer = L.layerGroup().addTo(map);
      const routeLayer = L.layerGroup().addTo(map);

      // Mobile bottom sheet: marker taps fill a fixed sheet instead of the
      // (fiddly on touch) popup. Desktop keeps the regular popup.
      const sheet = document.getElementById("places-sheet");
      const sheetKicker = document.getElementById("places-sheet-kicker");
      const sheetTitle = document.getElementById("places-sheet-title");
      const sheetOpen = document.getElementById("places-sheet-open") as HTMLAnchorElement | null;
      document.getElementById("places-sheet-close")?.addEventListener("click", () => {
        if (sheet) sheet.hidden = true;
      });
      function openSheet(it: PlaceMapItem) {
        if (!sheet || !sheetKicker || !sheetTitle || !sheetOpen) return;
        sheetKicker.textContent = it.catLabel;
        sheetTitle.textContent = it.name;
        sheetOpen.href = it.href;
        sheet.hidden = false;
      }

      const markers = placeItems.map((it) => {
        const marker = L.marker([it.lat, it.lng], {
          title: it.name,
          icon: L.divIcon({
            className: "",
            html: `<span class="marker-pin places-map-pin" style="--pin:${mEsc(it.color)}"><span>${mEsc(it.name.slice(0, 1))}</span></span>`,
            iconSize: [30, 30],
            iconAnchor: [15, 30],
            popupAnchor: [0, -28]
          })
        });
        marker.on("click", () => {
          if (isNarrowViewport()) {
            openSheet(it);
            return;
          }
          marker
            .bindPopup(
              `<strong>${mEsc(it.name)}</strong><br><span class="meta">${mEsc(it.catLabel)}</span><br><a href="${mEsc(it.href)}">${mEsc(mapCfg.openLabel)} →</a>`
            )
            .openPopup();
        });
        return { marker, it };
      });

      const fSearch = document.querySelector<HTMLInputElement>("#places-search");
      const fEra = document.querySelector<HTMLSelectElement>("#places-era");
      const fCat = document.querySelector<HTMLSelectElement>("#places-category");
      const fEvi = document.querySelector<HTMLSelectElement>("#places-evidence");

      // Grid clustering: below street zoom the filtered markers are grouped
      // per ~56px screen cell; a numbered bubble zooms into its group.
      let currentEntries = markers;
      const CLUSTER_MAX_ZOOM = 16;
      function renderMarkers() {
        layer.clearLayers();
        const zoom = map.getZoom();
        if (zoom >= CLUSTER_MAX_ZOOM) {
          for (const { marker } of currentEntries) marker.addTo(layer);
          return;
        }
        const cell = 56;
        const groups = new Map<string, typeof markers>();
        for (const entry of currentEntries) {
          const point = map.project([entry.it.lat, entry.it.lng], zoom);
          const key = `${Math.floor(point.x / cell)}:${Math.floor(point.y / cell)}`;
          const group = groups.get(key) ?? [];
          if (group.length === 0) groups.set(key, group);
          group.push(entry);
        }
        for (const group of groups.values()) {
          if (group.length === 1) {
            group[0].marker.addTo(layer);
            continue;
          }
          const lat = group.reduce((sum, entry) => sum + entry.it.lat, 0) / group.length;
          const lng = group.reduce((sum, entry) => sum + entry.it.lng, 0) / group.length;
          const bounds = group.map((entry) => [entry.it.lat, entry.it.lng] as [number, number]);
          const cluster = L.marker([lat, lng], {
            icon: L.divIcon({
              className: "",
              html: `<span class="map-cluster">${group.length}</span>`,
              iconSize: [34, 34],
              iconAnchor: [17, 17]
            })
          });
          cluster.on("click", () => map.fitBounds(bounds, { padding: [46, 46], maxZoom: 17 }));
          cluster.addTo(layer);
        }
      }
      map.on("zoomend", renderMarkers);

      const fRoute = document.querySelector<HTMLSelectElement>("#places-route");
      const placeIdOf = (it: PlaceMapItem) => decodeURIComponent((it.href.split("/places/")[1] ?? ""));
      const placeItemById = new Map(placeItems.map((it) => [placeIdOf(it), it]));

      // Route focus overlays: ONE route active at a time — an accent walking
      // line plus numbered markers for the actual stops (never for geometry
      // samples). Selecting a route narrows the map to stops + curated nearby
      // places; the card list follows through the shared #places-route control.
      type OverlayStop = { id: string; index: number; name: string; href: string; lat: number; lng: number };
      type Overlay = {
        id: string;
        accent: string;
        title: string;
        href: string;
        km: string | null;
        minutes: number;
        line: [number, number][];
        stops: OverlayStop[];
        nearbyIds: string[];
        detourCount: number;
      };
      type OverlayEntry = {
        group: ReturnType<typeof L.layerGroup>;
        data: Overlay;
        stopMarkers: Array<{ marker: ReturnType<typeof L.marker>; id: string }>;
      };
      const overlays = new Map<string, OverlayEntry>();
      for (const data of (mapCfg.routeOverlays ?? []) as Overlay[]) {
        const group = L.layerGroup();
        const stopMarkers: OverlayEntry["stopMarkers"] = [];
        L.polyline(data.line, {
          color: data.accent,
          weight: 4,
          opacity: 0.9
        }).addTo(group);
        for (const stop of data.stops) {
          const marker = L.marker([stop.lat, stop.lng], {
            title: stop.name,
            icon: L.divIcon({
              className: "",
              html: `<span class="route-map-stop" style="--route-accent:${mEsc(data.accent)}">${stop.index}</span>`,
              iconSize: [26, 26],
              iconAnchor: [13, 13]
            })
          });
          marker.on("click", () => {
            if (isNarrowViewport()) {
              openSheet({ catLabel: `${stop.index}. ${data.title}`, name: stop.name, href: stop.href } as PlaceMapItem);
              return;
            }
            marker
              .bindPopup(
                `<strong>${mEsc(stop.index)}. ${mEsc(stop.name)}</strong><br><a href="${mEsc(stop.href)}">${mEsc(mapCfg.openLabel)} →</a>`
              )
              .openPopup();
          });
          marker.addTo(group);
          stopMarkers.push({ marker, id: stop.id });
        }
        overlays.set(data.id, { group, data, stopMarkers });
      }

      let activeRouteId: string | null = null;
      const activeChip = document.getElementById("places-route-active");
      const activeTitle = document.getElementById("places-route-active-title");
      const activeStats = document.getElementById("places-route-active-stats");
      const activeOpen = document.getElementById("places-route-active-open") as HTMLAnchorElement | null;

      const nearbyToggle = document.getElementById("places-route-nearby") as HTMLButtonElement | null;

      function syncNearbyToggle(overlay: Overlay | null) {
        if (!nearbyToggle) return;
        if (!overlay || overlay.nearbyIds.length === 0) {
          nearbyToggle.hidden = true;
          return;
        }
        const on = fRoute?.dataset.nearby === "1";
        const contextWord = overlay.detourCount > 0 ? mapCfg.words.nearDetours : mapCfg.words.near;
        nearbyToggle.hidden = false;
        nearbyToggle.textContent = on
          ? `${mapCfg.words.hideNear} ✕`
          : `+${overlay.nearbyIds.length} ${contextWord}`;
        nearbyToggle.setAttribute("aria-pressed", String(on));
      }

      function syncRouteUi(overlay: Overlay | null) {
        if (fRoute) fRoute.value = overlay?.id ?? "";
        syncNearbyToggle(overlay);
        if (!activeChip) return;
        if (!overlay) {
          activeChip.hidden = true;
          return;
        }
        const stats = [
          overlay.km ? `${overlay.km} km` : null,
          `~${overlay.minutes} ${mapCfg.words.minutes}`,
          `${overlay.stops.length} ${mapCfg.words.stops}`
        ]
          .filter(Boolean)
          .join(" · ");
        activeChip.hidden = false;
        activeChip.style.setProperty("--route-accent", overlay.accent);
        if (activeTitle) activeTitle.textContent = overlay.title;
        if (activeStats) activeStats.textContent = stats;
        if (activeOpen) activeOpen.href = overlay.href;
      }

      nearbyToggle?.addEventListener("click", () => {
        if (!fRoute || !activeRouteId) return;
        const on = fRoute.dataset.nearby === "1";
        if (on) delete fRoute.dataset.nearby;
        else fRoute.dataset.nearby = "1";
        syncNearbyToggle(overlays.get(activeRouteId)?.data ?? null);
        applyMap(false);
        document.dispatchEvent(new Event("places:nearby-toggle"));
      });

      function selectRoute(id: string | null) {
        const previous = activeRouteId ? overlays.get(activeRouteId) : null;
        if (previous) routeLayer.removeLayer(previous.group);
        const next = id ? overlays.get(id) : null;
        activeRouteId = next ? id : null;
        if (fRoute) delete fRoute.dataset.nearby;
        if (next) {
          next.group.addTo(routeLayer);
          mapEl?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          const sheetEl = document.getElementById("places-sheet");
          if (sheetEl) sheetEl.hidden = true;
        }
        syncRouteUi(next ? next.data : null);
        applyMap(true);
      }

      // Clearing routes through the select keeps the cards script in sync:
      // both scripts listen to the same #places-route change event.
      document.getElementById("places-route-clear")?.addEventListener("click", () => {
        if (!fRoute) {
          selectRoute(null);
          return;
        }
        fRoute.value = "";
        fRoute.dispatchEvent(new Event("change"));
      });

      function applyMap(refit: boolean) {
        const q = (fSearch?.value ?? "").trim().toLowerCase();
        const era = fEra?.value ?? "all";
        const cat = fCat?.value ?? "all";
        const evi = fEvi?.value ?? "all";
        const overlay = activeRouteId ? overlays.get(activeRouteId) : null;
        // In route focus mode the numbered stop markers stand for the stops
        // themselves; regular pins appear only for the capped nearby context,
        // and only once the chip toggle reveals it.
        const nearbyOn = fRoute?.dataset.nearby === "1";
        const focusNearby = overlay ? new Set(nearbyOn ? overlay.data.nearbyIds : []) : null;
        const matchesSubfilters = (it: PlaceMapItem) =>
          (!q || it.search.includes(q)) &&
          (era === "all" || it.era === era) &&
          (cat === "all" || it.category === cat) &&
          (evi === "all" || (evi === "archive" ? it.archive : evi === "then-now" ? it.thenNow : true));
        const visible: [number, number][] = [];
        currentEntries = markers.filter(({ it }) => {
          const ok = (!focusNearby || focusNearby.has(placeIdOf(it))) && matchesSubfilters(it);
          if (ok) visible.push([it.lat, it.lng]);
          return ok;
        });
        // The same predicate the card list uses also controls the numbered stop
        // markers. The route line stays visible, but filtered-out stops leave
        // the overlay so the map and list agree.
        if (overlay) {
          for (const { marker, id } of overlay.stopMarkers) {
            const item = placeItemById.get(id);
            const match = !item || matchesSubfilters(item);
            if (match) {
              if (!overlay.group.hasLayer(marker)) marker.addTo(overlay.group);
            } else {
              overlay.group.removeLayer(marker);
            }
          }
        }
        if (overlay) {
          if (refit) map.fitBounds(overlay.data.line, { padding: [36, 36], maxZoom: 16 });
        } else if (refit && visible.length) {
          map.fitBounds(visible, { padding: [30, 30], maxZoom: 15 });
        }
        renderMarkers();
      }

      applyMap(true);
      fSearch?.addEventListener("input", () => applyMap(false));
      [fEra, fCat, fEvi].forEach((el) => el?.addEventListener("change", () => applyMap(true)));
      fRoute?.addEventListener("change", () => selectRoute(fRoute.value || null));

      return { selectRoute };
    }

    // The map initialises lazily (scroll into view), but a route toggle click
    // forces initialisation and applies the toggle once ready.
    let mapPromise: Promise<PlacesMapApi | null> | null = null;
    function ensurePlacesMap(): Promise<PlacesMapApi | null> {
      if (!mapPromise) mapPromise = initPlacesMap().catch(() => null);
      return mapPromise;
    }

    // The route picker initialises the lazy map on first use; once the map is
    // live its own #places-route listener takes over (registered inside
    // initPlacesMap), so this bootstrap only forwards the very first choice.
    const routeSelectEl = document.querySelector<HTMLSelectElement>("#places-route");
    let mapReady = false;
    routeSelectEl?.addEventListener("change", function bootstrapRoute() {
      if (mapReady) {
        routeSelectEl.removeEventListener("change", bootstrapRoute);
        return;
      }
      void ensurePlacesMap().then((api) => {
        if (api && !mapReady) {
          mapReady = true;
          api.selectRoute(routeSelectEl.value || null);
        }
      });
    });

    function schedulePlacesMap() {
      if (!mapEl) return;
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              void ensurePlacesMap();
            }
          },
          { rootMargin: "60px 0px" }
        );
        observer.observe(mapEl);
        return;
      }
      window.setTimeout(() => void ensurePlacesMap(), 1600);
    }

    schedulePlacesMap();
  </script>
</Layout>
