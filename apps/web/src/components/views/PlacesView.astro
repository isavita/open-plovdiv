// Route focus data for the all-places map: the walking line (downsampled
// committed geometry), the NUMBERED stops (only these become markers), and
// the curated nearby places (≤300 m of a stop) that stay visible as context
// when a route is selected. One route can be active at a time.
const placeById = new Map(places.map((place) => [place.id, place]));
function overlayLine(route: (typeof walkingRoutes)[number]): Array<[number, number]> {
  const geometry = routeGeometry(route.id);
  if (geometry) {
    const coords = geometry.geometry.coordinates;
    const maxLinePoints = 80;
    const stride = Math.max(1, Math.ceil(coords.length / maxLinePoints));
    return coords
      .filter((_, index) => index % stride === 0 || index === coords.length - 1)
      .map(([lng, lat]) => [lat, lng] as [number, number]);
  }
  return route.stops
    .map((stop) => placeById.get(stop.place_id)?.coordinates)
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map((c) => [c.lat, c.lng] as [number, number]);
}
const routeOverlays = walkingRoutes
  .map((route) => {
    const geometry = routeGeometry(route.id);
    const stops = route.stops
      .map((stop, index) => {
        const place = placeById.get(stop.place_id);
        return place?.coordinates
          ? {
              id: place.id,
              index: index + 1,
              name: localized(place, "name"),
              href: localizePath(`/places/${place.id}`, lang),
              lat: place.coordinates.lat,
              lng: place.coordinates.lng
            }
          : null;
      })
      .filter((stop): stop is NonNullable<typeof stop> => Boolean(stop));
    const stopIds = new Set(stops.map((stop) => stop.id));
    // Nearby context is deliberately small: the route's curated detour places
    // first, then the closest documented places, capped so central routes do
    // not flood the focused map (the toggle in the active chip reveals them).
    const NEARBY_CAP = 10;
    const detourIds = (route.detours ?? [])
      .map((detour) => detour.place_id)
      .filter((id) => placeById.get(id)?.coordinates && !stopIds.has(id));
    const candidates = places
      .filter((place) => place.coordinates && !stopIds.has(place.id) && !detourIds.includes(place.id))
      .map((place) => ({
        id: place.id,
        meters: Math.min(...stops.map((stop) => distanceMeters(place.coordinates!, stop)))
      }))
      .filter((entry) => entry.meters <= 300)
      .sort((a, b) => a.meters - b.meters)
      .slice(0, Math.max(0, NEARBY_CAP - detourIds.length))
      .map((entry) => entry.id);
    const nearbyIds = [...detourIds, ...candidates];
    const detourCount = detourIds.length;
    return {
      id: route.id,
      accent: route.accent,
      title: localized(route, "short_title"),
      href: localizePath(`/routes/${route.id}`, lang),
      km: geometry ? formatKm(geometry.distance_m, locale) : null,
      minutes: route.duration_minutes,
      line: overlayLine(route),
      stops,
      nearbyIds,
      detourCount
    };
  })
  .filter((overlay) => overlay.stops.length >= 2);

const routePickerGroups = routeCategoryOrder
  .map((categoryKey) => ({
    label: routeCategoryLabels(lang)[categoryKey],
    routes: walkingRoutes
      .filter((route) => route.category === categoryKey)
      .map((route) => ({
        id: route.id,
        title: localized(route, "short_title"),
        minutes: route.duration_minutes
      }))
  }))
  .filter((group) => group.routes.length > 0);

const sheetL = {
