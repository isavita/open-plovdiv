      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .nb-side-list .meta {
      margin: 3px 0 0;
    }

    .nb-archive-list {
      margin: 0;
    }

    .nb-why h2 {
      margin: 0 0 10px;
    }

    .nb-why p {
      margin: 0;
      max-width: 72ch;
      font-size: 1.06rem;
      line-height: 1.62;
    }

    .nb-visit {
      border: 1px solid var(--line);
      border-left: 4px solid var(--nb-accent);
      border-radius: var(--r-md);
      background: var(--surface);
      box-shadow: var(--shadow-card);
      padding: 17px;
