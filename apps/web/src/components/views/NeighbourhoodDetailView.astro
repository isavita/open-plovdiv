      grid-template-columns: minmax(0, 1fr);
      gap: 5px;
      position: relative;
      padding: 0 0 24px 24px;
    }

    .nb-timeline li::before {
      content: "";
      position: absolute;
      left: 5px;
      top: 7px;
      bottom: -2px;
      width: 2px;
      background: color-mix(in srgb, var(--nb-accent) 34%, var(--line));
