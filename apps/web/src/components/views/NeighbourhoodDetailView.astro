    .nb-visit h2 {
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 780;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      margin: 0 0 12px;
    }

    .nb-visit dl {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      gap: 12px 18px;
      margin: 0;
    }

    .nb-visit dt {
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .nb-visit dd {
      margin: 3px 0 0;
      color: var(--ink);
    }

    .nb-respect {
      margin: 14px 0 0;
    }

    .nb-alt-names {
      margin: 10px 0 0;
      border-top: 1px solid var(--line);
      padding-top: 10px;
    }

    .nb-fabric-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .nb-fabric-card {
      border: 1px solid var(--line);
      border-left: 4px solid var(--nb-accent);
      border-radius: var(--r);
      background: var(--surface);
      box-shadow: var(--shadow-card);
      padding: 15px 16px;
