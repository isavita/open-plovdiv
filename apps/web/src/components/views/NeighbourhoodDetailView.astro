    .nb-route-list strong {
      display: block;
      margin-bottom: 3px;
    }

    .nb-route-list .meta {
      display: block;
    }

    .nb-side {
      border: 1px solid var(--line);
      border-top: 5px solid var(--nb-accent);
      border-radius: var(--r-md);
      background: var(--surface);
