    .nb-timeline-year::after {
      content: "";
      position: absolute;
      left: -19px;
      top: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--nb-accent);
      border: 2px solid var(--surface);
      box-shadow: 0 0 0 1px var(--line-strong);
    }

    .nb-timeline-body h3 {
      margin: 0 0 6px;
      font-size: clamp(1.18rem, 4.6vw, 1.42rem);
      line-height: 1.16;
