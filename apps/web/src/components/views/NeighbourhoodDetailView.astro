---
import Layout from "@layouts/Layout.astro";
import { field, localeForLang, localizePath, type Lang } from "@i18n/utils";
import { commonsImageUrl, isCommonsUploadImageUrl } from "@lib/commons";
import { districtLabel, sourceTitle } from "@lib/format";
import { publicThenNowPairs } from "@lib/thenNow";
import {
  historicalArchiveItems,
  historyKnowledgePlaces,
  projects,
  storyLongreads,
  thenNowPairs
} from "@lib/data";
import {
  neighbourhoodEraColors,
  neighbourhoodLeadPhoto,
  neighbourhoodRoutes,
  type NeighbourhoodHistory
} from "@lib/neighbourhoods";
import {
  neighbourhoodAreaLabels,
  neighbourhoodEraLabels,
  neighbourhoodFabricKindLabels,
  neighbourhoodLabels
} from "@lib/neighbourhoodLabels";
import { formatKm, routeGeometry } from "@lib/routes";

type Props = {
  lang: Lang;
  neighbourhood: NeighbourhoodHistory;
};

const { lang, neighbourhood } = Astro.props;
const t = neighbourhoodLabels(lang);
const eraLabels = neighbourhoodEraLabels(lang);
const areaLabels = neighbourhoodAreaLabels(lang);
const locale = localeForLang(lang);

const localized = (record: Record<string, unknown> | null | undefined, base: string): string =>
  field(record, base, lang);
const localizedAny = (record: unknown, base: string): string =>
  localized(record as Record<string, unknown>, base);

const placesById = new Map(historyKnowledgePlaces.map((place) => [place.id, place]));
const storiesById = new Map(storyLongreads.map((story) => [story.id, story]));

const fabricKindLabels = neighbourhoodFabricKindLabels(lang);
const name = localizedAny(neighbourhood, "name");
const tagline = localizedAny(neighbourhood, "tagline");
const summary = localizedAny(neighbourhood, "summary");
const nameOrigin = localizedAny(neighbourhood, "name_origin");
const gettingThere = localizedAny(neighbourhood, "getting_there");
const coverageNote = localized(neighbourhood as unknown as Record<string, unknown>, "coverage_note");
const why = localizedAny(neighbourhood, "why");
const altNames = (neighbourhood.alt_names ?? []).map((entry) => ({
  name: localizedAny(entry, "name"),
  note: localized(entry as unknown as Record<string, unknown>, "note")
}));
const fabric = (neighbourhood.fabric ?? []).map((entry) => {
  const place = entry.place_id ? placesById.get(entry.place_id) : null;
  return {
    kind: entry.kind,
    name: localizedAny(entry, "name"),
    note: localizedAny(entry, "note"),
    href: place ? localizePath(`/places/${place.id}`, lang) : null
  };
});
const visit = neighbourhood.visit;
const visitRows = [
  { label: "visitSee", value: localizedAny(visit, "see") },
  { label: "visitTime", value: localizedAny(visit, "time") },
  { label: "visitBest", value: localizedAny(visit, "best") },
  { label: "visitFood", value: localizedAny(visit, "food") }
] as const;
const respect = localized(visit as unknown as Record<string, unknown>, "respect");

const accent = neighbourhoodEraColors[neighbourhood.era_tags[0]];

const keyPlaces = neighbourhood.place_ids
  .map((id) => placesById.get(id))
  .filter((place): place is NonNullable<typeof place> => Boolean(place))
  .map((place) => ({
    place,
    name: localizedAny(place, "name"),
    summary: localizedAny(place, "summary"),
    href: localizePath(`/places/${place.id}`, lang),
    media: place.media[0] ?? null
  }));

const stories = neighbourhood.story_ids
  .map((id) => storiesById.get(id))
  .filter((story): story is NonNullable<typeof story> => Boolean(story));

const placeIdSet = new Set(neighbourhood.place_ids);
const archiveItems = historicalArchiveItems.filter((item) => placeIdSet.has(item.place_id));
const pairs = publicThenNowPairs(thenNowPairs.filter((pair) => placeIdSet.has(pair.place_id)));

const districtProjects = projects
  .filter((project) => project.district === neighbourhood.district_bg)
  .slice(0, 4);

const routes = neighbourhoodRoutes(neighbourhood).map((route) => {
  const geometry = routeGeometry(route.id);
  return {
    route,
    href: localizePath(`/routes/${route.id}`, lang),
    title: localizedAny(route, "title"),
    km: geometry ? formatKm(geometry.distance_m, locale) : null
  };
});

const timeline = neighbourhood.timeline.map((entry) => ({
  display: localizedAny(entry, "display"),
  title: localizedAny(entry, "title"),
  body: localizedAny(entry, "body")
}));
const earliest = timeline[0]?.display ?? null;

const thenNowMedia = pairs.slice(0, 2).map((pair) => ({
  title: localizedAny(pair, "title"),
  caption: localizedAny(pair, "caption"),
  href: `${localizePath(`/places/${pair.place_id}`, lang)}#place-then-now`,
  thenUrl: pair.then_media.url,
  nowUrl: pair.now_media.url
}));

const heroMedia = neighbourhoodLeadPhoto(neighbourhood, placesById);

// Map: approximate quarter anchor + key place pins.
const mapConfig = {
  accent,
  center: neighbourhood.center,
  name,
  places: keyPlaces
    .map((entry) =>
      entry.place.coordinates
        ? {
            name: entry.name,
            href: entry.href,
            lat: entry.place.coordinates.lat,
            lng: entry.place.coordinates.lng
          }
        : null
    )
    .filter(Boolean)
};

const structuredData = {
  "@type": "Place",
  name,
  description: summary,
  geo: {
    "@type": "GeoCoordinates",
    latitude: neighbourhood.center.lat,
    longitude: neighbourhood.center.lng
  },
  containedInPlace: {
    "@type": "City",
    name: "Plovdiv"
  }
};
---

<Layout
  lang={lang}
  path={`/neighbourhoods/${neighbourhood.id}`}
  title={name}
  description={summary}
  image={heroMedia ? commonsImageUrl(heroMedia.url, 1200) : undefined}
  imageAlt={name}
  structuredData={structuredData}
>
  <article class="nb-page" style={`--nb-accent:${accent}`} data-section="neighbourhoods">
    <header class="section nb-hero">
      <div class="container">
        <p class="nb-breadcrumb">
          <a href={localizePath("/neighbourhoods", lang)}>← {t.backToIndex}</a>
        </p>
        <div class="nb-hero-grid">
          <div class="nb-hero-main">
            <p class="eyebrow">
              {neighbourhood.era_tags.map((era, index) => (
                <>
                  {index > 0 && " · "}
                  {eraLabels[era]}
                </>
              ))}
            </p>
            <h1>{name}</h1>
            <p class="nb-tagline">{tagline}</p>
            <p class="lead nb-lead">{summary}</p>
          </div>
          <div class="nb-hero-side">
            {heroMedia && (
              <figure class="nb-hero-media">
                <a
                  class="nb-hero-media-link"
                  href={heroMedia.page_url}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${name} — ${t.sourcesTitle}`}
                >
                  <img
                    src={commonsImageUrl(heroMedia.url, 960)}
                    alt={heroMedia.scope === "district_context" ? `${t.districtContextPhoto}: ${name}` : name}
                    width="960"
                    height="540"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    crossorigin={isCommonsUploadImageUrl(heroMedia.url) ? "anonymous" : undefined}
                    referrerpolicy="no-referrer"
                  />
                  {heroMedia.scope === "district_context" && (
                    <span class="nb-hero-media-context">{t.districtContextPhoto}</span>
                  )}
                </a>
                <figcaption>
                  <a href={heroMedia.page_url} target="_blank" rel="noreferrer">{heroMedia.credit}</a>
                  <span aria-hidden="true">·</span>
                  <a href={heroMedia.license_url} target="_blank" rel="noreferrer">{heroMedia.license}</a>
                </figcaption>
              </figure>
            )}
            <aside class="nb-glance" aria-label={t.atGlance}>
              <h2>{t.atGlance}</h2>
              <dl>
                <div>
                  <dt>{t.areaLabel}</dt>
                  <dd>{areaLabels[neighbourhood.area]}</dd>
                </div>
                <div>
                  <dt>{t.districtLabel}</dt>
                  <dd>{districtLabel(neighbourhood.district_bg, lang)}</dd>
                </div>
                {earliest && (
                  <div>
                    <dt>{t.firstRecord}</dt>
                    <dd>{earliest}</dd>
                  </div>
                )}
                {keyPlaces.length === 0 && (
                  <div class="nb-glance-context">
                    <dt>{t.keyPlaces}</dt>
                    <dd class="nb-glance-context-badge">{t.contextBadge}</dd>
                  </div>
                )}
              </dl>
              <p class="meta nb-glance-note">{t.approxNote}</p>
            </aside>
          </div>
        </div>
      </div>
    </header>

    <section class="section nb-body-section">
      <div class="container nb-body">
        <div class="nb-main">
          {coverageNote && (
            <p class="notice nb-coverage">
              <span class="notice-icon" aria-hidden="true">!</span>
              <span><strong>{t.coverageTitle}:</strong> {coverageNote}</span>
            </p>
          )}

          <section class="nb-why">
            <h2>{t.whyTitle}</h2>
            <p>{why}</p>
          </section>

          <section class="nb-visit" aria-label={t.visitTitle}>
            <h2>{t.visitTitle}</h2>
            <dl>
              {visitRows.map((row) => (
                <div>
                  <dt>{t[row.label]}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
            {respect && (
              <p class="notice nb-respect">
                <span class="notice-icon" aria-hidden="true">!</span>
                <span><strong>{t.respectTitle}:</strong> {respect}</span>
              </p>
            )}
          </section>

          <div class="nb-callouts">
            <div class="nb-callout">
              <h3>{t.nameOriginTitle}</h3>
              <p>{nameOrigin}</p>
              {altNames.length > 0 && (
                <p class="meta nb-alt-names">
                  <strong>{t.altNamesTitle}:</strong>{" "}
                  {altNames.map((entry, index) => (
                    <span>
                      {index > 0 && "; "}
                      {entry.name}
                      {entry.note && ` (${entry.note})`}
                    </span>
                  ))}
                </p>
              )}
            </div>
            <div class="nb-callout">
              <h3>{t.gettingThereTitle}</h3>
              <p>{gettingThere}</p>
            </div>
          </div>

          {mapConfig.places.length > 0 || neighbourhood.center ? (
            <figure class="card map-card nb-map-card">
              <div class="nb-detail-map" id="nb-detail-map" aria-label={t.mapTitle}></div>
              <figcaption class="meta">{t.approxNote}</figcaption>
            </figure>
          ) : null}

          <section class="nb-timeline-section" aria-label={t.timelineTitle}>
            <h2>{t.timelineTitle}</h2>
            <ol class="nb-timeline">
              {timeline.map((entry) => (
                <li>
                  <p class="nb-timeline-year">{entry.display}</p>
                  <div class="nb-timeline-body">
                    <h3>{entry.title}</h3>
                    <p>{entry.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          {fabric.length > 0 && (
            <section aria-label={t.fabricTitle}>
              <h2>{t.fabricTitle}</h2>
              <ul class="nb-fabric-grid">
                {fabric.map((entry) => (
                  <li class="nb-fabric-card">
                    <p class="nb-fabric-kind">{fabricKindLabels[entry.kind]}</p>
                    <h3>{entry.href ? <a href={entry.href}>{entry.name}</a> : entry.name}</h3>
                    <p class="meta">{entry.note}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {keyPlaces.length > 0 && (
            <section aria-label={t.keyPlaces}>
              <h2>{t.keyPlaces}</h2>
              <ul class="nb-place-grid">
                {keyPlaces.map((entry) => (
                  <li class="nb-place-card">
                    {entry.media && (
                      <a class="nb-place-media" href={entry.href} aria-label={entry.name} tabindex="-1">
                        <img
                          src={commonsImageUrl(entry.media.url, 360)}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          crossorigin={isCommonsUploadImageUrl(entry.media.url) ? "anonymous" : undefined}
                          referrerpolicy="no-referrer"
                        />
                      </a>
                    )}
                    <div class="nb-place-body">
                      <h3><a href={entry.href}>{entry.name}</a></h3>
                      <p class="meta">{entry.summary.length > 130 ? `${entry.summary.slice(0, 130).trim()}...` : entry.summary}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {thenNowMedia.length > 0 && (
            <section aria-label={t.tnTitle}>
              <h2>{t.tnTitle}</h2>
              <ul class="nb-tn-list">
                {thenNowMedia.map((pair) => (
                  <li class="nb-tn-pair">
                    <a href={pair.href} aria-label={pair.title}>
                      <span class="nb-tn-frames">
                        <span class="nb-tn-frame">
                          <img src={commonsImageUrl(pair.thenUrl, 420)} alt="" loading="lazy" decoding="async" crossorigin={isCommonsUploadImageUrl(pair.thenUrl) ? "anonymous" : undefined} referrerpolicy="no-referrer" />
                          <span class="nb-tn-tag">{t.tnThen}</span>
                        </span>
                        <span class="nb-tn-frame">
                          <img src={commonsImageUrl(pair.nowUrl, 420)} alt="" loading="lazy" decoding="async" crossorigin={isCommonsUploadImageUrl(pair.nowUrl) ? "anonymous" : undefined} referrerpolicy="no-referrer" />
                          <span class="nb-tn-tag">{t.tnNow}</span>
                        </span>
                      </span>
                      <span class="nb-tn-title">{pair.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {routes.length > 0 && (
            <section aria-label={t.routesTitle}>
              <h2>{t.routesTitle}</h2>
              <ul class="nb-route-list">
                {routes.map((entry) => (
                  <li>
                    <a href={entry.href}>
                      <strong>{entry.title}</strong>
                      <span class="meta">
                        {entry.km && `${entry.km} ${t.km} · `}~{entry.route.duration_minutes} {t.minutes} · {entry.route.stops.length} {t.stops}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <aside class="nb-side">
          {stories.length > 0 && (
            <section>
              <h3>{t.linkedStories}</h3>
              <ul class="nb-side-list">
                {stories.map((story) => (
                  <li>
                    <a href={localizePath(`/stories/${story.id}`, lang)}>{localizedAny(story, "title")}</a>
                    <p class="meta">{localizedAny(story, "dek")}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {(archiveItems.length > 0 || pairs.length > 0) && (
            <section>
              <h3>{t.archiveTitle}</h3>
              <ul class="source-list compact nb-archive-list">
                {pairs.slice(0, 4).map((pair) => (
                  <li>
                    <a href={`${localizePath(`/places/${pair.place_id}`, lang)}#place-then-now`}>
                      {localizedAny(pair, "title")}
                    </a>
                  </li>
                ))}
                {archiveItems.slice(0, 4).map((item) => (
                  <li>
                    <a href={`${localizePath(`/places/${item.place_id}`, lang)}#place-archive`}>
                      {localizedAny(item, "title")}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {districtProjects.length > 0 && (
            <section>
              <h3>{t.civicTitle}</h3>
              <ul class="nb-side-list">
                {districtProjects.map((project) => (
                  <li>
                    <a href={localizePath(`/projects/${project.id}`, lang)}>{localizedAny(project, "title")}</a>
                  </li>
                ))}
              </ul>
              <a class="text-link" href={localizePath("/projects", lang)}>{t.allProjects} →</a>
            </section>
          )}

          <section>
            <h3>{t.sourcesTitle}</h3>
            <ul class="source-list compact">
              {neighbourhood.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">
                    {sourceTitle(source.title, lang)}
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <p class="meta nb-updated">{t.updatedWord}: {neighbourhood.updated_at}</p>
        </aside>
      </div>
    </section>
  </article>

  <script type="application/json" id="nb-detail-config" set:html={JSON.stringify(mapConfig)}></script>
  <script>
    import "leaflet/dist/leaflet.css";

    type NbPlacePin = { name: string; href: string; lat: number; lng: number };
    type NbDetailConfig = {
      accent: string;
      name: string;
      center: { lat: number; lng: number };
      places: NbPlacePin[];
    };

    const mapEl = document.getElementById("nb-detail-map");
    const config: NbDetailConfig = JSON.parse(
      document.getElementById("nb-detail-config")?.textContent ?? "{}"
    );
    const esc = (v: unknown) =>
      String(v).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");

    async function initNbDetailMap(): Promise<void> {
      if (!mapEl || !config.center) return;
      const leaflet = await import("leaflet");
      const L = leaflet.default;
      const map = L.map(mapEl, { scrollWheelZoom: false });
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);

      // Approximate quarter anchor: dashed circle, deliberately not a boundary.
      L.circle([config.center.lat, config.center.lng], {
        radius: 420,
        color: config.accent,
        weight: 2,
        dashArray: "6 7",
        fillColor: config.accent,
        fillOpacity: 0.07
      }).addTo(map);
      L.marker([config.center.lat, config.center.lng], {
        title: config.name,
        icon: L.divIcon({
          className: "",
          html: `<span class="nb-map-marker" style="--nb-era:${esc(config.accent)}"></span>`,
          iconSize: [18, 18],
          iconAnchor: [9, 9]
        })
      }).addTo(map);

      const points: Array<[number, number]> = [[config.center.lat, config.center.lng]];
      for (const pin of config.places) {
        points.push([pin.lat, pin.lng]);
        const marker = L.marker([pin.lat, pin.lng], {
          title: pin.name,
          icon: L.divIcon({
            className: "",
            html: `<span class="nb-place-pin" style="--nb-era:${esc(config.accent)}"></span>`,
            iconSize: [12, 12],
            iconAnchor: [6, 6]
          })
        }).addTo(map);
        marker.bindTooltip(pin.name, { direction: "top", offset: [0, -6] });
        marker.on("click", () => {
          window.location.href = pin.href;
        });
      }
      map.fitBounds(points, { padding: [30, 30], maxZoom: 15 });
    }

    if (mapEl) {
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                io.disconnect();
                void initNbDetailMap();
              }
            }
          },
          { rootMargin: "200px 0px" }
        );
        io.observe(mapEl);
      } else {
        void initNbDetailMap();
      }
    }
  </script>

  <style>
    .nb-hero {
      position: relative;
      overflow: hidden;
      border-top: 6px solid var(--nb-accent);
      border-bottom: 1px solid var(--line);
      background: linear-gradient(155deg, var(--surface) 0 62%, var(--surface-2) 100%);
      padding-block: clamp(34px, 6vw, 72px);
    }

    .nb-hero::after {
      position: absolute;
      right: -8%;
      bottom: 0;
      width: min(58vw, 520px);
      height: 48%;
      background: var(--surface-3);
      clip-path: polygon(0 100%, 0 70%, 18% 70%, 18% 45%, 37% 45%, 37% 76%, 58% 76%, 58% 28%, 78% 28%, 78% 58%, 100% 58%, 100% 100%);
      content: "";
      opacity: 0.56;
      pointer-events: none;
    }

    .nb-hero > .container {
      position: relative;
      z-index: 1;
    }

    .nb-breadcrumb {
      margin: 0 0 16px;
    }

    .nb-breadcrumb a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--muted);
      font-family: var(--font-ui);
      font-weight: 650;
      text-decoration: none;
    }

    .nb-breadcrumb a:hover,
    .nb-breadcrumb a:focus-visible {
      color: var(--brand);
    }

    .nb-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .nb-hero-side {
      display: grid;
      gap: 16px;
      min-width: 0;
    }

    .nb-hero-media {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }

    .nb-hero-media-link {
      position: relative;
      display: block;
      overflow: hidden;
      background: var(--surface-3);
    }

    .nb-hero-media img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      filter: none;
      mix-blend-mode: normal;
    }

    .nb-hero-media-context {
      position: absolute;
      top: 12px;
      left: 12px;
      max-width: calc(100% - 24px);
      border: 1px solid rgba(255, 255, 255, 0.62);
      border-radius: var(--r-pill);
      background: rgba(8, 24, 31, 0.78);
      backdrop-filter: blur(6px);
      color: #fff;
      font-family: var(--font-ui);
      font-size: 0.68rem;
      font-weight: 760;
      letter-spacing: 0.04em;
      line-height: 1.25;
      padding: 6px 9px;
      text-transform: uppercase;
    }

    .nb-hero-media figcaption {
      display: flex;
      flex-wrap: wrap;
      gap: 3px 6px;
      padding: 9px 12px 10px;
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 0.7rem;
      line-height: 1.35;
    }

    .nb-hero-media figcaption a {
      color: inherit;
      text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
      text-underline-offset: 0.16em;
    }

    .nb-hero-media figcaption a:hover,
    .nb-hero-media figcaption a:focus-visible {
      color: var(--brand);
    }

    .nb-hero-main h1 {
      margin: 8px 0 10px;
      overflow-wrap: break-word;
    }

    .nb-tagline {
      max-width: 38ch;
      color: var(--ink-2);
      font-family: var(--font-display);
      font-size: clamp(1.18rem, 4.8vw, 1.48rem);
      font-weight: 400;
      line-height: 1.2;
      margin: 0 0 14px;
    }

    .nb-lead {
      max-width: 66ch;
      margin-bottom: 0;
    }

    .nb-glance {
      border: 1px solid var(--line);
      border-top: 5px solid var(--nb-accent);
      border-radius: var(--r-md);
      background: var(--surface);
      box-shadow: var(--shadow-card);
      padding: 17px;
    }

    .nb-glance h2 {
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 780;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      margin: 0 0 12px;
    }

    .nb-glance dl {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin: 0;
    }

    .nb-glance dt {
      color: var(--muted);
