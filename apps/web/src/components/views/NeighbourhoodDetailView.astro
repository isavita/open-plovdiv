      display: inline-block;
      border: 1px solid var(--line-strong);
      border-radius: var(--r-pill);
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 0.72rem;
      font-weight: 760;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 9px;
      margin: 0 0 8px;
      background: var(--surface-2);
    }

    .nb-fabric-card h3 {
      margin: 0 0 6px;
      font-size: 1.02rem;
      line-height: 1.3;
    }

    .nb-fabric-card h3 a {
      color: inherit;
    }

    .nb-fabric-card .meta {
      margin: 0;
    }

    .nb-tn-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .nb-tn-pair a {
      display: block;
      border: 1px solid var(--line);
      border-top: 4px solid var(--nb-accent);
      border-radius: var(--r);
      background: var(--surface);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
    }

    .nb-tn-frames {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .nb-tn-frame {
      position: relative;
      display: block;
    }

    .nb-tn-frame img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      filter: none;
      mix-blend-mode: normal;
    }

    .nb-tn-tag {
      position: absolute;
      left: 8px;
      bottom: 8px;
      background: var(--ink-deep);
      color: var(--surface);
      border-radius: var(--r-xs);
      font-family: var(--font-ui);
      font-size: 0.72rem;
      font-weight: 760;
      padding: 3px 7px;
    }

    .nb-tn-title {
      display: flex;
      align-items: center;
      min-height: 44px;
      box-sizing: border-box;
      padding: 10px 14px;
      font-weight: 720;
    }

    .nb-updated {
      margin: 0;
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }

    @media (min-width: 460px) {
      .nb-glance dl {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 560px) {
      .nb-place-grid,
      .nb-fabric-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
      }

      .nb-tn-list {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      }
    }

    @media (min-width: 620px) {
      .nb-callouts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 681px) {
      .nb-timeline li {
        --timeline-label: clamp(96px, 16vw, 136px);
        grid-template-columns: var(--timeline-label) minmax(0, 1fr);
        gap: 18px;
        padding: 0 0 24px;
      }

      .nb-timeline li::before {
        left: calc(var(--timeline-label) + 8px);
        top: 8px;
      }

      .nb-timeline-year {
        text-align: right;
        padding-right: 24px;
      }

      .nb-timeline-year::after {
        right: -13px;
        left: auto;
      }
    }

    @media (min-width: 921px) {
      .nb-hero-grid {
        grid-template-columns: minmax(0, 1fr) minmax(260px, 310px);
        gap: 32px;
      }

      .nb-body {
        grid-template-columns: minmax(0, 1fr) minmax(270px, 320px);
        gap: 32px;
      }

      .nb-side {
        position: sticky;
        top: 96px;
      }
    }
  </style>

  <style is:global>
    /* Quarter and key-place pins on the neighbourhood context map. */
    .nb-map-marker,
    .nb-place-pin {
      position: relative;
      display: block;
      box-sizing: border-box;
      border-radius: 50%;
      cursor: pointer;
    }

    .nb-map-marker {
      width: 16px;
      height: 16px;
      background: var(--nb-era, var(--brand));
      border: 3px solid var(--surface);
      box-shadow: var(--shadow);
    }

    .nb-place-pin {
      width: 11px;
      height: 11px;
      background: var(--surface);
      border: 3px solid var(--nb-era, var(--brand));
    }

    .nb-map-marker::after,
    .nb-place-pin::after {
      position: absolute;
      content: "";
    }

    .nb-map-marker::after {
      inset: -17px;
    }

    .nb-place-pin::after {
      inset: -19px;
    }

    .nb-detail-map .leaflet-control-zoom a {
      width: 44px;
      height: 44px;
      border-color: var(--line);
      background: var(--surface);
      color: var(--ink);
      font-family: var(--font-ui);
      line-height: 44px;
    }

    .nb-detail-map .leaflet-control-zoom a:hover,
    .nb-detail-map .leaflet-control-zoom a:focus-visible {
      background: var(--surface-2);
      color: var(--brand-strong);
    }
  </style>
