    directoryTitle: "Группы, дела и способы следить",
    directoryLead: "Выберите тему или найдите место. Актуальные даты и условия участия проверяйте напрямую у организатора.",
    visitOrganizer: "К организатору",
    evidence: "Источники и проверка",
    location: "Место",
    related: "Связанный общественный проект",
    external: "Внешняя страница",
    checked: "Проверено"
  },
  pl: {
    readOnly: "Katalog redakcyjny · tylko do odczytu",
    trust: "Open Plovdiv pokazuje weryfikowalne inicjatywy ze źródeł publicznych. Serwis nie przyjmuje zgłoszeń ani propozycji nowych inicjatyw.",
    explore: "Zobacz inicjatywy",
    visualContext: "Kontekst Plovdivu",
    directoryTitle: "Grupy, sprawy i sposoby śledzenia",
    directoryLead: "Wybierz temat albo znajdź miejsce. Aktualne terminy i warunki udziału sprawdzaj bezpośrednio u organizatora.",
    visitOrganizer: "Do organizatora",
    evidence: "Źródła i weryfikacja",
    location: "Miejsce",
    related: "Powiązany projekt publiczny",
    external: "Strona zewnętrzna",
    checked: "Sprawdzono"
  }
};

const copy = editorialCopy[lang];
const categories = Array.from(new Set(communityInitiatives.map((item) => item.category))).sort();
const projectLinks = Object.fromEntries(
  projects.map((project) => [
    project.id,
    {
      title: field(project, "title", lang),
      href: localizePath(`/projects/${project.id}`, lang)
    }
  ])
);

const categoryGlyphs: Record<string, string> = {
  civic: "✳",
  environment: "≈",
  parks: "♧",
  public_transport: "↗",
  social: "●"
};

type Visual = {
  url: string;
  pageUrl: string;
  credit: string;
  license: string;
  position?: string;
};

const initiativeVisuals: Record<string, Visual> = {
  "community-plovdiv-bg-be-active-green-mile": {
    url: "https://upload.wikimedia.org/wikipedia/commons/1/18/Maritsa_in_Plovdiv_01.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:Maritsa_in_Plovdiv_01.jpg",
    credit: "Kritzolina",
    license: "CC BY-SA 4.0"
  },
  "community-plovdiv-krasiv-plovdiv-cleanups": {
    url: "https://upload.wikimedia.org/wikipedia/commons/7/71/Alley_in_Dondukova_Garden%2C_Plovdiv%2C_Bulgaria_05.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:Alley_in_Dondukova_Garden%2C_Plovdiv%2C_Bulgaria_05.jpg",
    credit: "VladislavNedelev",
    license: "CC BY-SA 3.0"
  },
  "community-plovdiv-mission-lauta": {
    url: "https://upload.wikimedia.org/wikipedia/commons/a/ac/Dsc01891a.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:Dsc01891a.jpg",
    credit: "Realsteel007",
    license: "CC BY-SA 3.0"
  },
  "community-plovdiv-stolipinovo-cleanup": {
    url: "https://upload.wikimedia.org/wikipedia/commons/0/02/View_to_District_East_in_Plovdiv_1.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:View_to_District_East_in_Plovdiv_1.jpg",
    credit: "Isip2 westboro",
    license: "Public domain"
  },
  "community-plovdiv-zeleni-balkani": {
    url: "https://upload.wikimedia.org/wikipedia/commons/0/08/Maritsa_River_-_Aerial_%28_drone_%29_photography_-_Nature.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:Maritsa_River_-_Aerial_(_drone_)_photography_-_Nature.jpg",
    credit: "Pipetko",
    license: "CC BY-SA 4.0"
  },
  "community-plovdiv-cyclists": {
    url: "https://upload.wikimedia.org/wikipedia/commons/c/c1/Grebna_baza_Plovdiv.jpg",
    pageUrl: "https://commons.wikimedia.org/wiki/File:Grebna_baza_Plovdiv.jpg",
    credit: "Plovdiv Municipality",
    license: "CC BY-SA 4.0"
  }
};

const heroItems = [
  communityInitiatives.find((item) => item.id === "community-plovdiv-bg-be-active-green-mile"),
  communityInitiatives.find((item) => item.id === "community-plovdiv-krasiv-plovdiv-cleanups"),
  communityInitiatives.find((item) => item.id === "community-plovdiv-cyclists")
].filter(Boolean);

const searchable = (item: (typeof communityInitiatives)[number]) =>
  [
    field(item, "title", lang),
    field(item, "summary", lang),
    field(item.organizer, "name", lang),
    field(item.location, "address", lang),
    item.tags?.join(" ") ?? ""
  ]
    .join(" ")
    .toLocaleLowerCase(localeForLang(lang));

const clientConfig = {
  locale: localeForLang(lang),
  total: communityInitiatives.length,
  // Pre-rendered plural forms: filtering rewrites this badge on every
  // keystroke, and a bare "7" in a pill says nothing about what was counted.
  totalLabel: t.community.count(communityInitiatives.length),
  countLabels: Array.from({ length: communityInitiatives.length + 1 }, (_, n) => t.community.count(n))
};
---

<Layout lang={lang} path="/community" title={t.community.title} description={t.community.lead}>
  <section class="community-hero" data-section="community">
    <div class="container community-hero-layout">
      <div class="community-hero-copy">
        <p class="eyebrow">{t.community.eyebrow}</p>
        <h1>{t.community.title}</h1>
        <p class="lead">{t.community.lead}</p>
        <div class="community-trust">
          <span class="community-trust-mark" aria-hidden="true">i</span>
          <div>
            <strong>{copy.readOnly}</strong>
            <p>{copy.trust}</p>
          </div>
        </div>
        <a class="button" href="#initiatives-directory">
          {copy.explore}<span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="community-hero-mosaic" aria-label={copy.visualContext}>
        {heroItems.map((item, index) => {
          if (!item) return null;
          const visual = initiativeVisuals[item.id];
          return (
            <figure class:list={["community-hero-tile", `tile-${index + 1}`]}>
              <a href={`#${item.id}`} aria-label={field(item, "title", lang)}>
                <img
                  src={commonsImageUrl(visual.url, index === 0 ? 960 : 500)}
                  srcset={`${commonsImageUrl(visual.url, 500)} 500w, ${commonsImageUrl(visual.url, 960)} 960w`}
                  sizes={index === 0 ? "(max-width: 620px) 100vw, 36vw" : "(max-width: 620px) 50vw, 20vw"}
                  alt=""
                  width="1200"
                  height="800"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="community-hero-caption">
                  <small>{copy.visualContext}</small>
                  <strong>{field(item, "title", lang)}</strong>
                </span>
              </a>
              <figcaption>
                <a href={visual.pageUrl} target="_blank" rel="noreferrer">
                  {visual.credit} · {visual.license}
                </a>
              </figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <section class="community-directory" id="initiatives-directory">
    <div class="container">
      <header class="community-directory-head">
        <div>
          <p class="eyebrow">{t.community.eyebrow}</p>
          <h2>{copy.directoryTitle}</h2>
          <p>{copy.directoryLead}</p>
        </div>
        <p class="community-results" id="community-count" aria-live="polite">
          {t.community.count(communityInitiatives.length)}
        </p>
      </header>

      <div class="community-filter-panel" aria-label={t.community.search}>
        <div class="community-search-field">
          <label for="community-search">{t.community.search}</label>
          <div class="community-search-control">
            <span aria-hidden="true">⌕</span>
            <input
              id="community-search"
              type="search"
              placeholder={t.community.searchPlaceholder}
              autocomplete="off"
            />
          </div>
        </div>
        <div class="community-category-filter">
          <span class="community-filter-label">{t.community.category}</span>
          <div class="community-filter-chips" role="group" aria-label={t.community.category}>
            <button type="button" class="community-filter-chip is-active" data-community-category="all" aria-pressed="true">
              {t.common.all}
            </button>
            {categories.map((category) => (
              <button
                type="button"
                class="community-filter-chip"
                data-community-category={category}
                aria-pressed="false"
              >
                <span aria-hidden="true">{categoryGlyphs[category] ?? "•"}</span>
                {categoryLabels[lang][category] ?? category}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="community-card-grid" id="community-list">
        {communityInitiatives.map((item) => {
          const visual = initiativeVisuals[item.id];
          const contact = item.contact_links?.[0];
          const contactUrl = contact?.url ?? item.organizer.website_url ?? item.organizer.facebook_url;
          const relatedProjects = (item.related_project_ids ?? [])
            .map((id) => projectLinks[id])
            .filter(Boolean);
          const color = categoryColors[item.category] ?? "var(--brand)";
          const categoryLabel = categoryLabels[lang][item.category] ?? item.category;
          const statusLabel = communityStatusLabels[lang][item.status] ?? item.status;
          const callToAction = field(item, "call_to_action", lang);

          return (
            <article
              class="community-card"
              id={item.id}
              data-community-card
              data-search={searchable(item)}
              data-category={item.category}
              style={`--category-color:${color}`}
            >
              <div class:list={["community-card-media", !visual && "is-fallback"]}>
                {visual ? (
                  <>
                    <img
                      src={commonsImageUrl(visual.url, 500)}
                      srcset={`${commonsImageUrl(visual.url, 330)} 330w, ${commonsImageUrl(visual.url, 500)} 500w, ${commonsImageUrl(visual.url, 960)} 960w`}
                      sizes="(max-width: 620px) 100vw, (max-width: 1040px) 50vw, 33vw"
                      alt=""
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      style={visual.position ? `object-position:${visual.position}` : undefined}
                    />
                    <span class="community-media-context">{copy.visualContext}</span>
                    <a class="community-media-credit" href={visual.pageUrl} target="_blank" rel="noreferrer">
                      {visual.credit} · {visual.license}
                    </a>
                  </>
                ) : (
                  <div class="community-card-pattern" aria-hidden="true">
                    <span>{categoryGlyphs[item.category] ?? "•"}</span>
                    <i></i><i></i><i></i>
                  </div>
                )}
              </div>

              <div class="community-card-body">
                <div class="community-card-kicker">
                  <span class="community-category">
                    <i aria-hidden="true"></i>{categoryLabel}
                  </span>
                  <span class="community-status">{statusLabel}</span>
                </div>
                <h3>{field(item, "title", lang)}</h3>
                <p class="community-summary">{field(item, "summary", lang)}</p>

                <dl class="community-card-facts">
                  <div>
                    <dt>{t.community.organizer}</dt>
                    <dd>{field(item.organizer, "name", lang)}</dd>
                  </div>
                  <div>
                    <dt>{copy.location}</dt>
                    <dd>{field(item.location, "address", lang)}</dd>
                  </div>
                </dl>

                {callToAction && <p class="community-follow-note">{callToAction}</p>}

                <div class="community-card-actions">
                  {contactUrl && (
                    <a
                      class="button"
                      href={contactUrl}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${copy.visitOrganizer} · ${copy.external}`}
                    >
                      {copy.visitOrganizer}<span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {item.donation_url && (
                    <a class="community-donation-link" href={item.donation_url} target="_blank" rel="noreferrer">
                      {t.community.donate} ↗
                    </a>
                  )}
                </div>

                <details class="community-evidence">
                  <summary>
                    <span>{copy.evidence}</span>
                    <span aria-hidden="true">+</span>
                  </summary>
                  <div class="community-evidence-body">
                    <p class="community-checked">
                      <strong>{copy.checked}</strong> {item.discovery.last_checked_at}
                    </p>
                    {relatedProjects.length > 0 && (
                      <div class="community-related">
                        <strong>{copy.related}</strong>
                        <ul>
                          {relatedProjects.map((project) => (
                            <li><a href={project.href}>{project.title}</a></li>
                          ))}
                        </ul>
                      </div>
                    )}
                    <ol class="community-source-list">
                      {item.sources.map((source) => (
                        <li>
                          <a href={source.url} target="_blank" rel="noreferrer">
                            {field(source, "title", lang)}
                          </a>
                          <small>{t.common.accessed} {source.accessed_at}</small>
                        </li>
                      ))}
                    </ol>
                  </div>
                </details>
              </div>
            </article>
          );
        })}
      </div>

      <div id="community-empty" class="community-empty" hidden>
        <p>{t.community.empty}</p>
        <button type="button" class="link-button" data-community-reset>{t.community.reset}</button>
      </div>

      <aside class="community-disclaimer">
        <span aria-hidden="true">↗</span>
