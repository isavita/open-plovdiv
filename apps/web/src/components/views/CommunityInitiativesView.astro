  <script type="application/json" id="community-config" set:html={JSON.stringify(clientConfig)}></script>
  <script>
    import { matchesSearchText } from "@lib/searchCore";

    const config = JSON.parse(document.getElementById("community-config")?.textContent ?? "{}");
    const search = document.querySelector<HTMLInputElement>("#community-search");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-community-card]"));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-community-category]"));
    const count = document.querySelector<HTMLElement>("#community-count");
    const empty = document.querySelector<HTMLElement>("#community-empty");
    let selectedCategory = "all";

    const initialQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
    if (search && initialQuery) search.value = initialQuery;

    function applyFilters() {
      const query = search?.value.trim() ?? "";
      let visible = 0;
      cards.forEach((card) => {
        const matches =
          matchesSearchText(card.dataset.search ?? "", query) &&
          (selectedCategory === "all" || card.dataset.category === selectedCategory);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (count) {
        count.textContent =
          visible === config.total
            ? config.totalLabel
            : `${config.countLabels?.[visible] ?? visible} / ${config.total}`;
      }
      if (empty) empty.hidden = visible > 0;
    }

    function chooseCategory(button: HTMLButtonElement) {
      selectedCategory = button.dataset.communityCategory ?? "all";
      chips.forEach((chip) => {
        const active = chip === button;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", String(active));
      });
      applyFilters();
    }

    function resetFilters() {
      if (search) search.value = "";
      const all = chips.find((chip) => chip.dataset.communityCategory === "all");
      if (all) chooseCategory(all);
      search?.focus();
    }

    search?.addEventListener("input", applyFilters);
    chips.forEach((chip) => chip.addEventListener("click", () => chooseCategory(chip)));
    document.querySelectorAll<HTMLButtonElement>("[data-community-reset]").forEach((button) => {
      button.addEventListener("click", resetFilters);
    });
    applyFilters();
  </script>
