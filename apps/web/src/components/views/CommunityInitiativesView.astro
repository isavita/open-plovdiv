---
import Layout from "@layouts/Layout.astro";
import {
  categoryColors,
  categoryLabels,
  communityStatusLabels,
  ui,
  type Lang
} from "@i18n/ui";
import { field, localeForLang, localizePath } from "@i18n/utils";
import { commonsImageUrl } from "@lib/commons";
import { communityInitiatives, projects } from "@lib/data";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];

const editorialCopy: Record<
