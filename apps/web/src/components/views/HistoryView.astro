  </section>

  <section class="section section-tint" id="data" data-subnav-target>
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{labels.dataTitle}</h2>
          <p class="meta" style="margin-top:8px;max-width:74ch">{labels.dataLead}</p>
        </div>
      </div>

      <div class="grid grid-2">
        <article class="card">
          <h3>{labels.endpoint}</h3>
          <ul class="source-list">
            {endpointRows.map((row) => (
              <li><a href={row.href}>{row.label}: {row.href}</a></li>
            ))}
          </ul>
        </article>
