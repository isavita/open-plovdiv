<Layout lang={lang} path="/history" title={t.history.title} description={t.history.lead}>
  <section class="hero hero-compact" data-section="history">
    <HeroBackdrop />
    <div class="container">
      <p class="eyebrow">{t.history.eyebrow}</p>
      <h1>{t.history.title}</h1>
      <p class="lead">{t.history.lead}</p>
      <div class="button-row" style="margin-top:18px">
        <a class="button secondary" href={localizePath("/history/contribute", lang)}>{labels.contribute}</a>
      </div>
      <div class="stat-row" style="margin-top:22px">
        {stats.map((s) => (
          <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <SectionNav items={sectionNav} label={sectionNavLabel} />

  <section class="section" id="history-tree" data-subnav-target>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{treeLabels.eyebrow}</p>
          <h2>{treeLabels.title}</h2>
          <p class="meta" style="margin-top:8px;max-width:76ch">{treeLabels.lead}</p>
        </div>
      </div>

      <div class="htree" role="list" aria-label={treeLabels.title}>
        {historyTree.map((era, eraIndex) => (
          <details class={`htree-era era-${era.era}`} data-tree-era={era.era} role="listitem" open={eraIndex === 0}>
            <summary class="htree-era-sum">
              <span class="htree-era-mark" aria-hidden="true">
                <LandmarkMotif name={era.motif} />
              </span>
              <span class="htree-era-name">{era.label}</span>
              <span class="htree-era-range">{era.yearRange}</span>
              <span class="htree-era-count">{era.count} {treeLabels.events}</span>
              <span class="htree-caret" aria-hidden="true"></span>
            </summary>
            <ol class="htree-events">
              {era.keyEvents.map((ev) => (
                <li class="htree-event" role="listitem">
                  <details class="htree-event-details">
                    <summary class="htree-event-sum">
