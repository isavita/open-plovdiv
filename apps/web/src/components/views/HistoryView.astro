function pickKeyEvents(eraEvents: KnowledgeEvent[], max = 6): KnowledgeEvent[] {
  const sorted = [...eraEvents].sort((a, b) => a.date.year - b.date.year);
  if (sorted.length <= max) return sorted;
  // Prefer events that carry people/place links, then spread across the era.
  const linked = sorted.filter((e) => e.person_ids.length || e.place_ids.length);
  const pool = linked.length >= max ? linked : sorted;
  const step = pool.length / max;
  const picked: KnowledgeEvent[] = [];
  const seen = new Set<string>();
  for (let i = 0; i < max; i++) {
    const ev = pool[Math.min(pool.length - 1, Math.floor(i * step))];
    if (ev && !seen.has(ev.id)) {
      seen.add(ev.id);
      picked.push(ev);
    }
  }
  return picked;
}

const historyTree = erasPresent.map((era) => {
  const eraEvents = entries.filter((e) => e.era === era);
  const years = eraEvents.map((e) => e.date.year);
  const keyEvents = pickKeyEvents(eraEvents, 6).map((ev) => {
    const people = (ev.person_ids.slice(0, 4).map((id) => peopleById.get(id)).filter(Boolean) as any[]).map((p) => ({
      id: p.id,
      name: localized(p, "name")
    }));
    const places = (ev.place_ids.slice(0, 4).map((id) => placesById.get(id)).filter(Boolean) as any[]).map((p) => ({
      id: p.id,
      name: localized(p, "name")
    }));
    return { id: ev.id, date: dateLabel(ev), title: localized(ev, "title"), people, places };
  });
  return {
    era,
    motif: eraMotif[era],
    label: t.history.eraLabels[era],
    yearRange: eraEvents.length ? fmtYearRange(Math.min(...years), Math.max(...years)) : "",
    count: eraEvents.length,
    keyEvents
  };
});
