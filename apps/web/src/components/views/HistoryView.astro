    margin: 0;
    padding: 0;
    list-style: none;
  }

  .on-this-day-list:empty {
    display: none;
  }

  .on-this-day-list li {
    display: grid;
    gap: 4px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    background: var(--surface-2);
