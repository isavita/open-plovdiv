---
import { llmsLabels } from "@lib/llmsLabels";
import { localizePath, type Lang } from "@i18n/utils";

const { lang, path } = Astro.props as { lang: Lang; path: string };
const pagePath = new URL(localizePath(path, lang), Astro.site ?? "https://openplovdiv.example").pathname;
const markdownPath = pagePath === "/" ? "/index.md" : `${pagePath.replace(/\/+$/, "")}.md`;
const label = llmsLabels[lang].page;
---

<nav class="page-markdown-tools container" aria-label={label} data-markdown-link>
  <a class="page-markdown-link" href={markdownPath} type="text/markdown">{label}</a>
</nav>

<style>
  /* Sits quietly after the page content, so the first screen belongs to the city. */
  .page-markdown-tools {
    display: flex;
    justify-content: flex-end;
    padding-block: 8px 12px;
  }
  .page-markdown-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 0.2em;
  }
  .page-markdown-link:hover { color: var(--brand); text-decoration-color: currentColor; }
</style>
