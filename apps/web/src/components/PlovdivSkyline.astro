---
// Decorative silhouette of Plovdiv's layered skyline — the "city of the seven
// hills" told as one engraved horizon. Left to right: a hill with the Nebet
// Tepe citadel ruins, a National Revival house with its overhanging upper
// floor, the Antique Theatre colonnade, the Sahat Tepe clock tower, the
// Dzhumaya mosque (minaret + dome), and a Roman gateway arch. Purely
// presentational; fill follows `currentColor` so callers control tone via CSS.
//
// Drawing rules (kept deliberately strict so the horizon reads as designed,
// not accidental): every mass sits on the ground line; finials/chimneys are
// embedded in the shape below them; the two faint back-layer hills never
// overlap each other or leak past a front shape's edge; stroke details
// (windows, clock, arcade) all share one opacity; the theatre is symmetric
// about its own axis; nothing extends past x=1196 so the right edge never
// crops a structure.
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1200 340"
  preserveAspectRatio="xMidYMax meet"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- back layer: two distant hills (left and right), no self-overlap -->
  <g fill="currentColor" opacity="0.45">
    <path d="M0 322 C 90 246 210 240 300 262 C 360 276 430 302 490 322 Z" />
    <path d="M780 322 C 900 302 1040 294 1200 258 L1200 322 Z" />
  </g>

  <!-- front layer: the landmarks, all grounded on y=320 -->
  <g fill="currentColor">
    <!-- ground line -->
    <rect x="0" y="320" width="1200" height="3" />

    <!-- 1 — Nebet Tepe ruins: three broken wall blocks, merlons on the tallest -->
    <rect x="96" y="272" width="28" height="48" />
    <rect x="130" y="288" width="44" height="32" />
    <rect x="180" y="258" width="26" height="62" />
    <rect x="184" y="248" width="5" height="12" />
    <rect x="197" y="248" width="5" height="12" />

    <!-- 2 — National Revival house: base, overhanging upper floor, eaves, hipped roof -->
    <rect x="268" y="248" width="104" height="72" />
    <rect x="252" y="204" width="136" height="48" />
    <rect x="246" y="198" width="148" height="7" />
    <polygon points="246,200 292,158 348,158 394,200" />
    <rect x="352" y="138" width="10" height="36" />
    <rect x="272" y="214" width="14" height="26" fill="none" stroke="currentColor" stroke-width="2" opacity="0.35" />
    <rect x="306" y="214" width="14" height="26" fill="none" stroke="currentColor" stroke-width="2" opacity="0.35" />
    <rect x="340" y="214" width="14" height="26" fill="none" stroke="currentColor" stroke-width="2" opacity="0.35" />

    <!-- 3 — Antique Theatre: two steps, five columns, entablature, pediment (axis x=584) -->
    <rect x="464" y="306" width="240" height="14" />
    <rect x="476" y="292" width="216" height="14" />
    <rect x="484" y="196" width="16" height="96" />
    <rect x="530" y="196" width="16" height="96" />
    <rect x="576" y="196" width="16" height="96" />
    <rect x="622" y="196" width="16" height="96" />
    <rect x="668" y="196" width="16" height="96" />
    <rect x="472" y="178" width="224" height="18" />
    <polygon points="472,178 584,140 696,178" />

    <!-- 4 — Sahat Tepe clock tower: shaft, cornice, pyramid roof, embedded finial -->
    <rect x="770" y="158" width="44" height="162" />
    <rect x="762" y="148" width="60" height="10" />
    <polygon points="762,150 792,116 822,150" />
    <rect x="789" y="98" width="6" height="22" />
    <circle cx="792" cy="95" r="5" />
    <circle cx="792" cy="188" r="12" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.35" />
    <rect x="790.5" y="179" width="3" height="10" opacity="0.35" />
    <rect x="791" y="186.5" width="8" height="3" opacity="0.35" />

    <!-- 5 — Dzhumaya mosque: minaret with balcony and cone, dome hall with arcade -->
    <rect x="872" y="150" width="16" height="170" />
    <rect x="866" y="184" width="28" height="6" />
    <polygon points="868,150 880,118 892,150" />
    <circle cx="880" cy="114" r="4" />
    <rect x="918" y="220" width="150" height="100" />
    <path d="M918 222 A75 58 0 0 1 1068 222 Z" />
    <rect x="990" y="146" width="6" height="22" />
    <circle cx="993" cy="143" r="4.5" />
    <path
      d="M948 320 v-12 a9 9 0 0 1 18 0 v12 M984 320 v-12 a9 9 0 0 1 18 0 v12 M1020 320 v-12 a9 9 0 0 1 18 0 v12"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      opacity="0.35"
    />

    <!-- 6 — Roman gateway arch: entablature over one solid body with an arched opening -->
    <rect x="1074" y="164" width="112" height="16" />
    <path d="M1082 180 H1178 V320 H1154 V240 A24 24 0 0 0 1106 240 V320 H1082 Z" />
  </g>
</svg>
