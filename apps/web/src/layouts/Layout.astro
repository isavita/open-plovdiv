---
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource-variable/source-sans-3/wght-italic.css";
import notoSansJpCssUrl from "@fontsource-variable/noto-sans-jp/wght.css?url";
import "../styles/global.css";
import "../styles/identity.css";
import PlovdivMark from "@components/PlovdivMark.astro";
import PlovdivSkyline from "@components/PlovdivSkyline.astro";
import SiteSearch from "@components/SiteSearch.astro";
import { languages, localeCodes, localeForLang, localizePath, ui, type Lang } from "@i18n/utils";
import { siteSearchUi } from "@lib/siteSearchI18n";
import {
  absoluteUrl,
  buildPageStructuredData,
  inferOpenGraphType,
  serializeJsonLd,
  type JsonLdObject
} from "@lib/seo";

type Props = {
  lang: Lang;
  /** Logical (default-locale) path of this page, e.g. "/projects" or "/". */
  path: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  structuredData?: JsonLdObject | JsonLdObject[];
  /** Long Japanese editorial pages can opt into the native CJK stack to avoid loading dozens of font subsets. */
  loadJapaneseWebfont?: boolean;
  /**
   * Opt-in for pages that are a single static file shared by every locale
   * (only the global 404.html today — Astro has no per-locale fallback
   * route, confirmed by testing). When true, the header/footer chrome below
   * is additionally re-localized client-side to match the locale detected
   * from the visited URL, instead of staying fixed at `lang`. Every other
   * page already renders the correct chrome server-side and leaves this off.
   */
  localeDetect?: boolean;
};

const {
  lang,
  path,
  title,
  description,
  image,
  imageAlt,
  robots,
  structuredData,
  localeDetect,
  loadJapaneseWebfont = true
} = Astro.props;
const t = ui[lang];
const searchT = siteSearchUi[lang];

const pageTitle = title ? `${title} · ${t.site.name}` : t.site.name;
const pageDescription = description ?? t.site.tagline;
const structuredTitle = title ?? t.site.name;

const ogLocales: Record<Lang, string> = { bg: "bg_BG", en: "en_GB", de: "de_DE", fr: "fr_FR", it: "it_IT", tr: "tr_TR", es: "es_ES", el: "el_GR", ja: "ja_JP", tl: "fil_PH", uk: "uk_UA", ru: "ru_RU", pl: "pl_PL" };
const ogLocale = ogLocales[lang];
const routesLabel = ({ bg: "Маршрути", en: "Routes", de: "Routen", fr: "Parcours", it: "Percorsi", tr: "Rotalar", es: "Rutas", el: "Διαδρομές", ja: "ルート", tl: "Mga Ruta", uk: "Маршрути", ru: "Маршруты", pl: "Trasy" } satisfies Record<Lang, string>)[lang];
const governanceLabel = ({ bg: "Управление", en: "Governance", de: "Verwaltung", fr: "Gouvernance", it: "Governo", tr: "Yönetim", es: "Gobernanza", el: "Διακυβέρνηση", ja: "統治", tl: "Pamamahala", uk: "Управління", ru: "Управление", pl: "Zarządzanie" } satisfies Record<Lang, string>)[lang];
const neighbourhoodsLabels = { bg: "Квартали", en: "Neighbourhoods", de: "Viertel", fr: "Quartiers", it: "Quartieri", tr: "Mahalleler", es: "Barrios", el: "Συνοικίες", ja: "街区", tl: "Mga Purok", uk: "Квартали", ru: "Кварталы", pl: "Dzielnice" } satisfies Record<Lang, string>;
const neighbourhoodsLabel = neighbourhoodsLabels[lang];

// The city's own word for its easygoing rhythm — a quiet signature repeated
// in the footer so the whole site keeps the same "ailyak" tone.
const ailyakMottos = {
  bg: "Айляк — пловдивското спокойствие.",
  en: "Ailyak — Plovdiv's easygoing rhythm.",
  de: "Ailyak — Plovdivs Gelassenheit.",
  fr: "Aïlyak — l'art plovdivien de prendre son temps.",
  it: "Ailyak — Plovdiv senza fretta.",
  tr: "Ailyak — Plovdiv'in sakin hali.",
  es: "Ailyak: Plovdiv sin prisa.",
  el: "Αϊλιάκ — η ήρεμη πλευρά του Πλόβντιβ.",
  ja: "アイリャク — プロヴディフらしい穏やかな時間。",
  tl: "Ailyak — ang payapang pakiramdam ng Plovdiv.",
  uk: "Айляк — спокійний настрій Пловдива.",
  ru: "Айляк — спокойное настроение Пловдива.",
  pl: "Ajlak — spokojny nastrój Plovdivu."
} satisfies Record<Lang, string>;
const ailyakMotto = ailyakMottos[lang];

// Primary nav is visitor-first: history, walking routes, places and stories
// lead; political context sits last. Civic + reference links live in the
// grouped menu, the footer and homepage action paths.
const navItems = [
  { href: localizePath("/history", lang), base: "/history", label: t.nav.history },
  { href: localizePath("/routes", lang), base: "/routes", label: routesLabel },
  { href: localizePath("/places", lang), base: "/places", label: t.nav.places },
  { href: localizePath("/stories", lang), base: "/stories", label: t.nav.stories },
  { href: localizePath("/governance", lang), base: "/governance", label: governanceLabel }
];

function isActive(base: string): boolean {
  if (base === "/") return path === "/";
  return path === base || path.startsWith(`${base}/`);
}

const site = Astro.site ?? new URL("https://openplovdiv.example");
const canonical = new URL(localizePath(path, lang), site).href;
const seoImage = absoluteUrl(image, site);
const seoImageAlt = imageAlt ?? structuredTitle;
const ogType = inferOpenGraphType(path);
// hreflang alternates for every supported locale (+ x-default → Bulgarian root).
const altLinks = localeCodes.map((code) => ({
  code,
  href: new URL(localizePath(path, code), site).href
}));
const xDefaultHref = new URL(localizePath(path, "bg"), site).href;
const structuredDataJson = serializeJsonLd(
  buildPageStructuredData({
    site,
    lang,
    locale: localeForLang(lang),
    siteName: t.site.name,
    logicalPath: path,
    canonical,
    title: structuredTitle,
    description: pageDescription,
    image: seoImage,
    additional: structuredData,
    breadcrumbLabels: {
      home: t.nav.home,
      history: t.nav.history,
      routes: routesLabel,
      neighbourhoods: neighbourhoodsLabel,
      mayors: t.nav.mayors,
      governance: governanceLabel,
      people: t.nav.people,
      places: t.nav.places,
      stories: t.nav.stories,
      archive: t.nav.archive,
      overview: t.nav.overview,
      projects: t.nav.projects,
      community: t.nav.community,
      "data-sources": t.footer.sources,
      privacy: t.footer.privacy
    }
  })
);

const footerHistory = [
  { href: localizePath("/history", lang), label: t.nav.history, key: "history" },
  { href: localizePath("/routes", lang), label: routesLabel, key: "routes" },
  { href: localizePath("/places", lang), label: t.nav.places, key: "places" },
  { href: localizePath("/neighbourhoods", lang), label: neighbourhoodsLabel, key: "neighbourhoods" },
  { href: localizePath("/stories", lang), label: t.nav.stories, key: "stories" },
  { href: localizePath("/mayors", lang), label: t.nav.mayors, key: "mayors" },
  { href: localizePath("/governance", lang), label: governanceLabel, key: "governance" },
  { href: localizePath("/people", lang), label: t.nav.people, key: "people" },
  { href: localizePath("/archive", lang), label: t.nav.archive, key: "archive" }
];
const footerCivic = [
  { href: localizePath("/overview", lang), label: t.nav.overview, key: "overview" },
  { href: localizePath("/projects", lang), label: t.nav.projects, key: "projects" },
  { href: localizePath("/community", lang), label: t.footer.community, key: "community" }
];
const footerAbout = [
  { href: localizePath("/data-sources", lang), label: t.footer.sources, key: "data-sources" },
  { href: localizePath("/privacy", lang), label: t.footer.privacy, key: "privacy" }
];

// Secondary destinations shown only inside the mobile menu, grouped so the
// phone nav reaches every page without duplicating the 5 primary links.
const menuExplore = [
  { href: localizePath("/neighbourhoods", lang), base: "/neighbourhoods", label: neighbourhoodsLabel },
  { href: localizePath("/mayors", lang), base: "/mayors", label: t.nav.mayors },
  { href: localizePath("/people", lang), base: "/people", label: t.nav.people },
  { href: localizePath("/archive", lang), base: "/archive", label: t.nav.archive }
];
const menuCivic = [
  { href: localizePath("/overview", lang), base: "/overview", label: t.nav.overview },
  { href: localizePath("/projects", lang), base: "/projects", label: t.nav.projects },
  { href: localizePath("/community", lang), base: "/community", label: t.footer.community }
];
const menuAbout = [
  { href: localizePath("/data-sources", lang), base: "/data-sources", label: t.footer.sources },
  { href: localizePath("/privacy", lang), base: "/privacy", label: t.footer.privacy }
];
const menuGroups = [
  { key: "explore", label: t.footer.explore, items: menuExplore },
  { key: "civic", label: t.footer.civic, items: menuCivic },
  { key: "about", label: t.footer.about, items: menuAbout }
];

// All-locale chrome strings for pages that opt into `localeDetect` (see the
// prop doc above) — built once, only when needed, and consumed client-side
// by the bottom script to re-localize the header/footer after detecting the
// visited locale from the URL, using the same stable keys as the
// data-nav-key/data-menu-key/data-footer-key hooks rendered below.
const routesLabels = { bg: "Маршрути", en: "Routes", de: "Routen", fr: "Parcours", it: "Percorsi", tr: "Rotalar", es: "Rutas", el: "Διαδρομές", ja: "ルート", tl: "Mga Ruta", uk: "Маршрути", ru: "Маршруты", pl: "Trasy" } satisfies Record<Lang, string>;
const governanceLabels = { bg: "Управление", en: "Governance", de: "Verwaltung", fr: "Gouvernance", it: "Governo", tr: "Yönetim", es: "Gobernanza", el: "Διακυβέρνηση", ja: "統治", tl: "Pamamahala", uk: "Управління", ru: "Управление", pl: "Zarządzanie" } satisfies Record<Lang, string>;
const chromeI18n = localeDetect
  ? Object.fromEntries(
      localeCodes.map((code) => {
        const l = ui[code];
        return [
          code,
          {
            siteName: l.site.name,
            skip: l.site.skip,
            menuAria: l.site.menu,
            langSwitchAria: l.site.langSwitch,
            themeAria: l.site.theme,
            homeAria: l.nav.home,
            nav: {
              history: l.nav.history,
              routes: routesLabels[code],
              neighbourhoods: neighbourhoodsLabels[code],
              mayors: l.nav.mayors,
              governance: governanceLabels[code],
              places: l.nav.places,
              people: l.nav.people,
              stories: l.nav.stories,
              archive: l.nav.archive,
              overview: l.nav.overview,
              projects: l.nav.projects,
              community: l.footer.community,
              "data-sources": l.footer.sources,
              privacy: l.footer.privacy
            },
            groups: { explore: l.footer.explore, civic: l.footer.civic, about: l.footer.about },
            footer: { blurb: l.footer.blurb, motto: ailyakMottos[code], note: l.footer.note, dataNote: l.footer.dataNote }
          }
        ];
      })
    )
  : null;
const chromeI18nJson = chromeI18n ? JSON.stringify(chromeI18n) : "";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {altLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.code} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#173f62" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content={t.site.name} />
    <meta name="apple-mobile-web-app-title" content={t.site.name} />
    <meta name="msapplication-TileColor" content="#173f62" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    {lang === "ja" && loadJapaneseWebfont && <link rel="stylesheet" href={notoSansJpCssUrl} />}
    {localeDetect && (
      <script is:inline define:vars={{ notoSansJpCssUrl }}>
        if ((window.location.pathname || "/").split("/").filter(Boolean)[0] === "ja") {
          var jaFont = document.createElement("link");
          jaFont.rel = "stylesheet";
          jaFont.href = notoSansJpCssUrl;
          document.head.appendChild(jaFont);
        }
      </script>
    )}
    <meta name="theme-color" content="#173f62" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1820" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {altLinks.filter((alt) => alt.code !== lang).map((alt) => (
      <meta property="og:locale:alternate" content={ogLocales[alt.code]} />
    ))}
    {seoImage && (
      <>
        <meta property="og:image" content={seoImage} />
        <meta property="og:image:alt" content={seoImageAlt} />
      </>
    )}
    <meta name="twitter:card" content={seoImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonical} />
    {seoImage && <meta name="twitter:image" content={seoImage} />}
    {seoImage && <meta name="twitter:image:alt" content={seoImageAlt} />}

    <script type="application/ld+json" set:html={structuredDataJson}></script>

    <script is:inline>
      (function () {
        // Mark JS as available so the scroll-reveal hidden state only applies
        // when we can actually reveal it (content stays visible without JS).
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("op-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-map-zoom-in={t.common.zoomIn} data-map-zoom-out={t.common.zoomOut}>
    <div class="site-shell">
      <a class="skip-link" href="#main" data-skip-link>{t.site.skip}</a>

      <header class="site-header" id="site-header">
        <nav class="nav" aria-label={t.nav.home} data-nav-aria>
          <a class="brand" href={localizePath("/", lang)} aria-label={`${t.site.name} — ${t.nav.home}`} data-brand data-brand-aria>
            <PlovdivMark />
            <span data-brand-name>{t.site.name}</span>
          </a>

          <div class="nav-links" id="nav-links">
            {navItems.map((item) => (
              <a href={item.href} data-nav-key={item.base.slice(1)} aria-current={isActive(item.base) ? "page" : undefined}>
                {item.label}
              </a>
            ))}

            <details class="nav-more" id="nav-more">
              <summary>
                <span>{t.footer.explore}</span>
                <span class="nav-more-caret" aria-hidden="true">▾</span>
              </summary>
              <div class="nav-more-panel">
                {menuGroups.map((group) => (
                  <div class="nav-more-group">
                    <span class="nav-group-label">{group.label}</span>
                    {group.items.map((item) => (
                      <a href={item.href} aria-current={isActive(item.base) ? "page" : undefined}>
                        {item.label}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </details>

            <div class="nav-groups" aria-label={t.footer.explore} data-nav-groups-aria>
              {menuGroups.map((group) => (
                <div class="nav-group">
                  <span class="nav-group-label" data-menu-group={group.key}>{group.label}</span>
                  {group.items.map((item) => (
                    <a href={item.href} data-menu-key={item.base.slice(1)} aria-current={isActive(item.base) ? "page" : undefined}>
                      {item.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="nav-right">
            <SiteSearch lang={lang} />
            <details class="lang-menu" id="lang-menu">
              <summary class="icon-btn lang-switch" aria-label={`${lang.toUpperCase()} · ${t.site.langSwitch}`} title={t.site.langSwitch} data-lang-switch-aria>
                <span class="flag" aria-hidden="true" data-flag>{lang.toUpperCase()}</span>
                <span class="lang-caret" aria-hidden="true">▾</span>
              </summary>
              <ul class="lang-options">
                {localeCodes.map((code) => (
                  <li>
                    <a
                      href={localizePath(path, code)}
                      hreflang={code}
                      lang={code}
                      data-lang-option={code}
                      aria-current={code === lang ? "true" : undefined}
                    >
                      <span class="lang-code" aria-hidden="true">{code.toUpperCase()}</span>
                      <span>{languages[code]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
            <button
              type="button"
              class="icon-btn theme-toggle"
              id="theme-toggle"
              aria-label={t.site.theme}
              title={t.site.theme}
              data-theme-aria
            >
              <span class="sun" aria-hidden="true">☀</span>
              <span class="moon" aria-hidden="true">☾</span>
            </button>
            <button
              type="button"
              class="icon-btn nav-toggle"
              id="nav-toggle"
              aria-controls="nav-links"
              aria-expanded="false"
              aria-label={t.site.menu}
              data-menu-aria
              data-nav-toggle
            >
              <span aria-hidden="true">☰</span>
            </button>
          </div>
        </nav>
      </header>

      <main class="main" id="main">
        <slot />
      </main>

      <nav class="mobile-dock" aria-label={t.footer.explore}>
        <a href={localizePath("/", lang)} aria-current={isActive("/") ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z" /></svg>
          <span>{t.nav.home}</span>
        </a>
        <a href={localizePath("/routes", lang)} aria-current={isActive("/routes") ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h4v4H5zM15 16h4v4h-4zM9 6h3a4 4 0 0 1 4 4v6M12 10H8a4 4 0 0 0-4 4v2" /></svg>
          <span>{routesLabel}</span>
        </a>
        <a href={localizePath("/places", lang)} aria-current={isActive("/places") ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z" /><path d="M9 3v15M15 6v15" /></svg>
          <span>{t.nav.places}</span>
        </a>
        <button type="button" aria-label={searchT.open} title={searchT.shortcut} data-site-search-open>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
          <span data-search-copy="open">{searchT.open}</span>
        </button>
        <button type="button" aria-controls="nav-links" aria-expanded="false" aria-label={t.site.menu} data-nav-toggle>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span>{t.site.menu}</span>
        </button>
      </nav>

      <footer class="site-footer">
        <PlovdivSkyline class="footer-skyline" />
        <div class="container">
          <div class="footer-top">
            <div class="footer-brand">
              <a class="brand" href={localizePath("/", lang)} data-brand>
                <PlovdivMark />
                <span data-brand-name>{t.site.name}</span>
              </a>
              <p data-footer-blurb>{t.footer.blurb}</p>
              <p class="footer-motto" data-footer-motto>{ailyakMotto}</p>
            </div>
            <div class="footer-col">
              <h2 data-footer-group="explore">{t.footer.explore}</h2>
              <ul>
                {footerHistory.map((item) => (
                  <li><a href={item.href} data-footer-key={item.key}>{item.label}</a></li>
                ))}
              </ul>
            </div>
            <div class="footer-col">
              <h2 data-footer-group="civic">{t.footer.civic}</h2>
              <ul>
                {footerCivic.map((item) => (
                  <li><a href={item.href} data-footer-key={item.key}>{item.label}</a></li>
                ))}
              </ul>
            </div>
            <div class="footer-col">
              <h2 data-footer-group="about">{t.footer.about}</h2>
              <ul>
                {footerAbout.map((item) => (
                  <li><a href={item.href} data-footer-key={item.key}>{item.label}</a></li>
                ))}
              </ul>
            </div>
          </div>
          <div class="footer-bottom">
            <span data-footer-note>{t.footer.note}</span>
            <span class="meta" data-footer-data-note>{t.footer.dataNote}</span>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var header = document.getElementById("site-header");
        var navToggles = document.querySelectorAll("[data-nav-toggle]");
        var themeToggle = document.getElementById("theme-toggle");
        var langMenu = document.getElementById("lang-menu");
        var navMore = document.getElementById("nav-more");

        function setNavOpen(open) {
          if (!header) return;
          header.setAttribute("data-open", open ? "true" : "false");
          navToggles.forEach(function (toggle) {
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
          });
        }

        // Close the language dropdown when clicking outside it.
        if (langMenu) {
          document.addEventListener("click", function (e) {
            if (langMenu.open && !langMenu.contains(e.target)) {
              langMenu.open = false;
            }
            if (navMore && navMore.open && !navMore.contains(e.target)) {
              navMore.open = false;
            }
          });
        }

        if (navToggles.length && header) {
          navToggles.forEach(function (navToggle) {
            navToggle.addEventListener("click", function () {
            var open = header.getAttribute("data-open") === "true";
              setNavOpen(!open);
            });
          });
        }

        document.querySelectorAll("#nav-links a").forEach(function (link) {
          link.addEventListener("click", function () { setNavOpen(false); });
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            if (header && header.getAttribute("data-open") === "true") {
              setNavOpen(false);
            }
            if (langMenu && langMenu.open) langMenu.open = false;
            if (navMore && navMore.open) navMore.open = false;
          }
        });

        if (themeToggle) {
          themeToggle.addEventListener("click", function () {
            var root = document.documentElement;
            var current = root.getAttribute("data-theme");
            var prefersDark =
              window.matchMedia &&
              window.matchMedia("(prefers-color-scheme: dark)").matches;
            var effective = current || (prefersDark ? "dark" : "light");
            var next = effective === "dark" ? "light" : "dark";
            root.setAttribute("data-theme", next);
            try {
              localStorage.setItem("op-theme", next);
            } catch (e) {}
          });
        }

        // Scroll-reveal: gently fade/rise editorial blocks marked [data-reveal]
        // or [data-reveal-stagger] as they enter the viewport. Anything already
        // in view (or when motion is reduced / IO unsupported) shows immediately.
        var revealEls = document.querySelectorAll("[data-reveal], [data-reveal-stagger]");
        if (revealEls.length) {
          var reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduceMotion || !("IntersectionObserver" in window)) {
            revealEls.forEach(function (el) { el.classList.add("is-visible"); });
          } else {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    io.unobserve(entry.target);
                  }
                });
              },
              { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
            );
            var vh = window.innerHeight || document.documentElement.clientHeight;
            revealEls.forEach(function (el) {
              // Already on screen at load → reveal now, no flash.
              if (el.getBoundingClientRect().top < vh * 0.92) {
                el.classList.add("is-visible");
              } else {
                io.observe(el);
              }
            });
          }
        }

        // Edge fades for horizontally-scrollable dense bar charts (e.g. the
        // archive history chart): toggles has-start-fade / has-end-fade on
        // the .chart-card so the CSS overlay only shows on whichever side
        // still has hidden bars, same pattern as the page-subnav tab row.
        document.querySelectorAll(".chart-card").forEach(function (card) {
          var scroller = card.querySelector("[data-dense]");
          if (!scroller) return;
          var updateChartFade = function () {
            var overflows = scroller.scrollWidth > scroller.clientWidth + 1;
            var atStart = scroller.scrollLeft <= 1;
            var atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 1;
            card.classList.toggle("has-start-fade", overflows && !atStart);
            card.classList.toggle("has-end-fade", overflows && !atEnd);
          };
          scroller.addEventListener("scroll", updateChartFade, { passive: true });
          window.addEventListener("resize", updateChartFade);
          updateChartFade();
        });

        // Leaflet ships English-only defaults for its zoom controls. Maps are
        // initialized lazily across several pages, so localize the controls
        // centrally whenever their buttons enter the page rather than letting
        // every map implementation drift from the current locale.
        var mapZoomIn = document.body.getAttribute("data-map-zoom-in") || "Zoom in";
        var mapZoomOut = document.body.getAttribute("data-map-zoom-out") || "Zoom out";
        var localizeMapZoomControl = function (control, label) {
          if (!control) return;
          control.setAttribute("title", label);
          control.setAttribute("aria-label", label);
        };
        var localizeMapZoomControls = function (root) {
          if (!root || root.nodeType !== 1 && root.nodeType !== 9) return;
          if (root.nodeType === 1 && root.matches && root.matches(".leaflet-control-zoom-in")) {
            localizeMapZoomControl(root, mapZoomIn);
          }
          if (root.nodeType === 1 && root.matches && root.matches(".leaflet-control-zoom-out")) {
            localizeMapZoomControl(root, mapZoomOut);
          }
          if (root.querySelectorAll) {
            root.querySelectorAll(".leaflet-control-zoom-in").forEach(function (control) {
              localizeMapZoomControl(control, mapZoomIn);
            });
            root.querySelectorAll(".leaflet-control-zoom-out").forEach(function (control) {
              localizeMapZoomControl(control, mapZoomOut);
            });
          }
        };
        localizeMapZoomControls(document);
        var mapZoomObserver = new MutationObserver(function (records) {
          records.forEach(function (record) {
            record.addedNodes.forEach(function (node) {
              localizeMapZoomControls(node);
            });
          });
        });
        mapZoomObserver.observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    {localeDetect && (
      <>
        <script type="application/json" id="op-chrome-i18n" set:html={chromeI18nJson} />
        <script is:inline>
          (function () {
            // Re-localize the shared header/footer chrome for pages that are a
            // single static file shared by every locale (see the `localeDetect`
            // prop). Detects the locale from the visited URL the same way the
            // page's own content script does, then swaps text + hrefs by the
            // stable data-nav-key/data-menu-key/data-footer-key hooks rendered
            // above. A no-op when the detected locale is already "bg" (the
            // server-rendered default), so this never fights normal pages —
            // those never set `localeDetect` in the first place.
            var codes = ["bg", "en", "de", "fr", "it", "tr", "es", "el", "ja", "tl", "uk", "ru", "pl"];
            var segments = (window.location.pathname || "/").split("/").filter(Boolean);
            var loc = segments.length > 0 && codes.indexOf(segments[0]) > -1 ? segments[0] : "bg";
            if (loc === "bg") return;

            var dataEl = document.getElementById("op-chrome-i18n");
            var all = dataEl ? JSON.parse(dataEl.textContent) : null;
            var c = all ? all[loc] : null;
            if (!c) return;

            var lp = function (base) { return "/" + loc + base; };
            var setText = function (el, value) { if (el) el.textContent = value; };

            document.querySelectorAll("[data-skip-link]").forEach(function (el) { setText(el, c.skip); });
            document.querySelectorAll("[data-brand-name]").forEach(function (el) { setText(el, c.siteName); });
            document.querySelectorAll("[data-brand]").forEach(function (el) {
              el.setAttribute("href", lp("/"));
              if (el.hasAttribute("data-brand-aria")) el.setAttribute("aria-label", c.siteName + " — " + c.homeAria);
            });
            document.querySelectorAll("[data-nav-aria]").forEach(function (el) { el.setAttribute("aria-label", c.homeAria); });
            document.querySelectorAll("[data-nav-groups-aria]").forEach(function (el) { el.setAttribute("aria-label", c.groups.explore); });
            document.querySelectorAll("[data-lang-switch-aria]").forEach(function (el) {
              el.setAttribute("aria-label", loc.toUpperCase() + " · " + c.langSwitchAria);
              el.setAttribute("title", c.langSwitchAria);
            });
            document.querySelectorAll("[data-theme-aria]").forEach(function (el) {
              el.setAttribute("aria-label", c.themeAria);
              el.setAttribute("title", c.themeAria);
            });
            document.querySelectorAll("[data-menu-aria]").forEach(function (el) { el.setAttribute("aria-label", c.menuAria); });
            document.querySelectorAll("[data-flag]").forEach(function (el) { setText(el, loc.toUpperCase()); });
            document.querySelectorAll("[data-lang-option]").forEach(function (el) {
              var isCurrent = el.getAttribute("data-lang-option") === loc;
              if (isCurrent) el.setAttribute("aria-current", "true");
              else el.removeAttribute("aria-current");
            });

            document.querySelectorAll("[data-nav-key]").forEach(function (el) {
              var key = el.getAttribute("data-nav-key");
              if (c.nav[key]) {
                setText(el, c.nav[key]);
                el.setAttribute("href", lp("/" + key));
              }
            });
            document.querySelectorAll("[data-menu-group]").forEach(function (el) {
              var key = el.getAttribute("data-menu-group");
              if (c.groups[key]) setText(el, c.groups[key]);
            });
            document.querySelectorAll("[data-menu-key]").forEach(function (el) {
              var key = el.getAttribute("data-menu-key");
              if (c.nav[key]) {
                setText(el, c.nav[key]);
                el.setAttribute("href", lp("/" + key));
              }
            });
            document.querySelectorAll("[data-footer-group]").forEach(function (el) {
              var key = el.getAttribute("data-footer-group");
              if (c.groups[key]) setText(el, c.groups[key]);
            });
            document.querySelectorAll("[data-footer-key]").forEach(function (el) {
              var key = el.getAttribute("data-footer-key");
              if (c.nav[key]) {
                setText(el, c.nav[key]);
                el.setAttribute("href", lp("/" + key));
              }
            });
            document.querySelectorAll("[data-footer-blurb]").forEach(function (el) { setText(el, c.footer.blurb); });
            document.querySelectorAll("[data-footer-motto]").forEach(function (el) { setText(el, c.footer.motto); });
            document.querySelectorAll("[data-footer-note]").forEach(function (el) { setText(el, c.footer.note); });
            document.querySelectorAll("[data-footer-data-note]").forEach(function (el) { setText(el, c.footer.dataNote); });
          })();
        </script>
      </>
    )}
  </body>
</html>
