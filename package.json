{
  "name": "open-plovdiv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev -- --host 0.0.0.0",
    "build": "npm run data && npm --workspace apps/web run build && node scripts/indexnow/write-key.mjs",
    "start": "NODE_ENV=production npm --workspace apps/web run start",
    "preview": "npm --workspace apps/web run preview",
    "typecheck": "npm --workspace apps/web run typecheck",
    "data": "node scripts/normalize/generate_public_data.mjs",
    "validate:a11y": "node scripts/validate/validate_static_accessibility.mjs",
    "validate:history-api": "node scripts/validate/validate_history_api.mjs",
    "validate:history-surface": "node scripts/validate/validate_history_surface.mjs",
    "validate:seo": "node scripts/validate/validate_seo.mjs",
    "validate:llms": "node scripts/validate/validate_llms.mjs",
    "validate:story-enrichment": "node scripts/validate/validate_story_enrichment_checklist.mjs",
    "validate:lighthouse": "node scripts/validate/validate_lighthouse_mobile.mjs",
    "brand:icons": "node scripts/brand/generate_icons.mjs",
    "audit:media": "node scripts/audit/audit_media_rights.mjs",
    "audit:media:strict": "node scripts/audit/audit_media_rights.mjs --strict",
    "validate": "node scripts/validate/validate_data.mjs",
    "test": "npm run validate && npm run validate:story-enrichment && node --test scripts/indexnow/indexnow.test.mjs && npm --workspace apps/web run test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "lighthouse": "^13.6.0",
    "railway": "^3.16.0"
  }
}
