{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story gallery profile",
  "type": "object",
  "additionalProperties": false,
    "required": [
      "id",
      "sections"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^story-[0-9a-z-]+$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_index",
          "gallery_label_bg",
          "gallery_label_en",
          "gallery"
        ],
        "properties": {
          "section_index": {
            "type": "integer",
            "minimum": 0
          },
          "gallery_label_bg": {
            "type": "string",
            "minLength": 8
          },
          "gallery_label_en": {
            "type": "string",
            "minLength": 8
          },
          "gallery": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "$ref": "#/definitions/galleryItem"
            }
          },
          "gallery_link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "label_bg",
              "label_en"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label_bg": {
                "type": "string",
                "minLength": 8
              },
              "label_en": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption_bg",
        "caption_en",
        "width",
        "height"
      ],
      "oneOf": [
        {
          "required": [
            "media_ref"
          ]
        },
        {
          "required": [
            "media"
          ]
        }
      ],
      "properties": {
        "media_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "place",
                "archive_item",
                "then_now_then",
                "then_now_now"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 3
            },
            "media_index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "page_url",
            "credit",
            "license",
            "license_url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://upload\\.wikimedia\\.org/"
            },
            "page_url": {
              "type": "string",
              "pattern": "^https://commons\\.wikimedia\\.org/wiki/File"
            },
            "credit": {
              "type": "string",
              "minLength": 2
            },
            "license": {
              "type": "string",
              "minLength": 2
            },
            "license_url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "caption_bg": {
          "type": "string",
          "minLength": 10
        },
        "caption_en": {
          "type": "string",
          "minLength": 10
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
